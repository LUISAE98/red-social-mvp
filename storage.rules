rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Cuenta REAL, no un invitado de compra. Firebase Anonymous Auth cumple
    // `request.auth != null`, así que sin esto un invitado podía subir archivos
    // sin límite y usar el proyecto como almacén. Mismo criterio que
    // `notAnonymous()` en firestore.rules.
    function isRealAccount() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    /**
     * ¿Las imágenes de esta comunidad son de acceso restringido?
     *
     * Privada u oculta sí; pública no. Mismo criterio que `isRestrictedGroup` en
     * lib/posts/image-upload.ts al decidir si guardar o no una URL con token.
     *
     * ⚠️ Solo para comunidades. Un post de PERFIL se descarta antes con
     * `isProfileContainer()`: ahí no hay comunidad que consultar.
     */
    /** ¿Quien pide el archivo es quien lo subió? El uid va en la propia ruta. */
    function isOwnUpload(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    /**
     * ¿Este segmento es el contenedor de un post de PERFIL y no una comunidad?
     *
     * El composer del perfil arma la ruta con `profile-{uid}` porque un perfil no
     * tiene id de grupo. Se resuelve mirando la ruta, sin tocar Firestore.
     */
    function isProfileContainer(groupId) {
      return groupId.matches('profile-.*');
    }

    /**
     * ¿Este perfil tiene el contenido restringido?
     *
     * Un perfil restringido solo se lo lee su dueño — mismo criterio que
     * `canReadProfileContent` en firestore.rules, donde no hay excepción ni para
     * seguidores. Las fotos no pueden ser más abiertas que el post que las lleva.
     */
    function isRestrictedProfile(uid) {
      return firestore.exists(/databases/(default)/documents/users/$(uid))
        && firestore.get(/databases/(default)/documents/users/$(uid)).data.get('profileRestricted', false) == true;
    }

    /** ¿El post de este comentario está restringido? Comunidad o perfil. */
    function isRestrictedCommentPost(postId) {
      return !firestore.exists(/databases/(default)/documents/posts/$(postId))
        || (postGroupId(postId) == ''
              ? firestore.get(/databases/(default)/documents/posts/$(postId)).data.get('profileRestricted', false) == true
              : isRestrictedGroup(postGroupId(postId)));
    }

    function isRestrictedGroup(groupId) {
      return firestore.exists(/databases/(default)/documents/groups/$(groupId))
        && firestore.get(/databases/(default)/documents/groups/$(groupId)).data.visibility in ['private', 'hidden'];
    }

    /** Un campo de la solicitud de saludo, o cadena vacía si no existe. */
    function greetingField(requestId, field) {
      return firestore.exists(/databases/(default)/documents/greetingRequests/$(requestId))
        ? firestore.get(/databases/(default)/documents/greetingRequests/$(requestId)).data.get(field, '')
        : '';
    }

    /** La comunidad a la que pertenece un post, o null si es de perfil. */
    function postGroupId(postId) {
      return firestore.exists(/databases/(default)/documents/posts/$(postId))
        ? firestore.get(/databases/(default)/documents/posts/$(postId)).data.get('groupId', '')
        : '';
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    function maxSize(size) {
      return request.resource.size < size;
    }

    // ==============================
    // USERS (avatar / cover) ✅ NEW
    // ==============================
    match /users/{uid}/{folder}/{fileName} {

      // MVP: perfiles publicos pueden cargar imagenes
      allow read: if true;

      // Solo el dueño puede escribir en su carpeta
      allow write: if isRealAccount()
        && request.auth.uid == uid
        && (folder == "avatar" || folder == "cover")
        && isImage()
        && maxSize(5 * 1024 * 1024);
    }

    // ==============================
    // GROUPS (avatar / cover)
    // ==============================
    // Solo el DUEÑO de la comunidad sube su avatar/portada. Antes bastaba con
    // estar logueado: cualquiera podía sobrescribir la imagen de cualquier
    // comunidad (incluidas las ocultas, cuyo groupId aparece en enlaces de
    // invitación). Coincide con Firestore, donde `coverUrl`/`avatarUrl` solo los
    // puede tocar el owner. El doc del grupo ya existe cuando se sube la imagen.
    function isGroupOwner(groupId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/groups/$(groupId))
        && firestore.get(/databases/(default)/documents/groups/$(groupId)).data.ownerId == request.auth.uid;
    }

    match /groups/{groupId}/{folder}/{fileName} {

      // El avatar y la portada de una comunidad RESTRINGIDA no se sirven por el
      // SDK. Estaba en `if true`, así que la identidad visual de una comunidad
      // oculta quedaba accesible a quien tuviera la ruta — no revela su
      // existencia por sí solo, pero contradice la promesa de ocultarla.
      //
      // ⚠️ Esto NO cambia lo que se ve en la app. Estas imágenes se muestran con
      // URL de token, que no evalúa reglas: el descubrimiento y los listados
      // siguen igual. Lo que se cierra es la vía de pedir el archivo por el SDK
      // conociendo la ruta.
      //
      // El creador conserva el acceso porque es quien sube y reemplaza la imagen.
      allow read: if !isRestrictedGroup(groupId) || isGroupOwner(groupId);

      allow write: if isGroupOwner(groupId)
        && (folder == "avatar" || folder == "cover")
        && isImage()
        && maxSize(5 * 1024 * 1024);
    }

    // ==============================
    // POSTS (imagenes)
    //
    // ⚠️ Esto estuvo abierto (`allow read: if true`) por una decisión razonada
    // que resultó estar a medias. El razonamiento era: las imágenes de
    // comunidades restringidas ya no se guardan con URL de descarga, se piden
    // firmadas a `getRestrictedMediaUrls`, y una URL firmada no consulta estas
    // reglas — así que cerrar aquí "no añadiría nada".
    //
    // Lo que se pasó por alto: quien conozca la RUTA puede pedir el archivo por
    // el SDK de Storage sin URL ninguna, y ahí sí mandan estas reglas. Un
    // expulsado que se hubiera guardado las rutas seguía descargándose el
    // contenido de una comunidad privada, y la caducidad de una hora de las URLs
    // firmadas no servía de nada.
    //
    // El coste que se temía tampoco aparece: el contenido PÚBLICO se sirve con
    // URL de token, que no evalúa reglas, así que esta consulta a Firestore solo
    // corre cuando alguien usa el SDK — al subir, o al hurgar.
    // ==============================
    match /posts/{groupId}/{uid}/{folder}/{fileName} {
      // ORDEN IMPORTANTE, y los dos primeros van antes A PROPÓSITO: `||`
      // cortocircuita, así que ninguno de los dos llega a tocar Firestore.
      //
      //   1. `isOwnUpload` — quien subió el archivo lee el suyo. Es lo que hace
      //      `getDownloadURL` justo después de subir, o sea el camino de publicar.
      //   2. Para leer el archivo DE OTRO se mira si el sitio está restringido, y
      //      cuál es "el sitio" depende de la ruta: un post de PERFIL no lleva
      //      comunidad sino el pseudo-contenedor `profile-{uid}`, así que ahí lo
      //      que manda es `profileRestricted` del perfil, no la visibilidad de
      //      ninguna comunidad. Sin colisión posible: los id de comunidad son
      //      alfanuméricos de 20 caracteres y ninguno empieza por `profile-`.
      //      En un contenedor de perfil el segundo segmento ES el dueño del
      //      perfil, así que `uid` sirve para las dos cosas.
      //
      // ⚠️ Si la lectura entre servicios de la cláusula 2 falla, la evaluación
      // ERROR-A y la regla deniega. Eso es correcto —falla cerrado— pero antes se
      // llevaba por delante también el camino de publicar, porque subir termina
      // leyendo el propio archivo. Con `isOwnUpload` delante, publicar ya no
      // depende de que esa consulta funcione.
      allow read: if isOwnUpload(uid)
        || (isProfileContainer(groupId)
              ? !isRestrictedProfile(uid)
              : !isRestrictedGroup(groupId));

      allow write: if isRealAccount()
        && request.auth.uid == uid
        && (folder == "images" || folder == "thumbnails")
        && isImage()
        && maxSize(10 * 1024 * 1024);
    }

    // ==============================
    // COMMENT IMAGES (imagen adjunta a comentarios/respuestas)
    // Path dedicado para poder gobernarlas aparte (moderación/limpieza).
    //
    // Mismo criterio que las imágenes de post, resolviendo la comunidad a través
    // del post al que cuelga el comentario.
    // ==============================
    match /commentImages/{postId}/{uid}/{folder}/{fileName} {
      // Mismo motivo que en las imágenes de post: quien subió lee lo suyo sin
      // pasar por la consulta entre servicios, que es la que rompe el camino de
      // publicar cuando falla. Ver el comentario largo de arriba.
      //
      // ⚠️ El post puede ser de perfil, y entonces `postGroupId` viene vacío. Antes
      // eso acababa consultando `groups/` sin id; ahora se resuelve por el
      // `profileRestricted` del propio post, y un post que ya no existe cuenta
      // como restringido.
      allow read: if isOwnUpload(uid) || !isRestrictedCommentPost(postId);

      allow write: if isRealAccount()
        && request.auth.uid == uid
        && (folder == "images" || folder == "thumbnails")
        && isImage()
        && maxSize(10 * 1024 * 1024);
    }
    // ==============================
    // DM IMAGES (imagen adjunta a un mensaje directo)
    //
    // LECTURA CERRADA A CAL Y CANTO. Nadie lee estos archivos directamente: la
    // única puerta es la Cloud Function `getDirectMessageImageUrls`, que
    // comprueba en Firestore que quien pide es participante del hilo y devuelve
    // una URL FIRMADA que caduca en una hora.
    //
    // Que esté cerrado aquí es lo que hace que esa caducidad signifique algo. Si
    // se dejara leer a los participantes, cualquiera de los dos podría pedir por
    // su cuenta una URL de descarga con token permanente y saltarse el límite —
    // y con él, el efecto de bloquear a alguien o borrar un mensaje.
    //
    // (Estuvo abierto un rato como apaño mientras el proyecto no tenía el
    // permiso de IAM para firmar. Ya lo tiene.)
    // ==============================
    match /dmImages/{conversationId}/{uid}/{folder}/{fileName} {
      allow read: if false;

      allow write: if isRealAccount()
        && request.auth.uid == uid
        && (folder == "images" || folder == "thumbnails")
        && isImage()
        && maxSize(10 * 1024 * 1024);
    }

    // ==============================
    // STORY COVERS (foto portada)
    // ==============================
    // B8-medio. Las portadas eran `allow read: if true` aunque el perfil o la
    // comunidad estuvieran cerrados: exactamente el hueco que ya se cerró para
    // los avatares de comunidad y los medios de publicación. La portada de una
    // historia enseña la cara de quien la publicó.
    //
    // ⚠️ El dueño va DELANTE del `||` a propósito. La lectura entre servicios
    // (`firestore.get` desde storage.rules) ERROR-A si falla, y un error deniega:
    // sin esta primera cláusula, subir la portada dependería de que esa consulta
    // funcione, porque subir termina leyendo el propio archivo.
    match /storyCovers/users/{uid}/{fileName} {
      allow read: if (request.auth != null && request.auth.uid == uid)
        || !isRestrictedProfile(uid);

      allow write: if isRealAccount()
        && request.auth.uid == uid
        && isImage()
        && maxSize(5 * 1024 * 1024);
    }

    match /storyCovers/groups/{groupId}/{fileName} {
      allow read: if isGroupOwner(groupId) || !isRestrictedGroup(groupId);

      allow write: if isGroupOwner(groupId)
        && isImage()
        && maxSize(5 * 1024 * 1024);
    }

    // ==============================
    // LIVE COVERS (portadas de live)
    // ==============================
    match /live-covers/{uid}/{fileName} {
      allow read: if true;
      allow write: if isRealAccount()
        && request.auth.uid == uid
        && isImage()
        && maxSize(10 * 1024 * 1024);
    }

    // ==============================
    // GREETINGS (videos)
    // ==============================
    // ⚠️ Esto era lo más abierto del archivo: CUALQUIERA con sesión —incluido un
    // invitado de compra— podía escribir sobre la solicitud de saludo de otra
    // persona con solo conocer su id, y hasta 60 MB por archivo. Servía para
    // pisar el video que un creador acababa de grabar, o para usar el proyecto
    // como almacén gratuito.
    //
    // Ahora: solo el CREADOR al que le encargaron ese saludo puede subirlo, y
    // solo el creador o quien lo compró pueden leerlo.
    match /greetings/{requestId}/{fileName} {

      allow read: if isRealAccount()
        && (
          greetingField(requestId, 'creatorId') == request.auth.uid
          || greetingField(requestId, 'buyerId') == request.auth.uid
        );

      allow write: if isRealAccount()
        && greetingField(requestId, 'creatorId') == request.auth.uid
        && isVideo()
        && maxSize(60 * 1024 * 1024);
    }

  }
}