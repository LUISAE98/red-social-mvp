rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    function maxSize(size) {
      return request.resource.size < size;
    }

    // ==============================
    // USERS (avatar / cover) ✅ NEW
    // ==============================
    match /users/{uid}/{folder}/{fileName} {

      // MVP: perfiles publicos pueden cargar imagenes
      allow read: if true;

      // Solo el dueño puede escribir en su carpeta
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && (folder == "avatar" || folder == "cover")
        && isImage()
        && maxSize(5 * 1024 * 1024);
    }

    // ==============================
    // GROUPS (avatar / cover)
    // ==============================
    // Solo el DUEÑO de la comunidad sube su avatar/portada. Antes bastaba con
    // estar logueado: cualquiera podía sobrescribir la imagen de cualquier
    // comunidad (incluidas las ocultas, cuyo groupId aparece en enlaces de
    // invitación). Coincide con Firestore, donde `coverUrl`/`avatarUrl` solo los
    // puede tocar el owner. El doc del grupo ya existe cuando se sube la imagen.
    function isGroupOwner(groupId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/groups/$(groupId))
        && firestore.get(/databases/(default)/documents/groups/$(groupId)).data.ownerId == request.auth.uid;
    }

    match /groups/{groupId}/{folder}/{fileName} {

      allow read: if true;

      allow write: if isGroupOwner(groupId)
        && (folder == "avatar" || folder == "cover")
        && isImage()
        && maxSize(5 * 1024 * 1024);
    }

    // ==============================
    // POSTS (imagenes)
    // ==============================
match /posts/{groupId}/{uid}/{folder}/{fileName} {
  allow read: if true;

  allow write: if isSignedIn()
    && request.auth.uid == uid
    && (folder == "images" || folder == "thumbnails")
    && isImage()
    && maxSize(10 * 1024 * 1024);
}

    // ==============================
    // COMMENT IMAGES (imagen adjunta a comentarios/respuestas)
    // Path dedicado para poder gobernarlas aparte (moderación/limpieza).
    // ==============================
    match /commentImages/{postId}/{uid}/{folder}/{fileName} {
      allow read: if true;

      allow write: if isSignedIn()
        && request.auth.uid == uid
        && (folder == "images" || folder == "thumbnails")
        && isImage()
        && maxSize(10 * 1024 * 1024);
    }
    // ==============================
    // STORY COVERS (foto portada)
    // ==============================
    match /storyCovers/users/{uid}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && isImage()
        && maxSize(5 * 1024 * 1024);
    }

    match /storyCovers/groups/{groupId}/{fileName} {
      allow read: if true;
      allow write: if isGroupOwner(groupId)
        && isImage()
        && maxSize(5 * 1024 * 1024);
    }

    // ==============================
    // LIVE COVERS (portadas de live)
    // ==============================
    match /live-covers/{uid}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && isImage()
        && maxSize(10 * 1024 * 1024);
    }

    // ==============================
    // GREETINGS (videos)
    // ==============================
    match /greetings/{requestId}/{fileName} {

      allow read: if isSignedIn();

      allow write: if isSignedIn()
        && isVideo()
        && maxSize(60 * 1024 * 1024);
    }

  }
}