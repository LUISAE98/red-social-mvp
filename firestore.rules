rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Los invitados de compra sin login usan Firebase Anonymous Auth. Son cuentas
    // legítimas para PAGAR, pero no para participar socialmente: sin ellas, el DM
    // tendría spam ilimitado y sin rostro. Defensivo ante tokens sin el claim.
    function notAnonymous() {
      return request.auth != null
        && (
          !("firebase" in request.auth.token)
          || request.auth.token.firebase.get('sign_in_provider', '') != 'anonymous'
        );
    }

    // Moderador de plataforma. Exige el claim Y que la sesión sea de Google.
    //
    // Lo segundo lo comprobaba SOLO el cliente (`usePlatformMod`), así que era
    // una preferencia de interfaz, no una frontera: con el claim puesto, una
    // sesión de contraseña conservaba todos los privilegios ante Firestore.
    // Mismo criterio que el hook, para que cliente y servidor no discrepen.
    function isPlatformMod() {
      return request.auth != null
        && request.auth.token.get('role', '') == 'moderator'
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // ==========================
    // USERS / HANDLES
    // ==========================
    function validHandle(h) {
      return h is string
        && h.size() >= 3
        && h.size() <= 20
        && h.matches('^[a-z0-9_]+$');
    }

    function validSex(s) {
      return s in ["male", "female", "other", "prefer_not_say"];
    }

    // ⚠️ Ya NO es una lista blanca, y por dos razones.
    //
    // 1. Se quedó corta: eran las 15 monedas de los 17 países del lanzamiento, y hoy la
    //    plataforma cobra en 78. Una moneda legítima nueva se rechazaba aquí.
    // 2. Costaba caro: un `in` de 15 elementos, evaluado dos veces por escritura, dentro
    //    de una regla que ya rozaba el tope de 1000 expresiones de Firestore.
    //
    // La moneda de cobro NO se decide aquí de todos modos: la impone el servidor a partir
    // del país fiscal del comprador (`chargeCurrencyForCountry`). Lo que se guarda en el
    // documento es informativo, así que basta con que tenga forma de código ISO 4217.
    function validCurrency(c) {
      return c is string && c.size() == 3;
    }

    function birthTimestamp(b) {
      return timestamp.date(int(b.split('-')[0]), int(b.split('-')[1]), int(b.split('-')[2]));
    }

    // Antes solo se comprobaba el FORMATO: cualquier YYYY-MM-DD pasaba, así que
    // el requisito de 18 años vivía únicamente en la interfaz y se saltaba con
    // una llamada directa al SDK. Ahora la fecha tiene que ser real (timestamp.date
    // revienta con un 2010-13-45, y reventar deniega) y tener 18 años cumplidos.
    // 6574 días = 18 × 365.25; el desfase máximo es de horas y siempre a favor
    // de exigir más edad, nunca menos.
    function validBirthDate(b) {
      return b is string
        && b.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && birthTimestamp(b) > timestamp.date(1900, 1, 1)
        && birthTimestamp(b) < request.time - duration.value(6574, 'd');
    }

    function validNullableString(value) {
      return value == null || value is string;
    }

    function validNonNegativeNumberOrNull(value) {
      return value == null || (value is number && value >= 0);
    }

    function validPositiveNumberOrNull(value) {
      return value == null || (value is number && value > 0);
    }

    function profileGreetingValid(pg) {
      return pg is map
        && ("enabled" in pg) && pg.enabled is bool
        && (!("price" in pg) || validNonNegativeNumberOrNull(pg.price))
        && (!("currency" in pg) || pg.currency == null || validCurrency(pg.currency));
    }

    function profileMonetizationValid(monetization) {
      return monetization == null
        || (
          monetization is map
          && (!("greetingsEnabled" in monetization) || monetization.greetingsEnabled is bool)
          && (!("adviceEnabled" in monetization) || monetization.adviceEnabled is bool)
          && (!("customClassEnabled" in monetization) || monetization.customClassEnabled is bool)
          && (!("digitalMeetGreetEnabled" in monetization) || monetization.digitalMeetGreetEnabled is bool)
          && (!("donationsEnabled" in monetization) || monetization.donationsEnabled is bool)
        );
    }

    function profileServicesValid(profileServices) {
      return profileServices is map
        && (!("offerings" in profileServices) || offeringsValid(profileServices))
        && (!("donation" in profileServices) || donationValid(profileServices))
        && (!("monetization" in profileServices) || profileMonetizationValid(profileServices.monetization));
    }

    // Lista CERRADA de campos del perfil al crearlo. Sin ella, un cliente podía
    // sembrar cualquier campo extra en su propio documento, y ese documento lo
    // leen búsquedas, métricas y funciones que confían en él.
    // Las 23 primeras son las que escribe `profileOnboarding.ts`; el resto son
    // opcionales que esta misma función ya validaba.
    // `users/{uid}` es de LECTURA PÚBLICA (lo exigen perfiles, búsqueda y feeds),
    // y Firestore no sabe ocultar campos sueltos: si el documento se lee, se leen
    // TODOS sus campos. Por eso el correo, la fecha de nacimiento y el sexo ya no
    // viven aquí — se mudaron a `users/{uid}/private/identity`, que solo lee su
    // dueño. Antes cualquiera podía recolectar esos datos de toda la base con una
    // sola consulta.
    function userCreateKeysAllowed(data) {
      return data.keys().hasOnly([
        "uid", "photoURL", "coverUrl", "handle",
        "username", "displayName", "firstName", "lastName",
        "bio", "role", "profileReserved",
        "profileRestricted", "profileCommentsEnabled", "isActive", "createdAt",
        "updatedAt", "search",
        "showPosts", "showCreatedGroups", "followersCount", "profileGreeting",
        "profileServices", "offerings", "donation", "monetization",
        "socialLinks"
      ]);
    }

    // Redes sociales del perfil. Se guarda el USUARIO de cada red, nunca la liga:
    // este documento lo lee cualquiera y lo que se guarde aquí termina en un
    // `href` público, así que dejar escribir la liga completa abriría la puerta a
    // `javascript:`, a redirectores y a suplantaciones. La liga se arma en el
    // cliente desde un catálogo cerrado (`lib/profile/socialNetworks.ts`); aquí
    // solo hay que asegurar que sean esas seis claves y cadenas cortas.
    // El tope de 40 es el mismo `SOCIAL_HANDLE_MAX` del catálogo.
    function socialHandleValid(links, key) {
      return !(key in links)
        || (
          links[key] is string
          && links[key].size() >= 1
          && links[key].size() <= 40
        );
    }

    function profileSocialLinksValid(links) {
      return links is map
        && links.keys().hasOnly([
          "instagram", "tiktok", "youtube", "x", "facebook", "twitch"
        ])
        && socialHandleValid(links, "instagram")
        && socialHandleValid(links, "tiktok")
        && socialHandleValid(links, "youtube")
        && socialHandleValid(links, "x")
        && socialHandleValid(links, "facebook")
        && socialHandleValid(links, "twitch");
    }

    // Ata la identidad al TOKEN, no a lo que diga el cliente. Antes se podía
    // crear el propio perfil con correo y proveedor inventados.
    function userIdentityMatchesToken(data) {
      return data.email == request.auth.token.get('email', '')
        && data.emailLower == data.email.lower()
        && data.authProvider == request.auth.token.firebase.sign_in_provider
        && data.authProvider in ["password", "google.com"]
        && data.provider == (data.authProvider == "google.com" ? "google" : "password");
    }

    // Datos personales del perfil. Se escriben en el MISMO lote que el perfil
    // público, así que el gate de edad y el de identidad viven aquí ahora.
    function validPrivateIdentity(data) {
      return data.keys().hasOnly([
        "email", "emailLower", "birthDate", "sex", "provider", "authProvider",
        "createdAt", "updatedAt"
      ])
        && userIdentityMatchesToken(data)
        && validBirthDate(data.birthDate)
        && validSex(data.sex);
    }

    // Campos operativos: el cliente no elige su rol ni nace desactivado.
    function userOperationalDefaults(data) {
      return data.role == "user"
        && data.isActive == true
        && data.profileReserved == false
        && data.username == data.handle
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.bio is string
        && data.bio.size() <= 500;
    }

    function validUserBase(data) {
      return userCreateKeysAllowed(data)
        && userOperationalDefaults(data)
        && data.uid is string
        && validHandle(data.handle)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 60
        && data.firstName is string
        && data.firstName.size() >= 1
        && data.firstName.size() <= 40
        && data.lastName is string
        && data.lastName.size() >= 1
        && data.lastName.size() <= 40
        // birthDate y sex se validan ahora en `validPrivateIdentity`: ya no
        // viven en el documento público.
        && (data.photoURL == null || data.photoURL is string)
        && (!("coverUrl" in data) || data.coverUrl == null || data.coverUrl is string)
        && (!("socialLinks" in data)
          || data.socialLinks == null
          || profileSocialLinksValid(data.socialLinks))
        && (!("showPosts" in data) || data.showPosts is bool)
        && (!("showCreatedGroups" in data) || data.showCreatedGroups is bool)
        && (!("profileRestricted" in data) || data.profileRestricted is bool)
        && (!("followersCount" in data) || (data.followersCount is int && data.followersCount >= 0))
        && (
          !("profileGreeting" in data)
          || data.profileGreeting == null
          || profileGreetingValid(data.profileGreeting)
        )
        && (
          !("profileServices" in data)
          || data.profileServices == null
          || profileServicesValid(data.profileServices)
        )
        && offeringsValid(data)
        && donationValid(data)
&& (
  !("monetization" in data)
  || data.monetization == null
  || profileMonetizationValid(data.monetization)
)
&& (
  !("search" in data)
  || validUserSearchIndex(data.search)
);
    }
    
    function validUserSearchIndex(search) {
  return search == null
    || (
      search is map
      && (!("nameNormalized" in search) || search.nameNormalized is string)
      && (!("displayNameNormalized" in search) || search.displayNameNormalized is string)
      && (!("firstNameNormalized" in search) || search.firstNameNormalized is string)
      && (!("lastNameNormalized" in search) || search.lastNameNormalized is string)
      && (!("handleNormalized" in search) || search.handleNormalized is string)
      && (!("tokens" in search) || search.tokens is list)
      && (!("prefixes" in search) || search.prefixes is list)
      && (!("isActive" in search) || search.isActive is bool)
      && (!("profileSearchable" in search) || search.profileSearchable is bool)
      // ⚠️ ACEPTA NÚMERO O TIMESTAMP, y no es dejadez.
      //
      // `groupSearchIndex` copia aquí el `updatedAt` del grupo, y ese campo llega unas veces
      // como Timestamp y otras como epoch en milisegundos según qué camino lo escribió.
      // Exigir solo `timestamp` no protegía nada —es metadato, no control de acceso— y en
      // cambio DEJABA EL DOCUMENTO MUERTO: con un número guardado, la regla se evalúa en
      // CADA update (el índice viaja siempre en `request.resource.data`), así que el dueño
      // no podía tocar ni la descripción de su propia comunidad. 4 de 10 estaban así.
      && (
        !("updatedAt" in search)
        || search.updatedAt == null
        || search.updatedAt is timestamp
        || (search.updatedAt is number && search.updatedAt >= 0)
      )
      && (!("version" in search) || search.version == 1)
    );
}

    function userBlockedUser(ownerUid, blockedUid) {
      return exists(/databases/$(database)/documents/users/$(ownerUid)/blockedUsers/$(blockedUid));
    }

    function usersHaveBlockBetween(userA, userB) {
      return userBlockedUser(userA, userB)
        || userBlockedUser(userB, userA);
    }

    function groupMemberBlockDocId(blockerUid, blockedUid) {
      return blockerUid + "_" + blockedUid;
    }

    function groupMemberBlockedUser(groupId, blockerUid, blockedUid) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/memberBlocks/$(groupMemberBlockDocId(blockerUid, blockedUid)));
    }

    function groupMembersHaveBlockBetween(groupId, userA, userB) {
      return groupMemberBlockedUser(groupId, userA, userB)
        || groupMemberBlockedUser(groupId, userB, userA);
    }

    function validGroupMemberBlockDoc(groupId, blockId) {
      return request.resource.data.keys().hasOnly([
        "groupId",
        "blockerId",
        "blockedUserId",
        "createdAt"
      ])
      && request.resource.data.groupId == groupId
      && request.resource.data.blockerId == request.auth.uid
      && request.resource.data.blockedUserId is string
      && request.resource.data.blockedUserId != request.auth.uid
      && blockId == groupMemberBlockDocId(request.auth.uid, request.resource.data.blockedUserId)
      && request.resource.data.createdAt is timestamp;
    }

    function validFollowingDoc(uid, targetUid) {
      return request.resource.data.keys().hasOnly([
        "userId",
        "targetUserId",
        "createdAt"
      ])
      && request.resource.data.userId == uid
      && request.resource.data.targetUserId == targetUid
      // ⚠️ La fecha la pone el SERVIDOR, no el cliente. Antes bastaba con que
      // fuera un timestamp cualquiera, y esa fecha decide quién lleva 24 horas
      // siguiendo a alguien para poder comentar en su perfil
      // (`profileFollowIsOldEnoughForComment`): poniendo una fecha del año
      // pasado, la espera desaparecía.
      && request.resource.data.createdAt == request.time;
    }

    function validFollowerDoc(uid, followerUid) {
      return request.resource.data.keys().hasOnly([
        "userId",
        "followerUserId",
        "createdAt"
      ])
      && request.resource.data.userId == uid
      && request.resource.data.followerUserId == followerUid
      && request.resource.data.createdAt is timestamp;
    }

    function validBlockedUserDoc(uid, blockedUid) {
      return request.resource.data.keys().hasOnly([
        "userId",
        "blockedUserId",
        "createdAt"
      ])
      && request.resource.data.userId == uid
      && request.resource.data.blockedUserId == blockedUid
      && request.resource.data.createdAt is timestamp;
    }

    // ==========================
    // RATE LIMITS (client-side enforcement)
    // ==========================
    match /rateLimits/{docId} {
      // El usuario puede LEER su contador, pero NO escribirlo. Antes podía, y
      // como el documento guarda su propia ventana (`lastAt`, `hourTimestamps`),
      // bastaba con reescribirlo para reiniciar el límite y publicar sin freno.
      // Ahora solo lo escribe el callable `checkRateLimitPost`/`Comment` con el
      // Admin SDK, en transacción.
      allow read: if signedIn()
        && (docId == request.auth.uid + '_post'
            || docId == request.auth.uid + '_comment'
            || docId == request.auth.uid + '_story'
            || docId == request.auth.uid + '_dm');

      // ── B8-H03 ─────────────────────────────────────────────────────────────
      //
      // El contador de COMENTARIOS vuelve a ser escribible por su dueño, pero
      // ahora con la cuenta verificada. Es un cambio deliberado y conviene
      // entender por qué, porque deshace en apariencia el cierre de arriba.
      //
      // El problema que quedaba: el freno se pedía en una llamada APARTE
      // (`checkRateLimitComment`) y el comentario se escribía directo después,
      // así que bastaba con no dar el primer paso. Una regla no puede exigir que
      // ANTES ocurriera otra cosa... pero sí puede exigir que ocurra A LA VEZ.
      //
      // `canCreateComment` pide `getAfter(este documento).lastAt == request.time`,
      // o sea que el comentario y este contador tienen que ir en el MISMO lote
      // atómico. Si el lote no incluye el contador, no hay comentario; y si
      // incluye el contador, tiene que pasar por estas reglas.
      //
      // ⚠️ Lo que hacía peligroso el permiso viejo era que el cliente escribía
      // `lastAt` a mano y podía ponerle una fecha vieja para reiniciarse solo.
      // Aquí `lastAt` tiene que valer EXACTAMENTE `request.time`, la hora del
      // servidor: no hay forma de mentirla. Y para escribir, el `lastAt`
      // ANTERIOR tiene que ser lo bastante viejo. Reiniciarse es imposible.
      //
      // El borrado sigue cerrado: si no, se borraba el documento y a empezar.
      //
      // La alternativa era un callable, y se descartó porque quién puede
      // comentar lo deciden seis funciones encadenadas de este mismo archivo
      // (acceso premium, ticket de directo, bloqueos de comunidad, comentarios
      // habilitados, antigüedad del follow). El servidor habría necesitado su
      // propia copia de las seis, y una copia que se desincroniza del original
      // es exactamente el fallo que esta auditoría lleva ocho bloques
      // encontrando. Aquí la autorización sigue viviendo en UN solo sitio.
      allow create: if signedIn()
        && (docId == request.auth.uid + '_comment'
            || docId == request.auth.uid + '_story'
            || docId == request.auth.uid + '_dm')
        && validRateLimitShape()
        && request.resource.data.windowStart == request.time
        && request.resource.data.count == 1;

      // Comentarios: 3 s entre uno y otro, 60 por hora.
      // Historias:   sin espera entre una y otra, 20 por día (B8-H05).
      //
      // Los dos usan la misma aritmética; solo cambian los tres números. Las
      // historias no llevan espera mínima porque publicar dos seguidas es
      // normal, y quien manda ahí es el tope diario.
      allow update: if signedIn()
        && (
          (docId == request.auth.uid + '_comment' && contadorAvanza(3, 1, 60))
          || (docId == request.auth.uid + '_story' && contadorAvanza(0, 24, 20))
          // Mensajes directos: 1 s entre uno y otro, 300 por hora. B9-alto.
          //
          // Un participante de un hilo activo podía generar mensajes, triggers y
          // avisos sin límite ninguno. El tope es holgado a propósito —una
          // conversación viva de verdad no se acerca— y lo que corta es el chorro
          // automático, no la charla.
          || (docId == request.auth.uid + '_dm' && contadorAvanza(1, 1, 300))
        );

      // ⚠️ Sin esto, borrar el documento reinicia el contador.
      allow delete: if false;
    }

    /**
     * La aritmética del contador, compartida por comentarios e historias.
     *
     * @param esperaSegundos  mínimo entre dos acciones (0 = sin espera)
     * @param ventanaHoras    cuánto dura la ventana antes de reiniciarse
     * @param tope            cuántas acciones caben en una ventana
     */
    function contadorAvanza(esperaSegundos, ventanaHoras, tope) {
      return validRateLimitShape()
        && request.time >= resource.data.lastAt + duration.value(esperaSegundos, 's')
        && (
          // Ventana nueva: la anterior ya cumplió su tiempo, o el documento es
          // de los viejos y no tiene ventana (los escribía el callable retirado,
          // con otro formato: `lastAt` + `hourTimestamps`).
          (
            (
              !("windowStart" in resource.data)
              || request.time >= resource.data.windowStart + duration.value(ventanaHoras, 'h')
            )
            && request.resource.data.windowStart == request.time
            && request.resource.data.count == 1
          )
          ||
          // Misma ventana: uno más, hasta el tope.
          (
            "windowStart" in resource.data
            && request.resource.data.windowStart == resource.data.windowStart
            && request.resource.data.count == resource.data.get('count', 0) + 1
            && request.resource.data.count <= tope
          )
        );
    }

    /**
     * La forma del contador. `lastAt` SIEMPRE es la hora del servidor: es lo que
     * impide falsear la fecha para reiniciarse.
     */
    function validRateLimitShape() {
      return request.resource.data.keys().hasOnly(["lastAt", "windowStart", "count"])
        && request.resource.data.lastAt == request.time
        && request.resource.data.windowStart is timestamp
        && request.resource.data.count is int
        && request.resource.data.count >= 1;
    }

    // Configuración pública de solo lectura (catálogo/tasas de cambio).
    // La escritura queda reservada al backend (Admin SDK).
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ==========================
    // PAGOS (Mercado Pago — modelo agregador)
    // ==========================

    // Intentos de pago (puente compra ↔ orden de MP). El comprador lee el suyo
    // para sondear el estado del cobro; TODO lo escribe el backend (onCall que
    // crea la orden + webhook que confirma el pago). Nunca el cliente.
    match /paymentIntents/{externalReference} {
      allow get: if signedIn()
        && resource.data.buyerId == request.auth.uid;
      allow list, create, update, delete: if false;
    }

    // Perfil fiscal del creador-proveedor (facturación, modelo vendedor directo).
    // Datos fiscales (RFC, régimen, CP) + estado del CSD/organización de Facturapi.
    // El dueño LEE el suyo (para ver su estado de alta); la ESCRITURA es SOLO backend
    // (callable validada `saveCreatorTaxProfile` + subida de CSD). Nunca el cliente.
    // El CSD y archivos sensibles NO viven aquí (viven en Facturapi).
    match /creatorTaxProfiles/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Comprobantes de liquidación del creador (payout statements). Los escribe SOLO el
    // proceso mensual desde el backend; el dueño puede leer los suyos y listarlos, porque
    // la pantalla los enseña como historial. Nadie puede leer los de otro.
    // Comprobante de CADA RETIRO. Lo escribe solo el backend cuando el pago sale; el dueño
    // lee los suyos y los lista, porque la wallet los enseña como historial. Es el único
    // papel que tiene el creador EXTRANJERO de que ese dinero le llegó, así que negarle la
    // lectura lo deja sin nada.
    // Recibo del comprador EXTRANJERO. Lo escribe solo el backend al espejar la compra; el
    // dueño lee los suyos y los lista. Es el ÚNICO papel que tiene: el CFDI es un documento
    // mexicano y a él no le aplica, así que negarle la lectura lo deja sin nada.
    match /users/{uid}/recibos/{purchaseId} {
      allow get, list: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // Los comprobantes MENSUALES del creador: su factura global, el CFDI de comisión que Vibra
    // le emite y su constancia de retenciones. Los escribe solo el backend.
    //
    // 🚨 El dueño se identifica por un CAMPO, no por la ruta, así que la consulta TIENE que
    //    fijar `creatorId` con `==` o Firestore deniega la lectura entera. Es la trampa de
    //    `allow list`: solo ve los campos fijados con igualdad.
    //
    // Sin esto el creador no podía ver ninguno de sus tres CFDI — justo los que su contador le
    // pide.
    match /creatorMonthlyDocs/{docId} {
      allow get, list: if signedIn() && resource.data.creatorId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /users/{uid}/comprobantesRetiro/{withdrawalId} {
      allow get, list: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /users/{uid}/payoutStatements/{periodo} {
      allow get, list: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // Datos fiscales del COMPRADOR (receptor). El comprador NO sube CSD; solo sus
    // datos de receptor para que Vibra timbre su factura de venta. El dueño LEE el
    // suyo; la ESCRITURA es SOLO backend (callable `saveBuyerTaxProfile`).
    match /buyerTaxProfiles/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Suscripción a comunidad (preapproval de Mercado Pago). El suscriptor lee la
    // suya (para mostrar "Suscrito hasta …"); el dueño de la comunidad lee las de
    // su comunidad. La ESCRITURA es SOLO backend: el cliente nunca puede fabricar
    // una suscripción ni activar el earning.
    match /groupSubscriptions/{subId} {
      // `resource == null` → doc inexistente (aún no te suscribes): se permite el get y
      // devuelve vacío, en vez de denegar (referenciar resource.data en un doc que no
      // existe lanzaba "Missing or insufficient permissions" al entrar a la comunidad).
      allow get: if signedIn()
        && (resource == null
          || resource.data.uid == request.auth.uid
          || resource.data.ownerId == request.auth.uid);
      allow list: if signedIn()
        && (request.auth.uid == resource.data.uid || request.auth.uid == resource.data.ownerId);
      allow create, update, delete: if false;
    }

    // Solicitudes de retiro. El creador ve las suyas; el moderador de plataforma
    // ve todas (panel de aprobación con intervención humana). La ESCRITURA es
    // solo backend (onCall que captura banderas + revisión manual + money-out).
    match /withdrawalRequests/{requestId} {
      allow get: if signedIn()
        && (resource.data.creatorId == request.auth.uid || isPlatformMod());
      allow list: if signedIn()
        && (request.auth.uid == resource.data.creatorId || isPlatformMod());
      allow create, update, delete: if false;
    }

    match /users/{uid} {
      allow get, list: if true;

      allow create: if notAnonymous()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && validUserBase(request.resource.data);

      allow update: if notAnonymous()
        && (
          (
            request.auth.uid == uid
            && (
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              "offerings",
              "donation",
              "monetization",
              "showCreatedGroups",
              "profileRestricted",
              "profileCommentsEnabled",
              "messagePolicy",
              "updatedAt"
            ])
            // Quién puede abrirme un DM. Ausente ⇒ "everyone" (lo resuelve la
            // regla de conversations); aquí solo se validan los 3 valores.
            && (!("messagePolicy" in request.resource.data)
              || request.resource.data.messagePolicy in
                   ["everyone", "following", "following_and_followers", "none"])
            && (!("showCreatedGroups" in request.resource.data)
              || request.resource.data.showCreatedGroups is bool)
            && (!("profileRestricted" in request.resource.data)
              || request.resource.data.profileRestricted is bool)
            && (!("profileCommentsEnabled" in request.resource.data)
              || request.resource.data.profileCommentsEnabled is bool)
            && (!("offerings" in request.resource.data)
              || request.resource.data.offerings == null
              || (
                request.resource.data.offerings is list
                && request.resource.data.offerings.size() <= 10
              ))
            && (!("donation" in request.resource.data)
              || request.resource.data.donation == null
              || request.resource.data.donation is map)
            && (!("monetization" in request.resource.data)
              || request.resource.data.monetization == null
              || profileMonetizationValid(request.resource.data.monetization))
          )
          ||
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              "photoURL",
              "coverUrl",
              "updatedAt"
            ])
            && (!("photoURL" in request.resource.data)
              || request.resource.data.photoURL == null
              || request.resource.data.photoURL is string)
            && (!("coverUrl" in request.resource.data)
              || request.resource.data.coverUrl == null
              || request.resource.data.coverUrl is string)
          )
          ||
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              "followersCount",
              "updatedAt"
            ])
            && request.resource.data.followersCount is int
            && request.resource.data.followersCount >= 0
            && (
              (
                request.resource.data.followersCount == (
                  (!("followersCount" in resource.data) || !(resource.data.followersCount is int))
                    ? 1
                    : resource.data.followersCount + 1
                )
                && existsAfter(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid))
                // ⚠️ Y que ANTES no existiera. Sin esto, quien ya te seguía podía
                // reescribir su propio documento de seguidor una y otra vez y
                // sumarte +1 en cada pasada: el contador se inflaba sin límite.
                && !exists(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid))
                && getAfter(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid)).data.userId == uid
                && getAfter(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid)).data.followerUserId == request.auth.uid
              )
              ||
              (
                request.resource.data.followersCount == (
                  (!("followersCount" in resource.data) || !(resource.data.followersCount is int) || resource.data.followersCount <= 0)
                    ? 0
                    : resource.data.followersCount - 1
                )
                && !existsAfter(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid))
                // Y que antes SÍ existiera, para que dejar de seguir no reste dos veces.
                && exists(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid))
              )
            )
          )
          ||
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              "storyCovers",
              "storyCoverPhoto"
            ])
            && (!("storyCovers" in request.resource.data)
              || request.resource.data.storyCovers == null
              || request.resource.data.storyCovers is map)
            && (!("storyCoverPhoto" in request.resource.data)
              || request.resource.data.storyCoverPhoto == null
              || request.resource.data.storyCoverPhoto is map)
          )
          ||
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              "preferredCurrency",
              "updatedAt"
            ])
            && request.resource.data.preferredCurrency is string
            && request.resource.data.preferredCurrency.size() >= 3
            && request.resource.data.preferredCurrency.size() <= 4
          )
          ||
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              "bio",
              "updatedAt"
            ])
            && (!("bio" in request.resource.data)
              || request.resource.data.bio == null
              || (request.resource.data.bio is string
                && request.resource.data.bio.size() <= 300))
          )
          ||
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              "socialLinks",
              "updatedAt"
            ])
            && (!("socialLinks" in request.resource.data)
              || request.resource.data.socialLinks == null
              || profileSocialLinksValid(request.resource.data.socialLinks))
          )
            )
          )
          ||
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              "followersCount",
              "updatedAt"
            ])
            && request.resource.data.followersCount is int
            && request.resource.data.followersCount >= 0
            && (
              (
                request.resource.data.followersCount == (
                  (!("followersCount" in resource.data) || !(resource.data.followersCount is int))
                    ? 1
                    : resource.data.followersCount + 1
                )
                && existsAfter(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid))
                && getAfter(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid)).data.userId == uid
                && getAfter(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid)).data.followerUserId == request.auth.uid
              )
              ||
              (
                request.resource.data.followersCount == (
                  (!("followersCount" in resource.data) || !(resource.data.followersCount is int) || resource.data.followersCount <= 0)
                    ? 0
                    : resource.data.followersCount - 1
                )
                && !existsAfter(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid))
              )
            )
          )
        );

      match /following/{targetUid} {
        allow get, list: if signedIn()
          && request.auth.uid == uid;

        allow create, update: if notAnonymous()
          && request.auth.uid == uid
          && targetUid != uid
          && validFollowingDoc(uid, targetUid)
          && !usersHaveBlockBetween(uid, targetUid)
          && existsAfter(/databases/$(database)/documents/users/$(targetUid)/followers/$(uid))
          && getAfter(/databases/$(database)/documents/users/$(targetUid)/followers/$(uid)).data.userId == targetUid
          && getAfter(/databases/$(database)/documents/users/$(targetUid)/followers/$(uid)).data.followerUserId == uid;

        allow delete: if notAnonymous()
          && (
            request.auth.uid == uid
            || (
              request.auth.uid == targetUid
              && existsAfter(/databases/$(database)/documents/users/$(targetUid)/blockedUsers/$(uid))
            )
          );
      }

      match /followers/{followerUid} {
        allow get: if signedIn()
          && (
            request.auth.uid == uid
            || request.auth.uid == followerUid
          );

        allow list: if signedIn()
          && request.auth.uid == uid;

        allow create, update: if notAnonymous()
          && request.auth.uid == followerUid
          && followerUid != uid
          && validFollowerDoc(uid, followerUid)
          && !usersHaveBlockBetween(uid, followerUid)
          && existsAfter(/databases/$(database)/documents/users/$(followerUid)/following/$(uid))
          && getAfter(/databases/$(database)/documents/users/$(followerUid)/following/$(uid)).data.userId == followerUid
          && getAfter(/databases/$(database)/documents/users/$(followerUid)/following/$(uid)).data.targetUserId == uid;

        allow delete: if notAnonymous()
          && (
            request.auth.uid == uid
            || (
              request.auth.uid == followerUid
              && !existsAfter(/databases/$(database)/documents/users/$(followerUid)/following/$(uid))
            )
          );
      }

      match /blockedUsers/{blockedUid} {
        allow get: if signedIn()
          && (
            request.auth.uid == uid
            || request.auth.uid == blockedUid
          );

        allow list: if signedIn()
          && request.auth.uid == uid;

        allow create, update: if notAnonymous()
          && request.auth.uid == uid
          && blockedUid != uid
          && validBlockedUserDoc(uid, blockedUid);

        allow delete: if notAnonymous()
          && request.auth.uid == uid;
      }

      match /blockedByUsers/{blockerUid} {
        allow get, list: if signedIn()
          && request.auth.uid == uid;

        // Índice inverso del bloqueo (lo escribe el que bloquea en la subcolección
        // del bloqueado). Validar forma y forzar que el doc sea sobre uno mismo,
        // para no sembrar contenido arbitrario en subcolecciones ajenas.
        allow create: if notAnonymous()
          && request.auth.uid == blockerUid
          && request.resource.data.blockedByUserId == blockerUid
          && request.resource.data.keys().hasOnly(["blockedByUserId", "createdAt"]);

        allow update: if false;

        allow delete: if notAnonymous()
          && request.auth.uid == blockerUid;
      }

      match /postFlames/{postId} {
        allow get, list: if signedIn()
          && request.auth.uid == uid;

        allow create, update, delete: if false;
      }

      // Espejo de los me gusta que esta persona dio a historias. Es lo que se
      // lee para pintar el boton, y por eso vive bajo el propio usuario: saberlo
      // no deberia obligar a listar la subcoleccion del contenido.
      //
      // Solo escribe el servidor (`toggleStoryLike`), que es quien mantiene a la
      // vez la marca, este espejo y el contador.
      match /storyLikes/{storyId} {
        allow get, list: if signedIn()
          && request.auth.uid == uid;

        allow create, update, delete: if false;
      }

match /savedPosts/{postId} {
  allow get, list: if signedIn()
    && request.auth.uid == uid;

  allow create, update, delete: if false;
}

match /homeFeed/{postId} {
  allow get, list: if signedIn()
    && request.auth.uid == uid;

  allow create, update, delete: if false;
}

match /profileFeed/{postId} {
  // ⚠️ B8-C02. Esta regla dejaba leer la copia a CUALQUIERA, sin sesión
  // siquiera. Excluía las comunidades OCULTAS, pero no las PRIVADAS: el backend
  // materializa aquí el post entero —texto, medios, metadatos, nombre de la
  // comunidad, autor y datos del live— de cualquier comunidad que no sea oculta.
  // O sea que el contenido de una comunidad privada, y de paso quién publica en
  // ella, se leía desde fuera con solo pedir la colección.
  //
  // Lo que lo hacía invisible: la parrilla del perfil NO lee esta copia. Lee
  // `posts` directamente (`fetchProfileFeedDocs` en
  // `lib/posts/post-service.queries.ts`), y allí sí se exige `isShareable` y se
  // limita lo de comunidades privadas al premium de alcance público. Esta
  // subcolección se quedó como superficie de ataque pura: un camino paralelo,
  // sin ninguno de esos filtros, hacia el mismo contenido.
  //
  // Decisión de producto de Luis (2026-08-16): lo de dentro de una comunidad
  // privada se queda dentro. Y como ningún cliente la lee, cerrarla al dueño
  // —igual que `homeFeed` y `savedPosts`, sus hermanas de al lado— no quita
  // nada de la interfaz.
  allow get, list: if signedIn()
    && request.auth.uid == uid;

  allow create, update, delete: if false;
}

// Libro mayor de wallet: el dueño lee sus entradas; solo el backend escribe.
match /walletLedger/{entryId} {
  allow get, list: if signedIn()
    && request.auth.uid == uid;

  allow create, update, delete: if false;
}

// Resumen agregado del wallet: el dueño lo lee; solo el backend lo mantiene.
match /walletSummary/{docId} {
  allow get, list: if signedIn()
    && request.auth.uid == uid;

  allow create, update, delete: if false;
}

// SALDO A FAVOR del comprador (crédito por devoluciones; gastable en la app, NO
// retirable). El dueño lo lee; solo el backend (Admin SDK) lo emite/gasta. El doc
// resumen es `users/{uid}/buyerCredit/current`; los movimientos van en
// `buyerCreditMovements`. Nunca se escribe desde el cliente.
match /buyerCredit/{docId} {
  allow get, list: if signedIn() && request.auth.uid == uid;
  allow create, update, delete: if false;
}
match /buyerCreditMovements/{movementId} {
  allow get, list: if signedIn() && request.auth.uid == uid;
  allow create, update, delete: if false;
}

// Compras del COMPRADOR (espejo del ledger): el dueño lista/lee las suyas; solo
// el backend (trigger mirrorLedgerToBuyerPurchase) escribe. Ver buyerPurchases.ts.
match /purchases/{purchaseId} {
  allow get, list: if signedIn()
    && request.auth.uid == uid;

  allow create, update, delete: if false;
}

// Perfiles de facturación guardados del comprador (varios, tipo "tarjetas"). El
// dueño los LEE; la ESCRITURA es solo backend (callables saveBuyerBillingProfile
// / deleteBuyerBillingProfile, que validan contra el SAT vía Facturapi).
match /billingProfiles/{profileId} {
  allow get, list: if signedIn()
    && request.auth.uid == uid;

  allow create, update, delete: if false;
}

// CFDIs emitidos al comprador (Vibra → comprador). El dueño los LEE; la emisión y
// escritura es solo backend (callable generateBuyerInvoice, timbra en Facturapi).
match /invoices/{invoiceId} {
  allow get, list: if signedIn()
    && request.auth.uid == uid;

  allow create, update, delete: if false;
}

// Cuenta de retiro del creador (CLABE). Dato financiero sensible: el dueño la
// lee; la ESCRITURA es solo backend (onCall que coteja el titular contra el
// nombre verificado en el alta de Stripe antes de aprobar). Nunca la escribe el cliente.
match /payoutAccounts/{accountId} {
  allow get, list: if signedIn()
    && request.auth.uid == uid;

  allow create, update, delete: if false;
}

// Métodos de pago guardados del comprador. La tarjeta la tokeniza y custodia
// Mercado Pago (Customers & Cards, PCI); aquí solo viven referencias no
// sensibles (últimos 4, marca). El dueño las lee; solo el backend las escribe.
match /paymentMethods/{cardId} {
  allow get, list: if signedIn()
    && request.auth.uid == uid;

  allow create, update, delete: if false;
}

// Geo agregada de compras (mapa): el dueño la lee; solo el servidor la escribe
// (Route Handler con firebase-admin). Nunca desde el cliente.
match /purchaseGeo/{cellId} {
  allow get, list: if signedIn()
    && request.auth.uid == uid;

  allow create, update, delete: if false;
}

// Eventos de suscripción (bajas/churn): el dueño los lee; solo el backend
// (trigger) los escribe. Nunca desde el cliente.
match /subscriptionEvents/{eventId} {
  allow get, list: if signedIn()
    && request.auth.uid == uid;

  allow create, update, delete: if false;
}

match /commentFlames/{flameId} {
  allow get, list: if signedIn()
    && request.auth.uid == uid;

  allow create, update, delete: if false;
}

match /joinRequestsSent/{groupId} {
  allow get, list: if signedIn()
    && request.auth.uid == uid;

  // M01 — claves de `lib/groups/joinRequests.ts`. Es el espejo en el usuario de
  // `groups/{groupId}/joinRequests/{uid}` y lleva los mismos campos.
  allow create, update: if notAnonymous()
    && request.auth.uid == uid
    && request.resource.data.keys().hasOnly([
      "userId", "groupId", "status", "createdAt", "updatedAt"
    ])
    && request.resource.data.userId == uid
    && request.resource.data.groupId == groupId
    && request.resource.data.status == "pending";

  allow delete: if notAnonymous()
    && request.auth.uid == uid;
}
      
match /groupMemberships/{groupId} {
  allow get, list: if signedIn()
    && request.auth.uid == uid;

  // M01 — claves de `buildUserMembershipBaseFields` en `lib/groups/membership.ts`
  // más las de `lib/groups/createGroup.ts`. Este documento duplica los datos de
  // la comunidad con dos nombres (`groupName` y `name`, `groupVisibility` y
  // `visibility`…), así que la lista es larga a propósito: son los dos juegos.
  //
  // ⚠️ Igual que en la membresía, los campos de sanción quedan fuera: en el alta
  // viajan como `deleteField()` y no dejan rastro.
  allow create, update: if notAnonymous()
    && request.auth.uid == uid
    && request.resource.data.keys().hasOnly([
      "groupId", "userId", "roleInGroup", "status",
      "accessType", "requiresSubscription", "subscriptionActive",
      "subscriptionPriceMonthly", "subscriptionCurrency", "subscribedAt",
      "legacyComplimentary", "legacyGrantedAt",
      "transitionPendingAction",
      "groupName", "groupDescription", "groupImageUrl", "groupAvatarUrl",
      "groupCoverUrl", "groupOwnerId", "groupVisibility", "groupDiscoverable",
      "groupIsActive", "groupCategory",
      "name", "description", "imageUrl", "avatarUrl", "coverUrl",
      "ownerId", "visibility", "discoverable", "isActive", "category",
      "createdAt", "joinedAt", "updatedAt"
    ])
    && request.resource.data.userId == uid
    && request.resource.data.groupId == groupId
    && membershipMirrorIsCoherent(groupId, request.resource.data)
    && request.resource.data.status in ["active", "subscribed", "muted"]
    && request.resource.data.roleInGroup in ["member", "mod", "moderator", "owner"]
    && (
      !("accessType" in request.resource.data)
      || validMembershipAccessType(request.resource.data.accessType)
    )
    && (
      !("requiresSubscription" in request.resource.data)
      || request.resource.data.requiresSubscription is bool
    )
    && (
      !("subscriptionActive" in request.resource.data)
      || request.resource.data.subscriptionActive is bool
    )
    && (
      (
        request.resource.data.roleInGroup == "owner"
        && request.resource.data.status == "active"
        && request.resource.data.accessType == "standard"
        && request.resource.data.requiresSubscription == false
        && request.resource.data.subscriptionActive == false
        && groupExistsAfter(groupId)
        && groupDocAfter(groupId).data.ownerId == uid
      )
      ||
      (
        request.resource.data.roleInGroup != "owner"
        && (
          (
            memberExists(groupId, uid)
            && memberDoc(groupId, uid).data.userId == uid
            && memberDoc(groupId, uid).data.roleInGroup == request.resource.data.roleInGroup
            && memberDoc(groupId, uid).data.status == request.resource.data.status
          )
          ||
          (
            memberDocAfter(groupId, uid).data.userId == uid
            && memberDocAfter(groupId, uid).data.roleInGroup == request.resource.data.roleInGroup
            && memberDocAfter(groupId, uid).data.status == request.resource.data.status
          )
        )
      )
    );

  allow delete: if notAnonymous()
    && request.auth.uid == uid;
}

match /hiddenGroupTransitions/{groupId} {
  allow get, list: if signedIn()
    && request.auth.uid == uid;
  allow delete: if notAnonymous()
    && request.auth.uid == uid;
}

      match /preferences/{docId} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow write: if signedIn()
          && request.auth.uid == uid
          && docId == "recommendations"
          && (!("selectedCategories" in request.resource.data) || request.resource.data.selectedCategories is list)
          && (!("joinedCategories" in request.resource.data) || request.resource.data.joinedCategories is list)
          && (!("joinedTags" in request.resource.data) || request.resource.data.joinedTags is list)
          && (!("onboardingCompleted" in request.resource.data) || request.resource.data.onboardingCompleted is bool);
      }

      // Configuración de supercomentarios — solo el propio usuario puede leer/escribir
      //
      // ⚠️ La moneda tiene que ser la de LIQUIDACIÓN. Aquí se exigía "MXN" y se quedó así
      // tras el corte a USD: el panel pasó a guardar "USD" y la regla empezó a rechazar
      // en silencio TODA la configuración de niveles. El creador tocaba sus precios, daba
      // a guardar y no pasaba nada.
      match /settings/{settingId} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow write: if signedIn()
          && request.auth.uid == uid
          && settingId == "superCommentConfig"
          && request.resource.data.enabled is bool
          && request.resource.data.currency == "USD"
          && request.resource.data.tiers is list
          && request.resource.data.tiers.size() >= 1
          && request.resource.data.tiers.size() <= 10;
      }

      // Notificaciones in-app (campanita). Las escribe SOLO el backend (Admin SDK);
      // el dueño puede leerlas y marcar como leída (solo el campo `read`).
      match /notifications/{notifId} {
        allow get, list: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(["read"])
          && request.resource.data.read is bool;
        allow create, delete: if false;
      }

      // Meta del usuario (p. ej. `notifications.seenAt` para el badge de la
      // campanita). El dueño la lee y la escribe.
      match /meta/{docId} {
        allow get, list: if signedIn() && request.auth.uid == uid;
        allow write: if signedIn() && request.auth.uid == uid;
      }

      // Datos personales del perfil: correo, fecha de nacimiento y sexo. Viven
      // fuera del documento público porque `users/{uid}` es legible por
      // cualquiera y Firestore no sabe ocultar campos sueltos.
      //
      // Se crean en el MISMO lote que el perfil, así que el gate de edad y la
      // atadura de identidad al token se comprueban aquí (`validPrivateIdentity`).
      // Inmutables después: cambiar de correo o de fecha de nacimiento no es una
      // edición de perfil, y si algún día hace falta, va por callable.
      match /private/{docId} {
        allow get, list: if notAnonymous() && request.auth.uid == uid;
        allow create: if notAnonymous()
          && request.auth.uid == uid
          && docId == "identity"
          && validPrivateIdentity(request.resource.data);
        allow update, delete: if false;
      }

      // Sesiones activas (dispositivos con la sesión abierta). El dispositivo
      // registra y refresca SU documento, pero `revoked` es territorio del
      // servidor: antes el cliente podía reescribirlo, así que quien tuviera la
      // sesión robada podía des-revocarse solo, y `delete` abierto permitía
      // borrar la evidencia. La revocación real la hace el callable
      // `revokeAllSessions` (Admin SDK + revokeRefreshTokens); la Cloud Function
      // de geo-IP también usa Admin SDK y no pasa por estas reglas.
      match /sessions/{sessionId} {
        allow get, list: if notAnonymous() && request.auth.uid == uid;

        // M01 — claves de `registerSession` en `lib/sessions/sessions-service.ts`.
        // Solo el alta se acota: el `update` de abajo lo hace el heartbeat con
        // `updateDoc`, que manda campos sueltos, y la geolocalización la escribe
        // una Cloud Function con Admin SDK, que no pasa por estas reglas.
        allow create: if notAnonymous()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly([
            "userAgent", "deviceLabel", "timezone", "locationLabel",
            "createdAt", "lastSeenAt", "revoked", "revokedAt"
          ])
          && request.resource.data.get('revoked', false) == false;

        allow update: if notAnonymous()
          && request.auth.uid == uid
          && request.resource.data.get('revoked', false) == resource.data.get('revoked', false)
          && request.resource.data.get('revokedAt', null) == resource.data.get('revokedAt', null);

        allow delete: if false;
      }

      // Tokens FCM de push por dispositivo. El dueño registra/borra los suyos
      // (activar/desactivar notificaciones, limpiar dispositivos). El envío de
      // push usa Admin SDK (Cloud Function) y no pasa por estas reglas.
      match /fcmTokens/{token} {
        allow get, list: if signedIn() && request.auth.uid == uid;
        // M01 — claves de `lib/push/fcm.ts`.
        allow create, update: if notAnonymous()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly([
            "token", "platform", "userAgent", "createdAt", "updatedAt"
          ]);
        allow delete: if notAnonymous() && request.auth.uid == uid;
      }

      allow delete: if false;
    }

    match /handles/{handle} {
      allow get, list: if true;

      // El handle solo se puede reservar si en la MISMA transacción queda un
      // perfil `users/{uid}` que lo declara suyo. Antes bastaba con estar
      // autenticado (incluso de forma anónima) y no había tope: un solo uid
      // podía reservar miles de nombres —marcas, creadores— y dejarlos
      // bloqueados para siempre, porque `update, delete` son `false`.
      //
      // Como el perfil tiene UN campo `handle` y ese campo no está en la lista
      // de claves editables de `users`, cada uid queda con un handle y solo uno.
      allow create: if notAnonymous()
        && validHandle(handle)
        // M01 — claves de `profileOnboarding.ts`. La reserva de nombre es un
        // documento de tres campos; cualquier otra cosa sobra.
        && request.resource.data.keys().hasOnly(["uid", "handle", "createdAt"])
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/handles/$(handle))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.handle == handle;

      allow update, delete: if false;
    }

    // ==========================
    // HELPERS GROUPS
    // ==========================
    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId));
    }

    function groupDocAfter(groupId) {
      return getAfter(/databases/$(database)/documents/groups/$(groupId));
    }

    function groupExists(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId));
    }

    function groupExistsAfter(groupId) {
      return existsAfter(/databases/$(database)/documents/groups/$(groupId));
    }

    function groupIsActive(groupId) {
      return groupExists(groupId)
        && (
          !("isActive" in groupDoc(groupId).data)
          || groupDoc(groupId).data.isActive == true
        );
    }

    function memberDoc(groupId, uid) {
      return get(/databases/$(database)/documents/groups/$(groupId)/members/$(uid));
    }

    function memberDocAfter(groupId, uid) {
      return getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(uid));
    }

    function memberExists(groupId, uid) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/members/$(uid));
    }

    function isGroupPublic(groupId) {
      return groupExists(groupId)
        && groupDoc(groupId).data.visibility == "public";
    }

    function groupVisibility(groupId) {
      return !groupExists(groupId)
        ? null
        : groupDoc(groupId).data.visibility;
    }

    // ¿La suscripción de esta persona a esta comunidad sigue vigente?
    //
    // No basta con que el documento exista: al terminar una suscripción NO se
    // borra, se marca (`ended`, `cancelled`, `past_due`) y se queda de historial.
    // Se comprueba que esté activa, que no haya vencido y que el documento hable
    // de esta persona y de esta comunidad, no de otras.
    function subscriptionDoc(groupId, userId) {
      return get(/databases/$(database)/documents/groupSubscriptions/$(groupId + "_" + userId)).data;
    }

    function subscriptionIsCurrent(groupId, userId) {
      return subscriptionDoc(groupId, userId).get('active', false) == true
        && subscriptionDoc(groupId, userId).get('uid', '') == userId
        && subscriptionDoc(groupId, userId).get('groupId', '') == groupId
        && subscriptionDoc(groupId, userId).get('accessUntil', null) != null
        && subscriptionDoc(groupId, userId).accessUntil > request.time;
    }

    function groupSubscriptionsEnabled(groupId) {
      return groupExists(groupId)
        && ("monetization" in groupDoc(groupId).data)
        && groupDoc(groupId).data.monetization is map
        && (
          (
            "subscriptionsEnabled" in groupDoc(groupId).data.monetization
            && groupDoc(groupId).data.monetization.subscriptionsEnabled == true
          )
          || (
            "isPaid" in groupDoc(groupId).data.monetization
            && groupDoc(groupId).data.monetization.isPaid == true
          )
        );
    }

    function groupRequiresJoinRequest(groupId) {
      return groupExists(groupId)
        && groupVisibility(groupId) == "private"
        && !groupSubscriptionsEnabled(groupId);
    }

    function isOwner(groupId) {
      return signedIn()
        && groupExists(groupId)
        && groupDoc(groupId).data.ownerId == request.auth.uid;
    }

    function memberRole(groupId, uid) {
      return !signedIn() || !memberExists(groupId, uid)
        ? null
        : (
          "roleInGroup" in memberDoc(groupId, uid).data
            ? memberDoc(groupId, uid).data.roleInGroup
            : (
              "role" in memberDoc(groupId, uid).data
                ? memberDoc(groupId, uid).data.role
                : "member"
            )
        );
    }

    function rawMemberStatus(groupId, uid) {
      return !signedIn() || !memberExists(groupId, uid)
        ? null
        : (
          memberDoc(groupId, uid).data.status is string
            ? memberDoc(groupId, uid).data.status
            : "active"
        );
    }

    // Normaliza el status a partir del doc de miembro ya leído. Recibe el `.data`
    // del member doc para NO releerlo por cada rama (antes esta lógica llamaba
    // `rawMemberStatus`/`memberDoc` ~6 veces, y al evaluarse en varias reglas a la
    // vez excedía el límite de accesos de Firestore Rules, denegando a suscritos).
    function normalizeMemberStatus(m) {
      let raw = ("status" in m) && (m.status is string) ? m.status : "active";
      return raw == "banned"
        ? "banned"
        : (raw == "removed" || raw == "kicked" || raw == "expelled")
        ? "removed"
        : (
            raw == "muted"
            && (
              !("mutedUntil" in m)
              || m.mutedUntil == null
              || m.mutedUntil > request.time
            )
          )
        ? "muted"
        : raw == "subscribed"
        ? "subscribed"
        : "active";
    }

    function effectiveMemberStatus(groupId, uid) {
      return !signedIn() || !memberExists(groupId, uid)
        ? null
        : normalizeMemberStatus(memberDoc(groupId, uid).data);
    }

    function isReadableMemberStatus(status) {
      return status == "active"
        || status == "subscribed"
        || status == "muted";
    }

    function isMember(groupId) {
      return signedIn()
        && isReadableMemberStatus(effectiveMemberStatus(groupId, request.auth.uid));
    }

    function isActiveMember(groupId) {
      return signedIn()
        && effectiveMemberStatus(groupId, request.auth.uid) == "active";
    }

    function isSubscribedMember(groupId) {
      return signedIn()
        && effectiveMemberStatus(groupId, request.auth.uid) == "subscribed";
    }

    // Miembro que puede comentar (activo o suscrito), resolviendo el status UNA
    // sola vez. `isActiveMember(...) || isSubscribedMember(...)` evaluaba
    // `effectiveMemberStatus` dos veces para suscritos (isActiveMember falla y
    // fuerza isSubscribedMember), y esa función es tan cara (relee el member doc
    // muchas veces) que la doble evaluación excedía el límite de accesos de las
    // reglas y denegaba a los suscritos. Con un solo `let` se evita.
    function isActiveOrSubscribedMember(groupId) {
      let st = effectiveMemberStatus(groupId, request.auth.uid);
      return signedIn() && (st == "active" || st == "subscribed");
    }

    function isMutedMember(groupId) {
      return signedIn()
        && effectiveMemberStatus(groupId, request.auth.uid) == "muted";
    }

    function isBannedMember(groupId) {
      return signedIn()
        && effectiveMemberStatus(groupId, request.auth.uid) == "banned";
    }

    function isRemovedMember(groupId) {
      return signedIn()
        && effectiveMemberStatus(groupId, request.auth.uid) == "removed";
    }

    function isModerator(groupId) {
      return signedIn()
        && memberExists(groupId, request.auth.uid)
        && memberRole(groupId, request.auth.uid) in ["mod", "moderator"]
        // Un mod muteado NO modera/escribe (mutear ya degrada el rol; esto cubre
        // datos legados donde coexistieran rol mod y status muted).
        && effectiveMemberStatus(groupId, request.auth.uid) in ["active", "subscribed"];
    }

    function canModerateGroup(groupId) {
      return isOwner(groupId) || isModerator(groupId);
    }
        function membersListVisibility(groupId) {
      return !groupExists(groupId)
        ? "owner_only"
        : (
          !("settings" in groupDoc(groupId).data)
          || groupDoc(groupId).data.settings == null
          || !("membersListVisibility" in groupDoc(groupId).data.settings)
        )
          ? "owner_only"
          : groupDoc(groupId).data.settings.membersListVisibility;
    }

    function canMemberListBeSeen(groupId) {
      return signedIn()
        && isMember(groupId)
        && membersListVisibility(groupId) == "members";
    }

    function commentsEnabled(groupId) {
      return !groupExists(groupId)
        ? true
        : (
          !("permissions" in groupDoc(groupId).data)
          || groupDoc(groupId).data.permissions == null
          || !("commentsEnabled" in groupDoc(groupId).data.permissions)
        )
          ? true
          : groupDoc(groupId).data.permissions.commentsEnabled == true;
    }
    
function postingMode(groupId) {
  return !groupExists(groupId)
    ? "members"
    : (
      !("permissions" in groupDoc(groupId).data)
      || groupDoc(groupId).data.permissions == null
      || !("postingMode" in groupDoc(groupId).data.permissions)
      || groupDoc(groupId).data.permissions.postingMode != "owner_only"
    )
      ? "members"
      : "owner_only";
}

function canReadGroupContent(groupId) {
  return (
    isGroupPublic(groupId)
    || isMember(groupId)
    || isOwner(groupId)
    || isModerator(groupId)
    || isPlatformMod()
  );
}

    function canPostInGroup(groupId) {
      let mode = postingMode(groupId);

      return groupIsActive(groupId)
        && (
          isOwner(groupId)
          || (
            (isActiveMember(groupId) || isSubscribedMember(groupId))
            && mode == "members"
          )
        );
    }

    function canCommentInGroup(groupId) {
      return groupIsActive(groupId)
        && (
          isOwner(groupId)
          || (
            (isActiveMember(groupId) || isSubscribedMember(groupId))
            && commentsEnabled(groupId)
          )
        );
    }
    
function canWriteGroupComment(groupId) {
  return signedIn()
    && groupIsActive(groupId)
    && (
      isOwner(groupId)
      || isModerator(groupId)
      || (
        commentsEnabled(groupId)
        && isActiveOrSubscribedMember(groupId)
      )
    );
}
    // ==========================
    // OFFERINGS VALIDATION
    // ==========================
    function validOfferingType(type) {
      return type in [
        "suscripcion",
        "saludo",
        "consejo",
        "clase_personalizada",
        "meet_greet_digital",
        "donacion",
        "mensaje"
      ];
    }

    function validOfferingVisibility(value) {
      return value in ["hidden", "members", "public"];
    }

    function validOfferingSourceScope(value) {
      return value in ["group", "profile", "both"];
    }

    function validSubscriptionMeta(meta) {
      return meta == null
        || (
          meta is map
          && (
            !("billingPeriod" in meta)
            || meta.billingPeriod == null
            || meta.billingPeriod in ["monthly"]
          )
        );
    }

    function validMeetGreetMeta(meta) {
      return meta == null
        || (
          meta is map
          && (
            !("durationMinutes" in meta)
            || meta.durationMinutes == null
            || (
              meta.durationMinutes is number
              && meta.durationMinutes > 0
            )
          )
        );
    }

    function validCustomClassMeta(meta) {
      return meta == null
        || (
          meta is map
          && (
            !("durationMinutes" in meta)
            || meta.durationMinutes == null
            || (meta.durationMinutes is number && meta.durationMinutes > 0)
          )
          && (
            !("availability" in meta)
            || meta.availability == null
            || meta.availability is map
          )
          && (
            !("vacations" in meta)
            || meta.vacations == null
            || meta.vacations is list
          )
        );
    }

    function validOfferingMeta(o) {
      return !("meta" in o)
        || o.meta == null
        || o.meta is map;
    }

    // ⚠️ ADELGAZADA A PROPÓSITO (2026-08-20), por el tope de 1000 expresiones.
    //
    // Esta función se despliega DIEZ VECES (una por servicio posible) dentro de la misma
    // evaluación. Cada comprobación de más se multiplica por diez, y con la comunidad
    // llena —4 servicios con precio, donación activa y monetización cambiando— pasaba el
    // tope: el motor abortaba y Firestore lo traducía a «Missing or insufficient
    // permissions». El dueño no podía activar la suscripción de su propia comunidad.
    //
    // Se conserva el TIPO de servicio, que es lo que decide qué se cobra y por qué vía.
    // Las banderas y los enum de visibilidad se sueltan: son presentación, y el precio
    // real no se lee nunca de aquí — el cobro lo recompone el servidor.
    function offeringItemValid(o) {
      return o is map
        && ("type" in o)
        && validOfferingType(o.type);
    }

    function offeringsValid(data) {
      return !("offerings" in data)
        || data.offerings == null
        || (
          data.offerings is list
          && data.offerings.size() <= 10
        );
    }

    // ⚠️ SOLO FORMA Y TAMAÑO, a propósito (2026-08-20).
    //
    // Antes desplegaba `offeringItemValid` diez veces, una por servicio posible. Con la
    // comunidad llena eso pasaba el tope de 1000 expresiones de Firestore y la escritura
    // se denegaba ENTERA: el dueño no podía activar la suscripción, ni guardar nada.
    //
    // Qué se pierde: que el `type` de cada servicio esté en la lista conocida. Qué NO se
    // pierde: nada del dinero. El precio de un cobro no se lee de aquí — lo recompone el
    // servidor en `composeCharge` a partir del documento del pago, y el tipo de servicio
    // lo valida cada callable por su cuenta. Un `type` inventado ensucia la interfaz de
    // quien lo escribió; no cobra de más ni abre nada.
    //
    // El tope de 10 sí se conserva: es lo que impide engordar el documento sin límite.
    function offeringsValidForUpdate(data) {
      return !("offerings" in data)
        || data.offerings == null
        || (data.offerings is list && data.offerings.size() <= 10);
    }

    // ==========================
    // DONATION VALIDATION
    // ==========================
    function validDonationMode(mode) {
      return mode in ["none", "general", "wedding"];
    }

    function validDonationSourceScope(scope) {
      return scope in ["group", "profile"];
    }

    function validDonationSuggestedAmounts(listValue) {
      return listValue == null
        || (
          listValue is list
          && listValue.size() <= 12
          && (listValue.size() < 1 || validPositiveNumberOrNull(listValue[0]))
          && (listValue.size() < 2 || validPositiveNumberOrNull(listValue[1]))
          && (listValue.size() < 3 || validPositiveNumberOrNull(listValue[2]))
          && (listValue.size() < 4 || validPositiveNumberOrNull(listValue[3]))
          && (listValue.size() < 5 || validPositiveNumberOrNull(listValue[4]))
          && (listValue.size() < 6 || validPositiveNumberOrNull(listValue[5]))
          && (listValue.size() < 7 || validPositiveNumberOrNull(listValue[6]))
          && (listValue.size() < 8 || validPositiveNumberOrNull(listValue[7]))
          && (listValue.size() < 9 || validPositiveNumberOrNull(listValue[8]))
          && (listValue.size() < 10 || validPositiveNumberOrNull(listValue[9]))
          && (listValue.size() < 11 || validPositiveNumberOrNull(listValue[10]))
          && (listValue.size() < 12 || validPositiveNumberOrNull(listValue[11]))
        );
    }

    function donationValid(data) {
      return !("donation" in data)
        || data.donation == null
        || (
          data.donation is map
          && (!("mode" in data.donation) || validDonationMode(data.donation.mode))
          && (!("enabled" in data.donation) || data.donation.enabled is bool)
          && (!("visible" in data.donation) || data.donation.visible is bool)
          && (!("currency" in data.donation) || data.donation.currency == null || validCurrency(data.donation.currency))
          && (!("sourceScope" in data.donation) || validDonationSourceScope(data.donation.sourceScope))
          && (!("title" in data.donation) || validNullableString(data.donation.title))
          && (!("description" in data.donation) || validNullableString(data.donation.description))
          && (!("goalLabel" in data.donation) || validNullableString(data.donation.goalLabel))
          && (!("suggestedAmounts" in data.donation) || validDonationSuggestedAmounts(data.donation.suggestedAmounts))
        );
    }

    // ⚠️ ADELGAZADA A PROPÓSITO (2026-08-20), por el tope de 1000 expresiones.
    //
    // Se conserva el MODO —decide si la donación es general o de boda, y con eso qué
    // pantalla se pinta— y el tope de montos sugeridos, que es lo que impide engordar el
    // documento. Se sueltan los tipos de los textos, la moneda y el valor de cada monto:
    // el importe de una donación NO se lee de aquí. Lo teclea el comprador y lo valida el
    // servidor contra su propio mínimo antes de cobrar (`DONATION_MIN_AMOUNT_USD`).
    function donationValidForUpdate(data) {
      return !("donation" in data)
        || data.donation == null
        || (
          data.donation is map
          && (!("mode" in data.donation) || validDonationMode(data.donation.mode))
          && (
            !("suggestedAmounts" in data.donation)
            || data.donation.suggestedAmounts == null
            || (data.donation.suggestedAmounts is list && data.donation.suggestedAmounts.size() <= 12)
          )
        );
    }

    // ==========================
    // MONETIZATION TRANSITIONS
    // ==========================
    function validFreeToSubscriptionPolicy(value) {
      return value in ["legacy_free", "require_subscription"];
    }

    function validSubscriptionToFreePolicy(value) {
      return value in ["keep_members_free", "remove_all_members"];
    }

// ⚠️ ADELGAZADA A PROPÓSITO (2026-08-20). Ver el comentario de coste en `isValidGroupUpdate`.
//
// Antes comprobaba el tipo de LOS DIEZ campos del mapa, uno por uno. Eso son ~30
// expresiones que, sumadas al resto de la regla, pasaban el tope de 1000 de Firestore:
// cualquier cambio en `monetization` se denegaba por COSTE, no por contenido. El síntoma
// era «Missing or insufficient permissions» al activar la suscripción de una comunidad.
//
// Lo que se conserva es lo que DECIDE COMPORTAMIENTO: las tres políticas de transición,
// que el backend lee para saber qué hacer con los miembros existentes. El resto
// —marcas de tiempo, quién lo cambió, precios previos— es EVIDENCIA: la escribe el
// servidor, nadie la lee para autorizar nada, y comprobar su tipo aquí costaba el
// documento entero.
function validMonetizationTransitions(transitions) {
  return transitions == null
    || (
      transitions is map
      && (
        !("freeToSubscriptionPolicy" in transitions)
        || transitions.freeToSubscriptionPolicy == null
        || validFreeToSubscriptionPolicy(transitions.freeToSubscriptionPolicy)
      )
      && (
        !("subscriptionToFreePolicy" in transitions)
        || transitions.subscriptionToFreePolicy == null
        || validSubscriptionToFreePolicy(transitions.subscriptionToFreePolicy)
      )
      && (
        !("subscriptionPriceIncreasePolicy" in transitions)
        || transitions.subscriptionPriceIncreasePolicy == null
        || transitions.subscriptionPriceIncreasePolicy in [
          "keep_legacy_price",
          "require_resubscribe_new_price"
        ]
      )
    );
}

    function validSubscriptionVisibilityPolicy(data) {
      return !("monetization" in data)
        || data.monetization == null
        || (
          !(("subscriptionsEnabled" in data.monetization) && data.monetization.subscriptionsEnabled == true)
          && !(("isPaid" in data.monetization) && data.monetization.isPaid == true)
        )
        || data.visibility in ["private", "hidden"];
    }

    // ==========================
    // GROUP SHAPE HELPERS
    // ==========================
    function validPermissionsForCreate(data) {
      return !("permissions" in data)
        || data.permissions == null
        || (
          data.permissions is map
          && (!("commentsEnabled" in data.permissions) || data.permissions.commentsEnabled is bool)
          && (!("postingMode" in data.permissions) || data.permissions.postingMode in ["members", "owner_only"])
        );
    }

    function validMonetizationForCreate(data) {
      return !("monetization" in data)
        || data.monetization == null
        || (
          data.monetization is map
          // legacy
          && (!("isPaid" in data.monetization) || data.monetization.isPaid is bool)
          && (!("priceMonthly" in data.monetization) || validNonNegativeNumberOrNull(data.monetization.priceMonthly))
          && (!("currency" in data.monetization) || data.monetization.currency == null || validCurrency(data.monetization.currency))
          // new structural flags
          && (!("subscriptionsEnabled" in data.monetization) || data.monetization.subscriptionsEnabled is bool)
          && (!("subscriptionPriceMonthly" in data.monetization) || validNonNegativeNumberOrNull(data.monetization.subscriptionPriceMonthly))
          && (!("subscriptionCurrency" in data.monetization) || data.monetization.subscriptionCurrency == null || validCurrency(data.monetization.subscriptionCurrency))
          && (!("paidPostsEnabled" in data.monetization) || data.monetization.paidPostsEnabled is bool)
          && (!("paidLivesEnabled" in data.monetization) || data.monetization.paidLivesEnabled is bool)
          && (!("paidVodEnabled" in data.monetization) || data.monetization.paidVodEnabled is bool)
          && (!("paidLiveCommentsEnabled" in data.monetization) || data.monetization.paidLiveCommentsEnabled is bool)
          && (!("greetingsEnabled" in data.monetization) || data.monetization.greetingsEnabled is bool)
          && (!("adviceEnabled" in data.monetization) || data.monetization.adviceEnabled is bool)
          && (!("customClassEnabled" in data.monetization) || data.monetization.customClassEnabled is bool)
          && (!("digitalMeetGreetEnabled" in data.monetization) || data.monetization.digitalMeetGreetEnabled is bool)
          && (!("transitions" in data.monetization) || validMonetizationTransitions(data.monetization.transitions))
        )
        && validSubscriptionVisibilityPolicy(data);
    }

    // ⚠️ ADELGAZADA A PROPÓSITO (2026-08-20), por el tope de 1000 expresiones.
    //
    // Se conserva el tipo de lo que OTRAS REGLAS leen para autorizar —`subscriptionsEnabled`
    // e `isPaid` gobiernan el acceso a la comunidad, y los precios y monedas viajan al
    // cobro—. Se sueltan las ocho banderas de funcionalidad (`paidPostsEnabled`,
    // `adviceEnabled`, …): son interruptores de interfaz que nadie consulta para dar
    // permiso, y comprobar su tipo aquí costaba que no se pudiera guardar NADA.
    //
    // ⚠️ `validSubscriptionVisibilityPolicy` ya NO se llama aquí: `isValidGroupUpdate` la
    // llama al final para todas las actualizaciones. Estaba evaluándose dos veces.
    function validMonetizationForUpdate(data) {
      return !("monetization" in data)
        || data.monetization == null
        || (
          data.monetization is map
          && (!("isPaid" in data.monetization) || data.monetization.isPaid is bool)
          && (!("subscriptionsEnabled" in data.monetization) || data.monetization.subscriptionsEnabled is bool)
          && (!("priceMonthly" in data.monetization) || validNonNegativeNumberOrNull(data.monetization.priceMonthly))
          && (!("subscriptionPriceMonthly" in data.monetization) || validNonNegativeNumberOrNull(data.monetization.subscriptionPriceMonthly))
          && (!("currency" in data.monetization) || data.monetization.currency == null || validCurrency(data.monetization.currency))
          && (!("subscriptionCurrency" in data.monetization) || data.monetization.subscriptionCurrency == null || validCurrency(data.monetization.subscriptionCurrency))
          && (!("transitions" in data.monetization) || validMonetizationTransitions(data.monetization.transitions))
        );
    }

    function validSettingsForCreate(data) {
      return !("settings" in data)
        || data.settings == null
        || (
          data.settings is map
          && (!("membersListVisibility" in data.settings) || data.settings.membersListVisibility in ["owner_only", "members"])
        );
    }
    
    /**
     * El índice de búsqueda tiene que DECIR LO MISMO que la comunidad.
     *
     * ⚠️ `validGroupSearchIndex` comprueba los TIPOS de cada campo, pero no que
     * concuerden con el documento. Era válido guardar la comunidad como `hidden`
     * y a la vez declarar `search.visibility: "public"` y
     * `search.discoverable: true` — y el descubrimiento decide con el índice
     * (`allow list` filtra por `search.visibility` y `search.discoverable`), así
     * que una comunidad oculta podía salir en resultados de búsqueda.
     *
     * Es el mismo fallo de fondo que la deriva de `groupVisibility` en los posts:
     * dos copias del mismo dato y nada que obligue a que coincidan.
     *
     * Los valores por defecto replican los de `buildGroupSearchIndex`
     * (`lib/groups/groupSearchIndex.ts`): un campo ausente en la comunidad
     * significa `true`, así que el índice debe reflejar eso mismo.
     */
    function searchIndexMatchesGroup(data) {
      return !("search" in data)
        || data.search == null
        || !(data.search is map)
        || (
          (
            !("visibility" in data.search)
            || data.search.visibility == null
            || data.search.visibility == data.visibility
          )
          && (
            !("discoverable" in data.search)
            || data.search.discoverable == (data.get('discoverable', true) != false)
          )
          && (
            !("isActive" in data.search)
            || data.search.isActive == (data.get('isActive', true) != false)
          )
        );
    }

// ⚠️ ADELGAZADA A PROPÓSITO (2026-08-20). Era la función MÁS CARA de la regla de grupos:
// con ella entera, guardar la configuración de una comunidad llena pasaba el tope de 1000
// expresiones de Firestore y la escritura se denegaba entera. Medido por eliminación.
//
// Lo que esta función existe para impedir (B7-bajo14) es que alguien escriba un índice
// enorme y engorde el documento hasta el límite de 1 MiB. Eso lo dan los TOPES DE TAMAÑO,
// y esos se conservan íntegros.
//
// Lo que se suelta son comprobaciones de tipo de campos pequeños. `visibility`,
// `discoverable` e `isActive` no quedan sin vigilar: `searchIndexMatchesGroup` ya obliga a
// que COINCIDAN con los del grupo, que es una condición más fuerte que su tipo.
function validGroupSearchIndex(search) {
  return search == null
    || (
      search is map
      && (!("prefixes" in search) || (search.prefixes is list && search.prefixes.size() <= 80))
      && (!("tokens" in search) || (search.tokens is list && search.tokens.size() <= 40))
      && (!("tagsNormalized" in search) || (search.tagsNormalized is list && search.tagsNormalized.size() <= 20))
      && (!("nameNormalized" in search) || (search.nameNormalized is string && search.nameNormalized.size() <= 200))
      && (!("descriptionNormalized" in search) || (search.descriptionNormalized is string && search.descriptionNormalized.size() <= 2000))
    );
}

// B7-bajo14 — edad, etiquetas y categoría.
//
// Las reglas solo pedían `is number` y `is list`. Los límites de verdad
// —18 a 99, `ageMin <= ageMax`, 10 etiquetas— vivían únicamente en
// `lib/groups/createGroup.ts`, o sea en el cliente, o sea en ningún sitio: se
// saltan escribiendo directo contra Firestore.
//
// Peor todavía, el `update` no comprobaba NADA de esto. Se podía crear la
// comunidad con una edad válida y corregirla después a lo que fuera.
function validGroupAudienceFields(data) {
  return (
    data.get("ageMin", null) == null
    || (data.ageMin is number && data.ageMin >= 18 && data.ageMin <= 99)
  )
    && (
      data.get("ageMax", null) == null
      || (data.ageMax is number && data.ageMax >= 18 && data.ageMax <= 99)
    )
    && (
      data.get("ageMin", null) == null
      || data.get("ageMax", null) == null
      || data.ageMin <= data.ageMax
    )
    && (
      data.get("tags", null) == null
      || (data.tags is list && data.tags.size() <= 10)
    )
    && (
      data.get("category", null) == null
      || (data.category is string && data.category.size() <= 120)
    );
}

function validPostSearchIndex(search) {
  return search == null
    || (
      search is map

      && (!("textNormalized" in search) || search.textNormalized is string)
      && (!("tokens" in search) || search.tokens is list)
      && (!("prefixes" in search) || search.prefixes is list)

      && (
        !("contextType" in search)
        || search.contextType in ["group", "profile"]
      )

      && (
        !("groupId" in search)
        || (
          (
            request.resource.data.contextType == "group"
            && search.groupId == request.resource.data.groupId
          )
          ||
          (
            request.resource.data.contextType == "profile"
            && search.groupId == null
          )
        )
      )

      && (
        !("profileId" in search)
        || (
          (
            request.resource.data.contextType == "profile"
            && search.profileId == request.resource.data.profileId
          )
          ||
          (
            request.resource.data.contextType == "group"
            && search.profileId == null
          )
        )
      )

      && (!("authorId" in search) || search.authorId == request.resource.data.authorId)

&& (
  !("visibility" in search)
  || search.visibility == null
  || search.visibility in ["public", "private", "hidden"]
)
      && (!("accessScope" in search) || search.accessScope in ["group", "profile"])

      && (!("isDeleted" in search) || search.isDeleted == request.resource.data.isDeleted)

      && (!("createdAt" in search) || search.createdAt is timestamp)
      // ⚠️ Número o timestamp: ver la nota en `validUserSearchIndex`. Un número guardado
      // aquí dejaba el documento MUERTO — su dueño no podía actualizarlo por ningún campo.
      && (
        !("updatedAt" in search)
        || search.updatedAt == null
        || search.updatedAt is timestamp
        || (search.updatedAt is number && search.updatedAt >= 0)
      )

      && (!("version" in search) || search.version == 1)
    );
}

    function validGroupCreateShape(data) {
      // M01 — el conjunto de claves, no solo sus valores. Sin esto se podía crear
      // la comunidad con campos inventados (`featured`, `verified`, lo que sea) y
      // quedaban guardados. No concedían nada por sí solos, pero engordan el
      // documento y dejan sitio a que una regla futura se fíe de uno de ellos.
      // La lista sale de lo que escribe `lib/groups/createGroup.ts`, más los tres
      // opcionales que ya validaban las funciones de abajo (`settings`,
      // `offerings`, `donation`).
      return data.keys().hasOnly([
        "name", "description", "ownerId", "visibility", "discoverable", "isActive",
        "imageUrl", "coverUrl", "avatarUrl",
        "category", "tags",
        "permissions", "monetization", "settings", "offerings", "donation",
        "greetingsEnabled", "welcomeMessage",
        "ageMin", "ageMax",
        "search", "createdAt", "updatedAt"
      ])
        && data.ownerId == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && (!("description" in data) || (data.description is string && data.description.size() <= 2000))
        && data.visibility in ["public", "private", "hidden"]
        && (!("discoverable" in data) || data.discoverable is bool)
        && (!("isActive" in data) || data.isActive == true)
        && validPermissionsForCreate(data)
        && validMonetizationForCreate(data)
        && validSettingsForCreate(data)
        && offeringsValid(data)
        && donationValid(data)
&& (!("imageUrl" in data) || data.imageUrl == null || data.imageUrl is string)
&& (!("coverUrl" in data) || data.coverUrl == null || data.coverUrl is string)
&& (!("avatarUrl" in data) || data.avatarUrl == null || data.avatarUrl is string)
&& (!("search" in data) || validGroupSearchIndex(data.search))
&& searchIndexMatchesGroup(data)
&& (!("welcomeMessage" in data) || data.welcomeMessage == null || data.welcomeMessage is string)
        && validGroupAudienceFields(data);
    }

    // ==========================
    // MEMBER SHAPE / ACCESS
    // ==========================
    // B7-bajo13 — el espejo de la membresía en `users/{uid}/groupMemberships` copia
// datos de la comunidad, y el usuario escribe su propia copia.
//
// El rol y el estado ya estaban atados al documento real de miembro, así que
// nunca hubo escalada de privilegios. Lo que quedaba suelto eran los datos
// copiados de la comunidad, y uno de ellos gobierna una función de privacidad,
// `OwnerSidebar` esconde las comunidades ocultas de tu lista mirando
// `visibility` DE ESTA COPIA. Bastaba con escribir "public" en tu propio espejo
// para que una comunidad oculta reapareciera. Solo en tu pantalla —nadie más
// puede leer este documento— pero una decisión de privacidad no puede apoyarse
// en un campo que escribe la persona vigilada.
//
// `null` se acepta a propósito: cuando el cliente no puede leer la comunidad,
// `getGroupMembershipSummary` devuelve null entero y el alta escribe null en
// todos estos campos. Rechazarlo rompería el alta legítima.
//
// El nombre, la descripción y las imágenes se quedan libres a propósito: son
// cosméticos, y fijarlos haría que renombrar una comunidad tumbara las altas
// que estuvieran en vuelo con la copia de hace un segundo.
function mirrorFieldMatchesGroup(groupId, data, mirrorKey, groupKey) {
  return data.get(mirrorKey, null) == null
    || data.get(mirrorKey, null) == groupDocAfter(groupId).data.get(groupKey, null);
}

function membershipMirrorIsCoherent(groupId, data) {
  return !groupExistsAfter(groupId)
    || (
      mirrorFieldMatchesGroup(groupId, data, "groupOwnerId", "ownerId")
      && mirrorFieldMatchesGroup(groupId, data, "ownerId", "ownerId")
      && mirrorFieldMatchesGroup(groupId, data, "groupVisibility", "visibility")
      && mirrorFieldMatchesGroup(groupId, data, "visibility", "visibility")
      && mirrorFieldMatchesGroup(groupId, data, "groupIsActive", "isActive")
      && mirrorFieldMatchesGroup(groupId, data, "isActive", "isActive")
      && mirrorFieldMatchesGroup(groupId, data, "groupDiscoverable", "discoverable")
      && mirrorFieldMatchesGroup(groupId, data, "discoverable", "discoverable")
    );
}

function validMembershipAccessType(value) {
      return value in [
        "standard",
        "subscription",
        "legacy_free",
        "requires_subscription"
      ];
    }

function validMemberCreateShape(groupId, userId) {
  let afterGroup = groupDocAfter(groupId).data;

  // M01 — el conjunto de claves. La lista es la unión de los cuatro caminos que
  // crean una membresía desde el cliente: alta del dueño al crear la comunidad
  // (`lib/groups/createGroup.ts`) y las tres formas de entrar de
  // `lib/groups/membership.ts` (normal, con suscripción y legacy gratuita).
  //
  // ⚠️ Los campos de sanción (`removedAt`, `mutedUntil`, `subscriptionEndedAt`…)
  // NO están y es a propósito: en el alta se mandan como `deleteField()`, que en
  // un documento nuevo no deja rastro. Aceptarlos aquí permitiría nacer con un
  // estado de sanción falseado.
  return request.resource.data.keys().hasOnly([
    "userId", "roleInGroup", "status",
    "accessType", "requiresSubscription", "subscriptionActive",
    "subscriptionPriceMonthly", "subscriptionCurrency", "subscribedAt",
    "legacyComplimentary", "legacyGrantedAt",
    "transitionPendingAction",
    "createdAt", "joinedAt", "updatedAt"
  ])
    && request.resource.data.userId == userId
    && (
      (
        request.resource.data.roleInGroup == "owner"
        && afterGroup.ownerId == request.auth.uid
        && request.resource.data.status == "active"
        && (
          !("accessType" in request.resource.data)
          || request.resource.data.accessType == "standard"
        )
        && (
          !("requiresSubscription" in request.resource.data)
          || request.resource.data.requiresSubscription == false
        )
        && (
          !("subscriptionActive" in request.resource.data)
          || request.resource.data.subscriptionActive == false
        )
      )
      ||
      (
        request.resource.data.roleInGroup == "member"
        && request.resource.data.status in ["active", "subscribed"]
        && (
          !("accessType" in request.resource.data)
          || validMembershipAccessType(request.resource.data.accessType)
        )
        && (!("requiresSubscription" in request.resource.data) || request.resource.data.requiresSubscription is bool)
        && (!("subscriptionActive" in request.resource.data) || request.resource.data.subscriptionActive is bool)
        && (!("subscriptionPriceMonthly" in request.resource.data) || validNonNegativeNumberOrNull(request.resource.data.subscriptionPriceMonthly))
        && (!("subscriptionCurrency" in request.resource.data) || request.resource.data.subscriptionCurrency == null || validCurrency(request.resource.data.subscriptionCurrency))
        && (
          (
            afterGroup.visibility == "public"
            && request.resource.data.status == "active"
            && (
              !("accessType" in request.resource.data)
              || request.resource.data.accessType == "standard"
            )
            && (
              !("requiresSubscription" in request.resource.data)
              || request.resource.data.requiresSubscription == false
            )
          )
          ||
          (
            afterGroup.visibility in ["private", "hidden"]
            && (
              "monetization" in afterGroup
              && afterGroup.monetization is map
              && (
                (
                  "subscriptionsEnabled" in afterGroup.monetization
                  && afterGroup.monetization.subscriptionsEnabled == true
                )
                || (
                  "isPaid" in afterGroup.monetization
                  && afterGroup.monetization.isPaid == true
                )
              )
            )
            && request.resource.data.status == "subscribed"
            && (
              !("accessType" in request.resource.data)
              || request.resource.data.accessType == "subscription"
            )
            // Comprobante de pago server-authoritative: solo el backend (Admin SDK)
            // crea `groupSubscriptions/{groupId}_{userId}` (colección backend-only,
            // create:if false). Sin ese doc, un cliente NO puede auto-concederse una
            // membresía de pago sin pagar. El flujo legítimo escribe la membresía con
            // Admin SDK (que ignora estas reglas), así que esta condición no lo afecta.
            //
            // ⚠️ Antes bastaba con `exists()`, y ahí estaba el agujero: los
            // documentos de suscripción NO se borran al terminar, se quedan con
            // `status: ended/cancelled/past_due` y `active: false`. Así que quien
            // pagó una vez podía reconstruirse la membresía años después sin
            // renovar, y volver a entrar a una comunidad de pago u oculta.
            // Ahora se exige que la suscripción siga VIVA y sin vencer.
            && exists(/databases/$(database)/documents/groupSubscriptions/$(groupId + "_" + userId))
            && subscriptionIsCurrent(groupId, userId)
          )
        )
      )
    );
}
        // ==========================
    // GROUPS
    // ==========================
    match /groups/{groupId} {

      allow get: if
        resource.data.visibility == "public"
        || resource.data.visibility == "private"
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || isMember(groupId)
        || isOwner(groupId)
        || isModerator(groupId)
        || isPlatformMod();

allow list: if
  (
    resource.data.search.isActive == true
    && resource.data.search.discoverable == true
    && resource.data.search.visibility in ["public", "private"]
  )
  || (signedIn() && resource.data.ownerId == request.auth.uid)
  || resource.data.visibility == "public"
  || resource.data.visibility == "private"
  || isMember(groupId)
  || isOwner(groupId)
  || isModerator(groupId)
  || isPlatformMod();

      allow create: if notAnonymous()
        && validGroupCreateShape(request.resource.data);

      allow update: if isOwner(groupId)
        && isValidGroupUpdate(groupId);

      allow delete: if false;

      function isValidGroupUpdate(groupId) {
        let allowedKeys = [
          "name",
          "description",
          "visibility",
          "discoverable",
          "category",
          "tags",
          "greetingsEnabled",
          "welcomeMessage",
          "ageMin",
          "ageMax",
          "permissions",
          "monetization",
          "coverUrl",
          "avatarUrl",
          "offerings",
          "donation",
          "settings",
          "isActive",
          "search",
          "updatedAt"
        ];

        let changed = request.resource.data.diff(resource.data).changedKeys();

        return changed.hasOnly(allowedKeys)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt

          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 80

          && (
            !("description" in request.resource.data)
            || (
              request.resource.data.description is string
              && request.resource.data.description.size() <= 2000
            )
          )

          && request.resource.data.visibility in ["public", "private", "hidden"]
          && (!("discoverable" in request.resource.data) || request.resource.data.discoverable is bool)
          && (!("isActive" in request.resource.data) || request.resource.data.isActive is bool)
          && (!("search" in request.resource.data) || validGroupSearchIndex(request.resource.data.search))
          && searchIndexMatchesGroup(request.resource.data)
          && validGroupAudienceFields(request.resource.data)
          // ⚠️ Aquí había un `isCommerceOnlyUpdate ||` delante, y hacía justo lo
          // contrario de lo que parece: una actualización PURAMENTE comercial
          // —monetización, servicios, donaciones— se saltaba sus propios
          // validadores. O sea que los únicos cambios que nadie revisaba eran
          // los que tocan el dinero, y de ahí salían mapas malformados que luego
          // consumen los cobros.
          //
          // Los validadores `...ForUpdate` ya toleran cambios parciales (cada
          // campo se comprueba solo si viene), así que el atajo no hacía falta.
          && (!changed.hasAny(["permissions"]) || validPermissionsForCreate(request.resource.data))
          && (!changed.hasAny(["monetization"]) || validMonetizationForUpdate(request.resource.data))
          && (!changed.hasAny(["settings"]) || validSettingsForCreate(request.resource.data))
          && (!changed.hasAny(["offerings"]) || offeringsValidForUpdate(request.resource.data))
          && (!changed.hasAny(["donation"]) || donationValidForUpdate(request.resource.data))

          && validSubscriptionVisibilityPolicy(request.resource.data);
      }

      match /members/{userId} {
        allow get: if signedIn()
          && (
            request.auth.uid == userId
            || canModerateGroup(groupId)
            || canMemberListBeSeen(groupId)
          );

// ⚠️ El `list` tiene que respetar el MISMO ajuste que el `get` de arriba.
//
// Antes bastaba con que la comunidad fuera pública o privada: cualquier cuenta
// con sesión podía ENUMERAR a todos sus miembros aunque el creador hubiera
// cerrado la lista con `membersListVisibility: "owner_only"`. El ajuste se
// respetaba al leer un miembro suelto y se saltaba al listarlos todos, que es
// justo la forma en que se sacan los datos.
//
// El valor por defecto es `owner_only` tanto aquí como en el cliente
// (`page.tsx` hace `?? "owner_only"` y esconde la pestaña), así que cerrar esto
// no quita nada que la interfaz enseñara: alinea el servidor con lo que ya
// esperaba el cliente.
//
// ORDEN IMPORTANTE. En un `list`, `resource.data` solo trae los campos que la
// consulta fija con `==`; tocar cualquier otro es un ERROR de evaluación. Por eso
// `resource.data.userId` va AL FINAL: las ramas que no miran el documento se
// resuelven antes y, si alguna es cierta, el error ni se alcanza.
//
// Coste: `canMemberListBeSeen` y `canModerateGroup` leen el documento de la
// comunidad y el de MI membresía. Son los MISMOS dos documentos para todos los
// elementos de la consulta, así que cuentan una vez contra el tope de 10 `get()`
// y listar 200 miembros sigue costando dos lecturas.
allow list: if signedIn()
  && (
    isPlatformMod()
    || canModerateGroup(groupId)
    || canMemberListBeSeen(groupId)
    || request.auth.uid == resource.data.userId
  );

        allow create: if notAnonymous()
          && request.auth.uid == userId
          && groupExistsAfter(groupId)
          && (
            !("isActive" in groupDocAfter(groupId).data)
            || groupDocAfter(groupId).data.isActive == true
          )
          && !exists(/databases/$(database)/documents/groups/$(groupId)/members/$(userId))
          && validMemberCreateShape(groupId, userId);

        // Un miembro puede salir (borrar su doc) SALVO si está sancionado: si
        // pudiera borrarlo, se auto-desbanearía/desmutearía y recrearía el doc
        // como "active" (create exige !exists). El status queda persistente hasta
        // que un mod lo levante por callable.
        //
        // ⚠️ `removed` faltaba en esta lista y eso deshacía la expulsión entera.
        // Expulsar a alguien de una comunidad PÚBLICA es definitivo —decisión de
        // producto de Luis, 2026-08-16: "ya no puede volver nunca, como si hubiera
        // sido bloqueado"—, pero el expulsado podía borrar su propio documento y
        // volver a crearlo como `active`, porque `create` solo exige que NO exista.
        // La sanción se limpiaba sola en dos clics.
        allow delete: if notAnonymous()
          && request.auth.uid == userId
          && groupDoc(groupId).data.ownerId != request.auth.uid
          && !(normalizeMemberStatus(resource.data) in ["banned", "muted", "removed"]);

        allow update: if false;
      }

match /memberBlocks/{blockId} {
  allow get: if signedIn()
    && isMember(groupId);

  allow list: if signedIn()
    && isMember(groupId)
    && (
      resource.data.blockerId == request.auth.uid
      || resource.data.blockedUserId == request.auth.uid
    );

  allow create: if notAnonymous()
    && isMember(groupId)
    && !isOwner(groupId)
    && validGroupMemberBlockDoc(groupId, blockId)
    && memberExists(groupId, request.resource.data.blockedUserId);

  allow update: if false;

  allow delete: if notAnonymous()
    && resource.data.blockerId == request.auth.uid;
}

      match /joinRequests/{reqId} {
        allow get: if signedIn()
          && (
            request.auth.uid == reqId
            || canModerateGroup(groupId)
          );

        allow list: if signedIn()
          && canModerateGroup(groupId);

        allow create: if notAnonymous()
          && request.auth.uid == reqId
          && groupRequiresJoinRequest(groupId)
          && groupIsActive(groupId)
          // Un baneado no puede volver a solicitar ingreso (el kick/removed sí,
          // porque el kick es suave). effectiveMemberStatus es null para no-miembros.
          && effectiveMemberStatus(groupId, reqId) != "banned"
          // M01 — claves de `lib/groups/joinRequests.ts`.
          && request.resource.data.keys().hasOnly([
            "userId", "groupId", "status", "createdAt", "updatedAt"
          ])
          && request.resource.data.userId == reqId
          && request.resource.data.status == "pending";

        allow delete: if notAnonymous()
          && request.auth.uid == reqId
          && resource.data.status == "pending";

        allow update: if false;
      }

      // Invitaciones a MODERAR. Las escribe SOLO el backend (callables
      // inviteGroupModerator / respondGroupModeratorInvite): el ascenso a
      // moderador nunca puede salir del cliente. Lectura: el dueño ve las que
      // repartió y cada persona ve la suya.
      match /moderatorInvites/{inviteeId} {
        allow get: if signedIn()
          && (request.auth.uid == inviteeId || isOwner(groupId));

        allow list: if signedIn() && isOwner(groupId);

        allow create, update, delete: if false;
      }

      match /inviteLinks/{linkId} {
        allow read, write: if false;
      }
    }

    // ==========================
    // GREETING REQUESTS
    // ==========================
    // Muestras de saludo/consejo: contenido que el creador graba para su propia
    // vitrina. No mueven dinero y no tienen comprador.
    //
    // Solo escribe el backend (createGreetingSampleUpload y sus hermanos), igual
    // que en greetingRequests: el cliente jamás fabrica una muestra por su
    // cuenta, porque cada una consume un asset de Mux facturable.
    //
    // La lectura es del dueño: lo que ve el público es la HISTORIA creada a
    // partir de la muestra, no este documento de trabajo.
    match /greetingSamples/{sampleId} {
      allow create: if false;
      allow update: if false;
      allow delete: if false;

      // Una muestra LISTA y de PERFIL es escaparate: se graba justo para que la
      // vea quien todavia no ha comprado nada. Por eso entra al feed de reels y
      // se puede leer sin ser el dueno.
      //
      // ⚠️ Se lee con `get` y valor por defecto, no a pelo: en un `list` lo que la
      // consulta no fija se comporta como ausente, y tocarlo es un ERROR de
      // evaluacion que deniega la consulta ENTERA. Es el mismo fallo que tenia
      // mordido al feed de lives.
      //
      // Las muestras de COMUNIDAD quedan fuera a proposito: su visibilidad
      // deberia seguir a la de la comunidad, y comprobar eso por documento es
      // justo lo que agota el tope de accesos de un `list` y tumba la consulta.
      // Es la misma linea que ya separa a las historias de comunidad privada.
      function esMuestraDeEscaparate() {
        return resource.data.get('status', '') == "ready"
          && resource.data.get('isDeleted', true) == false
          && resource.data.get('source', '') == "profile";
      }

      allow get, list: if (signedIn() && resource.data.creatorId == request.auth.uid)
        || esMuestraDeEscaparate();
    }

    match /greetingRequests/{requestId} {
      allow create: if false;
      allow update: if false;
      allow delete: if false;

      allow get: if signedIn()
        && (
          resource.data.buyerId == request.auth.uid
          || resource.data.creatorId == request.auth.uid
          // El supermoderador revisa la experiencia cuando la denuncian.
          || isPlatformMod()
        );

      allow list: if signedIn()
        && (
          resource.data.buyerId == request.auth.uid
          || resource.data.creatorId == request.auth.uid
        );
    }

    // ==========================
    // STORIES
    // ==========================
    /** Una historia sin comunidad es de perfil. null y "" significan lo mismo. */
    function storyHasNoGroup(data) {
      return !("groupId" in data) || data.groupId == null || data.groupId == "";
    }

    match /stories/{storyId} {
      // ⚠️ Antes era `allow read: if true` para TODAS. El cliente marcaba las de
      // comunidades no públicas como `searchable: false`, pero "no buscable" no
      // es "no legible": con el id se leían igual, y con ellas el creador, las
      // categorías y el `muxPlaybackId` del contenido. Por ahí se podía deducir
      // quién participa en una comunidad que no debería saberse que existe.
      //
      // Ahora una historia de comunidad sigue la regla de SU comunidad. Las de
      // perfil (sin groupId) siguen públicas, que es lo que se quiere.
      // ⚠️ El ORDEN de estas tres condiciones no es estético, es lo que hace
      // viable el feed de reels.
      //
      // `canReadGroupContent()` hace un `get()` al documento de la comunidad. En
      // una lectura de UN documento eso da igual, pero en un `list` la regla se
      // evalúa por cada documento devuelto y los `get()` comparten un tope de 10
      // para la consulta ENTERA. El descubrimiento pide decenas de candidatos: en
      // cuanto unos pocos son de comunidad, se agota el tope y se cae la consulta
      // COMPLETA, no solo esos documentos.
      //
      // Por eso delante va la comprobación barata: `searchable` ya guarda, sin
      // consultar nada, si la historia es públicamente legible (perfil siempre;
      // comunidad solo si es pública). Con `searchable == true` fijado en la
      // consulta, ningún documento devuelto llega al `get()` y el descubrimiento
      // cuesta cero lecturas de reglas.
      //
      // Esto solo es seguro mientras `searchable` sea honesto, y de eso responden
      // TRES cosas juntas: se valida al crear (abajo), el cliente no puede
      // tocarlo (el `update` de abajo solo deja `hiddenFromReel`), y un disparador
      // lo resincroniza cuando la comunidad cambia de visibilidad
      // (`syncStoriesSearchable` en backend/src/groupPostsVisibilitySync.ts). Si
      // se rompe cualquiera de las tres, esta regla filtra.
      // ⚠️ B8-C03. La segunda condición era `storyHasNoGroup(...)` a secas: TODA
      // historia de perfil era legible por cualquiera, sin mirar si el perfil
      // está cerrado (`profileRestricted`), si oculta sus publicaciones
      // (`showPosts`) ni si hay un bloqueo entre las dos personas. Las
      // publicaciones sí lo miraban —`canReadProfileContent` existe desde hace
      // bloques— y las historias se quedaron fuera.
      //
      // El comentario de arriba decía "las de perfil siguen públicas, que es lo
      // que se quiere", y era cierto para el caso que se estaba resolviendo
      // entonces (perfil vs comunidad). Nunca se decidió que un perfil CERRADO
      // siguiera enseñando sus historias; simplemente no se miró.
      //
      // El orden se conserva: `searchable == true` sigue delante y sigue
      // costando cero `get()`, que es lo que hace viable el feed de reels. La
      // comprobación cara solo se paga al abrir una historia concreta.
      // Quien la publicó siempre puede leerla. Faltaba, y por eso el panel del
      // comprador no podía consultar la historia que él mismo acababa de sacar
      // de su saludo: si su perfil está cerrado, `canReadProfileContent` le
      // negaba su propio contenido. Va DELANTE porque no cuesta ningún get().
      allow read: if (request.auth != null && resource.data.creatorId == request.auth.uid)
        || ("searchable" in resource.data && resource.data.searchable == true)
        || (storyHasNoGroup(resource.data) && canReadProfileContent(resource.data.creatorId))
        || canReadGroupContent(resource.data.groupId);

      // Only the authenticated creator can create their own story
      //
      // ⚠️ Si la historia declara comunidad, hay que pertenecer a ella. Antes el
      // `groupId` no se comprobaba en absoluto, así que cualquiera podía crear
      // una historia con el id de una comunidad ajena y colarla en su carrusel
      // sin ser miembro. Es el mismo patrón que B4-C03 con las publicaciones.
      //
      // El `groupId` sale de DÓNDE se publica (perfil o comunidad), no de la
      // solicitud de la que nace la historia: publicar en el propio perfil un
      // saludo pedido dentro de una comunidad es legítimo, y el comprador puede
      // publicarlo como suyo. Por eso se comprueba pertenencia y no procedencia.
      allow create: if notAnonymous()
        // M01 — claves de `addStoryFromGreeting` en lib/stories/storyService.ts.
        && request.resource.data.keys().hasOnly([
          "creatorId", "creatorName", "greetingCreatorId", "greetingRequestId",
          "instructions", "type", "source", "groupId",
          "muxPlaybackId", "thumbnailUrl", "videoDuration",
          "searchable", "searchPrefixes", "categories",
          "byCreator", "hiddenFromReel",
          "viewsCount", "createdAt"
        ])
        // Los tres campos que gobiernan el descubrimiento son OBLIGATORIOS. Con
        // solo `hasOnly` podían venir ausentes y las comprobaciones de abajo se
        // saltaban solas.
        && request.resource.data.keys().hasAll([
          "creatorId", "type", "greetingRequestId",
          "searchable", "byCreator", "hiddenFromReel"
        ])
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.type in ["saludo", "consejo"]
        && request.resource.data.greetingRequestId is string
        && request.resource.data.greetingRequestId.size() > 0
        && (
          storyHasNoGroup(request.resource.data)
          || isMember(request.resource.data.groupId)
          || isOwner(request.resource.data.groupId)
          || isModerator(request.resource.data.groupId)
        )
        // `searchable` = "cualquiera puede leer esto". Antes lo escribía el
        // cliente sin comprobarse, y la regla de lectura no lo miraba, así que
        // mentir solo estropeaba la búsqueda. Ahora la lectura SÍ se apoya en él,
        // así que mentir sería abrir la historia al mundo: un miembro de una
        // comunidad oculta podría delatarla. Se ata a la visibilidad real.
        // ⚠️ B8-C03. Aquí faltaba el perfil. `searchable` significa "cualquiera
        // puede leer esto", y se ataba solo a la visibilidad de la COMUNIDAD: un
        // perfil cerrado seguía publicando historias marcadas como públicas, que
        // es lo que las mantenía en el feed de reels con su vídeo y su nombre.
        //
        // El perfil que manda es el de QUIEN PUBLICA (`creatorId`), no el de
        // quien grabó el saludo: son distintos cuando el comprador republica el
        // saludo de otro, y la regla de lectura mira `creatorId`.
        //
        // Esta regla se retuvo hasta que el cliente que calcula el valor honesto
        // estuvo desplegado, porque cerrarla antes habría dejado a los perfiles
        // cerrados sin poder publicar historias.
        && request.resource.data.searchable == (
          (
            storyHasNoGroup(request.resource.data)
            || isGroupPublic(request.resource.data.groupId)
          )
          && profileAllowsPublicPosts(request.resource.data.creatorId)
        )
        // `byCreator` distingue la historia que publica el CREADOR de la que
        // republica el COMPRADOR (mismo video, dos documentos). El reel solo
        // muestra la del creador, y Firestore no sabe comparar dos campos entre
        // sí en una consulta, así que la comparación se congela aquí.
        && request.resource.data.byCreator == (
          ("greetingCreatorId" in request.resource.data)
            ? request.resource.data.greetingCreatorId == request.resource.data.creatorId
            : true
        )
        // Nace visible. Sacarla del reel es un acto posterior y explícito.
        && request.resource.data.hiddenFromReel == false
        // ⚠️ B8-H05, la otra mitad. Las historias no tenían NINGÚN freno: una
        // cuenta podía crearlas sin límite. Mismo mecanismo que los comentarios,
        // el contador viaja en el MISMO lote atómico y la regla lo exige aquí.
        // 20 al día, decisión de Luis (2026-08-16).
        && getAfter(
             /databases/$(database)/documents/rateLimits/$(request.auth.uid + '_story')
           ).data.lastAt == request.time
        // ── B8-H05: forma y tamaño de lo que se guarda ────────────────────
        //
        // `hasOnly` fija QUÉ claves pueden venir, pero no lo que traen dentro.
        // La fecha, el contador, los prefijos de búsqueda y las categorías no
        // se comprobaban en absoluto: se podía publicar una historia fechada en
        // 2099 para que se quedara clavada arriba del reel, estrenar con
        // `viewsCount` inflado, o meter miles de prefijos y categorías para
        // aparecer en toda búsqueda y toda recomendación.
        //
        // Los topes son los que ya aplica `lib/stories/storyService.ts`: 80
        // prefijos (`buildStorySearchPrefixes`) y 19 categorías canónicas, 20
        // por dejar margen.
        //
        // ⚠️ `request.time` es la hora del SERVIDOR y es exactamente en lo que
        // se resuelve el `serverTimestamp()` que manda el cliente. Fijarla aquí
        // es lo que impide fechar una historia a voluntad.
        && request.resource.data.createdAt == request.time
        && request.resource.data.get('viewsCount', 0) == 0
        && (
          !("searchPrefixes" in request.resource.data)
          || (request.resource.data.searchPrefixes is list
              && request.resource.data.searchPrefixes.size() <= 80)
        )
        && (
          !("categories" in request.resource.data)
          || (request.resource.data.categories is list
              && request.resource.data.categories.size() <= 20)
        )
        && (
          !("creatorName" in request.resource.data)
          || (request.resource.data.creatorName is string
              && request.resource.data.creatorName.size() <= 120)
        )
        && (
          !("instructions" in request.resource.data)
          || request.resource.data.instructions == null
          || (request.resource.data.instructions is string
              && request.resource.data.instructions.size() <= 2000)
        )
        && (
          !("muxPlaybackId" in request.resource.data)
          || request.resource.data.muxPlaybackId == null
          || (request.resource.data.muxPlaybackId is string
              && request.resource.data.muxPlaybackId.size() <= 200)
        )
        && (
          !("videoDuration" in request.resource.data)
          || request.resource.data.videoDuration == null
          || (request.resource.data.videoDuration is number
              && request.resource.data.videoDuration >= 0
              && request.resource.data.videoDuration <= 86400)
        )
        // La portada sale de Mux. Anclar el host evita que la historia sirva
        // como baliza para registrar la IP de quien abra el reel.
        && (
          !("thumbnailUrl" in request.resource.data)
          || request.resource.data.thumbnailUrl == null
          || (request.resource.data.thumbnailUrl is string
              && request.resource.data.thumbnailUrl
                   .matches('https://[a-zA-Z0-9._-]+[.](mux[.]com|cloudflarestream[.]com)(/.*)?'))
        )
        && request.resource.data.source in ["profile", "group"];

      // Creator can delete their own stories
      allow delete: if notAnonymous()
        && resource.data.creatorId == request.auth.uid;

      // Antes era `allow update: if false` y era lo correcto mientras las
      // historias caducaban a las 24h. El reel las vuelve permanentes, así que
      // quien publicó necesita poder retirarla del descubrimiento sin borrarla
      // (borrarla también la quita de sus propios círculos, que es otra cosa).
      //
      // La rendija es de un solo campo. `affectedKeys().hasOnly` es lo que impide
      // que por aquí se cuele un cambio de `searchable`, que tumbaría la regla de
      // lectura de arriba.
      allow update: if notAnonymous()
        && resource.data.creatorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["hiddenFromReel"])
        && request.resource.data.hiddenFromReel is bool;
    }

    // ==========================
    // SEÑALES DEL FEED DE REELS
    // ==========================
    //
    // Qué palabras del contexto retienen a cada persona, deducido del tiempo que
    // se queda mirando. Es un perfil de gustos, así que solo lo ve y lo escribe
    // su dueño; ni siquiera los moderadores tienen por qué leerlo.
    match /users/{userId}/reelSignals/{docId} {
      allow read, write: if notAnonymous() && request.auth.uid == userId;
    }

    // ==========================
    // STORY VIEWS
    // ==========================
    match /userStoryViews/{userId}/views/{storyId} {
      // Users can only read and write their own view records
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if notAnonymous()
        && request.auth.uid == userId
        && request.resource.data.storyId == storyId;
    }

    // ==========================
    // MEET & GREET REQUESTS
    // ==========================
    match /meetGreetRequests/{requestId} {
      allow create: if false;
      allow update: if false;
      allow delete: if false;

      allow get: if signedIn()
        && (
          resource.data.buyerId == request.auth.uid
          || resource.data.creatorId == request.auth.uid
          // El supermoderador revisa la experiencia cuando la denuncian.
          || isPlatformMod()
        );

      allow list: if signedIn()
        && (
          resource.data.buyerId == request.auth.uid
          || resource.data.creatorId == request.auth.uid
        );
    }

    // ==========================
    // CUSTOM CLASS REQUESTS
    // ==========================
    match /customClassRequests/{requestId} {
      allow create: if false;
      allow update: if false;
      allow delete: if false;

      allow get: if signedIn()
        && (
          resource.data.buyerId == request.auth.uid
          || resource.data.creatorId == request.auth.uid
          // El supermoderador revisa la experiencia cuando la denuncian.
          || isPlatformMod()
        );

      allow list: if signedIn()
        && (
          resource.data.buyerId == request.auth.uid
          || resource.data.creatorId == request.auth.uid
        );
    }

    // ==========================
    // EXCLUSIVE SESSION REQUESTS
    // ==========================
    match /exclusiveSessionRequests/{requestId} {
      allow create: if false;
      allow update: if false;
      allow delete: if false;

      allow get: if signedIn()
        && (
          resource.data.buyerId == request.auth.uid
          || resource.data.creatorId == request.auth.uid
          // El supermoderador revisa la experiencia cuando la denuncian.
          || isPlatformMod()
        );

      allow list: if signedIn()
        && (
          resource.data.buyerId == request.auth.uid
          || resource.data.creatorId == request.auth.uid
        );
    }

    function userExists(uid) {
  return exists(/databases/$(database)/documents/users/$(uid));
}

function userDoc(uid) {
  return get(/databases/$(database)/documents/users/$(uid));
}

function profileAllowsPublicPosts(uid) {
  return userExists(uid)
    && (
      !("showPosts" in userDoc(uid).data)
      || userDoc(uid).data.showPosts != false
    )
    && (
      !("profileRestricted" in userDoc(uid).data)
      || userDoc(uid).data.profileRestricted != true
    );
}

function canReadProfileContent(profileUid) {
  return userExists(profileUid)
    && (
      (
        signedIn()
        && request.auth.uid == profileUid
      )
      ||
      (
        profileAllowsPublicPosts(profileUid)
        && (
          !signedIn()
          || !usersHaveBlockBetween(request.auth.uid, profileUid)
        )
      )
    );
}

function userFollowsProfile(viewerUid, profileUid) {
  return exists(/databases/$(database)/documents/users/$(viewerUid)/following/$(profileUid))
    && get(/databases/$(database)/documents/users/$(viewerUid)/following/$(profileUid)).data.userId == viewerUid
    && get(/databases/$(database)/documents/users/$(viewerUid)/following/$(profileUid)).data.targetUserId == profileUid;
}

function profileFollowIsOldEnoughForComment(viewerUid, profileUid) {
  return userFollowsProfile(viewerUid, profileUid)
    && get(/databases/$(database)/documents/users/$(viewerUid)/following/$(profileUid)).data.createdAt is timestamp
    && get(/databases/$(database)/documents/users/$(viewerUid)/following/$(profileUid)).data.createdAt <= request.time - duration.value(24, "h");
}

function canCommentOnProfilePost(profileUid) {
  return signedIn()
    && userExists(profileUid)
    && !usersHaveBlockBetween(request.auth.uid, profileUid)
    && (
      request.auth.uid == profileUid
      ||
      (
        profileAllowsPublicPosts(profileUid)
        && profileFollowIsOldEnoughForComment(request.auth.uid, profileUid)
      )
    );
}

function isGroupPostData(data) {
  return (
    !("contextType" in data)
    || data.contextType == "group"
  )
  && data.groupId is string;
}

function isProfilePostData(data) {
  return data.contextType == "profile"
    && data.profileId is string
    && data.authorId == data.profileId;
}

// ¿Este post NO vive en una comunidad OCULTA? Es el candado que deben cruzar
// todas las vías "públicas" de acceso a un post y a sus subcolecciones abiertas
// (comentarios, reacciones, supercomentarios, espectadores, chat del live).
//
// Se comprueba por partida doble:
//   1. La copia denormalizada `groupVisibility` del propio doc (barata).
//   2. El doc del grupo, que es la fuente de verdad — cubre los posts legados
//      cuya copia quedó desactualizada antes del trigger de resincronización.
// El doc del grupo suele venir ya cacheado por `canReadGroupContent` dentro de
// la misma evaluación, así que en la práctica no añade accesos.
//
// Posts de perfil (sin groupId) pasan siempre: no pertenecen a comunidad alguna.
function groupPostIsNotHidden(data) {
  let gid = data.get('groupId', null);
  return !(gid is string)
    || (
      data.get('groupVisibility', '') != "hidden"
      && groupVisibility(gid) != "hidden"
    );
}

    // ==========================
    // LIVE OVERLAYS (OBS Browser Source)
    // ==========================
    // Colección pública: solo contiene activeSuper para el overlay de OBS.
    // No requiere auth para leer — necesario porque OBS no tiene sesión de Firebase.
    match /liveOverlays/{postId} {
      allow get: if true;
      // Solo el autor del live alimenta su overlay. Antes bastaba con estar
      // logueado, así que cualquiera podía inyectar (o borrar) el supercomentario
      // que se muestra en el OBS de otro creador.
      allow write: if signedIn()
        && get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid;
    }

    // ==========================
    // POSTS
    // ==========================
match /posts/{postId} {

function canReadPublicSharedPost() {
  return resource.data.isDeleted == false

    && (
      (
        isGroupPostData(resource.data)
        && resource.data.groupVisibility == "public"
        // ⚠️ La copia que lleva el post puede estar desfasada. Si una comunidad
        // pasó a privada u oculta y algún post conservó `groupVisibility:
        // "public"`, ese post seguía siendo legible por cualquiera con su id.
        // Aquí se le pregunta a la comunidad DE VERDAD.
        //
        // Solo en la lectura por id: en los listados no cabe, cada documento
        // gastaría un `get()` y revientan la cuota (ya pasó con el feed de
        // guardados). Ahí la defensa es el trigger `groupPostsVisibilitySync`,
        // que mantiene la copia al día.
        && groupVisibility(resource.data.groupId) == "public"
        && (
          !("isShareable" in resource.data)
          || resource.data.isShareable == true
        )
      )
      ||
      (
        resource.data.contextType == "profile"
        && resource.data.profileRestricted == false
      )
    )

    && (
      !("search" in resource.data)
      || (
        resource.data.search is map
        && (
          !("visibility" in resource.data.search)
          || resource.data.search.visibility == "public"
        )
        && (
          !("isDeleted" in resource.data.search)
          || resource.data.search.isDeleted == false
        )
      )
    )

    && (
      !("accessModel" in resource.data)
      || resource.data.accessModel == "free"
    )

    && (
      !("requiresPayment" in resource.data)
      || resource.data.requiresPayment == false
    )

    && (
      !("requiresSubscription" in resource.data)
      || resource.data.requiresSubscription == false
    );
}

function canReadPublicPremiumGroupPost() {
  return resource.data.isDeleted == false
    && isGroupPostData(resource.data)
    && resource.data.groupVisibility != "hidden"
    && resource.data.isShareable == true
    && "premium" in resource.data
    && resource.data.premium is map
    && resource.data.premium.enabled == true
    && resource.data.premium.accessMode == "public";
}

// OJO: aquí NO se exige `groupId is string`. En un `list`, `resource.data` solo
// tiene los campos que la query fija con `==`, y el feed del PERFIL consulta por
// `authorId` (sin groupId): pedirlo hacía reventar la evaluación y se denegaba la
// consulta entera. La barrera real es `groupVisibility != "hidden"`, que la query
// SÍ debe fijar — un post sin ese campo fijado no puede pasar por aquí.
function canListPublicPremiumGroupPost() {
  return resource.data.isDeleted == false
    && resource.data.groupVisibility != "hidden"
    && resource.data.isShareable == true
    && "premium" in resource.data
    && resource.data.premium is map
    && resource.data.premium.enabled == true
    && resource.data.premium.accessMode == "public";
}

function canListBroadcastPublicLivePost() {
  // `isDeleted` y `groupVisibility` van por `get` con valor por defecto, igual
  // que en guestAllowedForLive y liveScopeAllowsViewer, y por el mismo motivo:
  // en un `list` lo que la query no fija se comporta como ausente, y leerlo a
  // pelo es un ERROR de evaluacion que tumba la consulta ENTERA.
  //
  // ⚠️ Esto tenia mordido al feed de reels: un live creado desde un PERFIL no
  // tiene comunidad, asi que no trae `groupVisibility`, y la consulta de lives
  // se denegaba entera. Los defaults no aflojan nada: un post borrado lleva
  // `isDeleted` en true y uno de comunidad oculta lleva `groupVisibility` en
  // "hidden", asi que esos siguen sin pasar.
  return resource.data.get('isDeleted', false) == false
    && resource.data.get('groupVisibility', 'public') != "hidden"
    // `liveData` puede no existir (posts normales). Sin este guard, evaluar
    // `liveData.status` en un doc sin el campo es un ERROR de reglas y tumba la
    // query COMPLETA, no solo ese documento.
    && "liveData" in resource.data
    && resource.data.liveData is map
    && resource.data.liveData.get('status', '') == "live"
    && resource.data.liveData.get('allowLoggedOutViewers', false) == true;
}

// Post de PAGO compartible SIN mapa `premium` — es el caso del live con boleto y
// de su VOD: el creador eligió alcance "todos" (por eso `isShareable`), así que
// los no-miembros deben poder VERLO BLOQUEADO para poder comprarlo. Sin esta
// cláusula un live de pago en estado `upcoming`/`ended` no pasa ninguna regla y
// hace fallar la query entera del feed público de la comunidad.
// Nunca aplica a comunidades ocultas ni a contenido de suscripción.
function canReadPaidShareableGroupPost() {
  return resource.data.isDeleted == false
    && resource.data.groupId is string
    && resource.data.groupVisibility != "hidden"
    && resource.data.isShareable == true
    && resource.data.requiresPayment == true
    && (
      !("requiresSubscription" in resource.data)
      || resource.data.requiresSubscription == false
    );
}

// El autor puede listar sus propios posts (p. ej. sus lives para el calendario).
// Seguro: la cláusula solo pasa por-documento cuando authorId == uid, así que
// una consulta solo puede traer los posts del propio usuario.
function canListOwnAuthoredPost() {
  return signedIn()
    && resource.data.authorId == request.auth.uid;
}

function canReadPublicShareableGroupPost() {
  return resource.data.isDeleted == false
    && resource.data.groupId is string
    && resource.data.groupVisibility != "hidden"
    && resource.data.isShareable == true
    && (
      !("accessModel" in resource.data)
      || resource.data.accessModel == "free"
    )
    && (
      !("requiresPayment" in resource.data)
      || resource.data.requiresPayment == false
    )
    && (
      !("requiresSubscription" in resource.data)
      || resource.data.requiresSubscription == false
    );
}

function canListPublicShareableGroupPost() {
  return resource.data.isDeleted == false
    && resource.data.groupId is string
    && resource.data.groupVisibility != "hidden"
    && resource.data.isShareable == true
    && (
      !("accessModel" in resource.data)
      || resource.data.accessModel == "free"
    )
    && (
      !("requiresPayment" in resource.data)
      || resource.data.requiresPayment == false
    );
}

// Descubrimiento: listar posts públicos+compartibles+gratis de comunidades
// PÚBLICAS por `groupVisibility` (no por groupId). Cubre la query del feed de
// descubrimiento que filtra por groupCategory + groupVisibility == "public".
// Expone el mismo conjunto que canListPublicShareableGroupPost (posts públicos
// compartibles), solo que asegurado por groupVisibility en vez de groupId.
function canListPublicDiscoveryPost() {
  return resource.data.isDeleted == false
    && resource.data.groupVisibility == "public"
    && resource.data.isShareable == true
    && (
      !("accessModel" in resource.data)
      || resource.data.accessModel == "free"
    )
    && (
      !("requiresPayment" in resource.data)
      || resource.data.requiresPayment == false
    )
    && (
      !("requiresSubscription" in resource.data)
      || resource.data.requiresSubscription == false
    );
}

function canReadPost() {
  return resource.data.isDeleted == false
    && (
      // El AUTOR siempre puede leer su propio post, sin importar el tipo ni si le
      // faltan campos (posts antiguos sin contextType/profileId). Evita el falso
      // "publicación no disponible" al abrir la notificación de reacción/comentario
      // en el propio post.
      (
        signedIn()
        && resource.data.authorId == request.auth.uid
      )
      ||
      (
        isGroupPostData(resource.data)
        && (
          canReadPublicSharedPost()
          || canReadPublicPremiumGroupPost()
          || canReadPaidShareableGroupPost()
          || canReadPublicShareableGroupPost()
          || canReadGroupContent(resource.data.groupId)
        )
      )
      ||
      (
        isProfilePostData(resource.data)
        && canReadProfileContent(resource.data.profileId)
      )
    );
}

function canReadPostFromOwnHomeFeed() {
  return signedIn()
    && resource.data.isDeleted == false
    && exists(/databases/$(database)/documents/users/$(request.auth.uid)/homeFeed/$(postId))
    && get(/databases/$(database)/documents/users/$(request.auth.uid)/homeFeed/$(postId)).data.isVisible == true
    && (
      (
        isGroupPostData(resource.data)
        && canReadGroupContent(resource.data.groupId)
      )
      ||
      (
        isProfilePostData(resource.data)
        && canReadProfileContent(resource.data.profileId)
      )
    );
}

function canReadPostFromOwnSavedPosts() {
  return signedIn()
    && resource.data.isDeleted == false
    && exists(/databases/$(database)/documents/users/$(request.auth.uid)/savedPosts/$(postId))
    // Aunque esté guardado, respeta el acceso actual: bloqueo de perfil / membresía
    // (mismo gating que canReadPostFromOwnHomeFeed). Cierra la fuga de leer posts de
    // un perfil que te bloqueó porque los guardaste antes.
    && (
      (
        isGroupPostData(resource.data)
        && canReadGroupContent(resource.data.groupId)
      )
      ||
      (
        isProfilePostData(resource.data)
        && canReadProfileContent(resource.data.profileId)
      )
    );
}

// ¿Este post activa monetización? (premium, pago o precio).
function postClaimsMonetization(data) {
  return (
    "premium" in data
    && data.premium != null
    && data.premium is map
    && data.premium.get('enabled', false) == true
  )
  || data.get('requiresPayment', false) == true
  || (data.get('accessModel', 'free') != 'free')
  || data.get('oneTimePrice', null) != null;
}

/**
 * Monetizar una publicación de comunidad es cosa del DUEÑO.
 *
 * ⚠️ Esto solo existía en el frontend (`lib/posts/premium.ts` dice literalmente
 * "Solo el dueño de la comunidad puede crear publicaciones premium"), pero las
 * reglas no lo comprobaban. Un miembro normal podía saltarse la interfaz, crear
 * contenido de pago dentro de la comunidad de otro, y Stripe después le cobraba
 * a los compradores y le acuñaba a él las ganancias, porque confía en el
 * `authorId` del documento.
 *
 * También se acota el precio: sin esto se podía publicar a 0, negativo o a un
 * millón, y el intent de pago lee ese número tal cual.
 */
function validPostMonetization(groupId) {
  return !postClaimsMonetization(request.resource.data)
    || (
      isOwner(groupId)
      && validPostPrice(request.resource.data)
    );
}

function validPostPrice(data) {
  return data.get('oneTimePrice', null) == null
    || (
      data.oneTimePrice is number
      && data.oneTimePrice >= 10
      && data.oneTimePrice <= 100000
      && data.get('currency', 'MXN') == 'MXN'
    );
}

// ⚠️ Las dos ramas de creación se combinan con OR, así que un post que engañe a
// UNA de ellas entra. Antes la rama de perfil solo miraba `profileId == mi uid` y
// no le importaba que el documento trajera ADEMÁS un `groupId` ajeno: se colaba
// por la puerta de perfil y aterrizaba dentro de una comunidad de otra persona,
// incluso oculta. Y de ahí los triggers lo repartían al feed de todos sus
// miembros y disparaban notificaciones.
//
// Ahora cada rama exige que el post sea SOLO de su tipo. Son excluyentes.

function validCreateGroupPost() {
  return notAnonymous()
    && request.resource.data.authorId == request.auth.uid
    && request.resource.data.isDeleted == false
    && request.resource.data.groupId is string
    // No puede venir disfrazado también de post de perfil.
    && (!("contextType" in request.resource.data)
        || request.resource.data.contextType == "group")
    && !("profileId" in request.resource.data)
    && canPostInGroup(request.resource.data.groupId)
    && validPostMonetization(request.resource.data.groupId);
}

function validCreateProfilePost() {
  return notAnonymous()
    && request.resource.data.authorId == request.auth.uid
    && request.resource.data.isDeleted == false
    && request.resource.data.profileId is string
    && request.resource.data.profileId == request.auth.uid
    // Y NO puede traer nada de comunidad: ese era el hueco.
    && request.resource.data.contextType == "profile"
    && !("groupId" in request.resource.data)
    // En su propio perfil sí puede monetizar (es suyo), pero el precio se acota
    // igual: el intent de pago lee ese número tal cual.
    && validPostPrice(request.resource.data)
    && userExists(request.resource.data.profileId);
}

function validCreatePost() {
  return validCreateGroupPost()
    || validCreateProfilePost();
}

      function canSoftDeletePost() {
        return notAnonymous()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            "isDeleted",
            "deletedAt",
            "deletedBy",
            "updatedAt",
            "isPinnedInGroup",
            "groupPinnedAt",
            "groupPinnedBy",
            "isPinnedOnProfile",
            "profilePinnedAt",
            "profilePinnedBy",
            "search"
          ])
          && request.resource.data.isDeleted == true
          && resource.data.isDeleted == false
          && request.resource.data.deletedBy == request.auth.uid
          && request.resource.data.deletedAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.isPinnedInGroup == false
          && request.resource.data.groupPinnedAt == null
          && request.resource.data.groupPinnedBy == null
          && request.resource.data.isPinnedOnProfile == false
          && request.resource.data.profilePinnedAt == null
          && request.resource.data.profilePinnedBy == null
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.text == resource.data.text
          && (
            !("contextType" in resource.data)
            || request.resource.data.contextType == resource.data.contextType
          )
          && (
            !("groupId" in resource.data)
            || request.resource.data.groupId == resource.data.groupId
          )
          && (
            !("profileId" in resource.data)
            || request.resource.data.profileId == resource.data.profileId
          )
          && (
            !("search" in request.resource.data)
            || (
              request.resource.data.search is map
              && request.resource.data.search.isDeleted == true
            )
          )
          && (
            resource.data.authorId == request.auth.uid
            || (
              isGroupPostData(resource.data)
              && canModerateGroup(resource.data.groupId)
            )
          );
      }

function currentPostCommentCount() {
  return ("counts" in resource.data)
    && resource.data.counts is map
    && ("comments" in resource.data.counts)
    && resource.data.counts.comments is int
      ? resource.data.counts.comments
      : 0;
}

function currentPostLikeCount() {
  return ("counts" in resource.data)
    && resource.data.counts is map
    && ("likes" in resource.data.counts)
    && resource.data.counts.likes is int
      ? resource.data.counts.likes
      : 0;
}

function currentPostSaveCount() {
  return ("counts" in resource.data)
    && resource.data.counts is map
    && ("saves" in resource.data.counts)
    && resource.data.counts.saves is int
      ? resource.data.counts.saves
      : 0;
}

function canUpdateCommentCount(delta) {
  return signedIn()
    && request.resource.data.diff(resource.data).changedKeys().hasOnly([
      "counts",
      "updatedAt"
    ])
    && request.resource.data.authorId == resource.data.authorId
    && (
      !("text" in resource.data)
      || request.resource.data.text == resource.data.text
    )
    && request.resource.data.isDeleted == resource.data.isDeleted
    && request.resource.data.counts is map
    && request.resource.data.counts.comments is int
    && request.resource.data.counts.comments >= 0
    && request.resource.data.counts.comments == currentPostCommentCount() + delta
    && (
      !("likes" in request.resource.data.counts)
      || request.resource.data.counts.likes == currentPostLikeCount()
    )
    && (
      !("saves" in request.resource.data.counts)
      || request.resource.data.counts.saves == currentPostSaveCount()
    );
}

function canListPublicSearchablePost() {
  return resource.data.isDeleted == false

    && (
      (
        isGroupPostData(resource.data)
        && resource.data.groupVisibility == "public"
        && (
          !("isShareable" in resource.data)
          || resource.data.isShareable == true
        )
      )
      ||
      (
        resource.data.contextType == "profile"
        && resource.data.profileRestricted == false
      )
    )

    && (
      !("accessModel" in resource.data)
      || resource.data.accessModel == "free"
    )

    && (
      !("requiresPayment" in resource.data)
      || resource.data.requiresPayment == false
    )

    && (
      !("requiresSubscription" in resource.data)
      || resource.data.requiresSubscription == false
    )

    && (
      !("search" in resource.data)
      || (
        resource.data.search is map
        && (
          !("isDeleted" in resource.data.search)
          || resource.data.search.isDeleted == false
        )
        && (
          !("visibility" in resource.data.search)
          || resource.data.search.visibility == "public"
        )
      )
    );
}

function canListReadableGroupSearchablePost() {
  return signedIn()
    && resource.data.isDeleted == false
    && isGroupPostData(resource.data)
    && canReadGroupContent(resource.data.groupId)
    && resource.data.search is map
    && resource.data.search.isDeleted == false;
}

function canReadPostCommentsData(data) {
  return data.isDeleted == false
    && (
      (
        isGroupPostData(data)
        && (
          canReadGroupContent(data.groupId)
          // Vías "desde fuera" (premium público / live compartible). NUNCA aplican
          // a una comunidad oculta: aunque el post quedara marcado `isShareable`
          // (el autor puede tocar ese campo al editar el live), sus comentarios no
          // deben poder leerse desde fuera de la comunidad.
          || (
            groupPostIsNotHidden(data)
            && (
              (
                data.get('isShareable', false) == true
                && data.premium is map
                && data.premium.get("enabled", false) == true
                && data.premium.get("accessMode", "") == "public"
              )
              || (
                data.get('postType', '') == "live"
                && data.get('isShareable', false) == true
              )
            )
          )
        )
      )
      ||
      (
        isProfilePostData(data)
        && canReadProfileContent(data.profileId)
      )
    );
}

// ⚠️ B8. Esto comprobaba SOLO que el documento existiera, y eso dejaba sin
// efecto el arreglo B6-C03.
//
// Cuando alguien reclama el cargo a su banco, `revokeAccessOnRefund` retira el
// acceso, pero lo hace MARCANDO el documento (`status: "revoked"`,
// `revoked: true`), no borrándolo: el documento hace falta para investigar la
// disputa. Con un `exists()` a secas, el comprador seguía entrando al post de
// pago y a la transmisión después de que le devolvieran el dinero. Se anunció
// como cerrado y no lo estaba.
//
// Es el mismo patrón que ya mordió en el bloque 7 con los miembros sancionados:
// **los documentos se marcan, no se borran, y `exists()` no basta.**
//
// Se mira `revoked` y no `status` a propósito: `postAccess` usa `"active"` y
// `liveAccess` usa `"paid"`, dos vocabularios distintos, mientras que `revoked`
// lo escribe la misma función en los dos. El default es `false` para que un
// documento antiguo sin el campo siga dando acceso.
function accesoNoRevocado(ruta) {
  return exists(ruta) && get(ruta).data.get('revoked', false) != true;
}

function hasPostAccess(postId) {
  return signedIn()
    && accesoNoRevocado(
         /databases/$(database)/documents/postAccess/$(request.auth.uid + '_' + postId)
       );
}

// Ticket de EN VIVO ya pagado por el viewer.
//
// El live y su grabación son EL MISMO post (`liveId == postId`), así que quien
// compró el ticket ya pagó este contenido: cuando el creador convierte la
// transmisión en un VOD premium, no se le vuelve a cobrar por verlo.
// El doc lo crea SOLO el backend al aprobarse el pago (reconcile), nunca el
// cliente, así que su mera existencia ya prueba el cobro.
function hasLiveTicket(postId) {
  return signedIn()
    && accesoNoRevocado(
         /databases/$(database)/documents/liveAccess/$(postId)/users/$(request.auth.uid)
       );
}

// Candado de comunidad OCULTA para las subcolecciones "abiertas" de un post
// (supercomentarios, espectadores del live). Esas colecciones son deliberadamente
// laxas porque un live público debe funcionar sin sesión, pero cuando el post
// vive en una comunidad oculta solo pueden verlas quienes están dentro:
// de lo contrario cualquiera con el postId deduciría el contenido y la
// membresía de una comunidad que no debería ni saber que existe.
function postNotInHiddenGroupOrInsider() {
  let p = get(/databases/$(database)/documents/posts/$(postId)).data;
  let gid = p.get('groupId', null);
  return !(gid is string)
    || groupVisibility(gid) != "hidden"
    || canReadGroupContent(gid);
}

function viewerHasPremiumPostAccess(data, postId) {
  return !("premium" in data)
    || data.premium == null
    || !(data.premium is map)
    || data.premium.get("enabled", false) != true
    || data.authorId == request.auth.uid
    || !(data.groupId is string)
    || isOwner(data.groupId)
    || (
      data.premium.get("freeFor", "") == "members_and_subscribers"
      && isActiveOrSubscribedMember(data.groupId)
    )
    || hasPostAccess(postId)
    // Ticket del live: el VOD es ese mismo post, ya lo pagó.
    || hasLiveTicket(postId);
}

function canWritePostCommentData(data, postId) {
  return signedIn()
    && data.isDeleted == false
    && viewerHasPremiumPostAccess(data, postId)
    && (
      (
        isGroupPostData(data)
        && canWriteGroupComment(data.groupId)
        && !groupMembersHaveBlockBetween(data.groupId, request.auth.uid, data.authorId)
      )
      ||
      (
        isProfilePostData(data)
        && canCommentOnProfilePost(data.profileId)
      )
    );
}

function canModeratePostCommentData(data) {
  return signedIn()
    && (
      (
        isGroupPostData(data)
        && canModerateGroup(data.groupId)
      )
      ||
      (
        isProfilePostData(data)
        && data.authorId == request.auth.uid
      )
    );
}

      // SEGURIDAD LIVE: un live RESTRINGIDO (visibilityMode logged_in_only o members_only
      // → `liveData.allowLoggedOutViewers == false`; el VOD hereda el flag) NUNCA es legible
      // por un INVITADO (sin sesión o sesión anónima). Solo cuentas reales (`notAnonymous`).
      // Se AND-ea sobre todas las rutas de lectura, así ninguna vía "pública" (perfil no
      // restringido, comunidad pública/privada compartible) lo expone. Cubre los 3 estados
      // (programado/en vivo/VOD). Los posts no-live y los lives "everyone" no se restringen.
      // La membresía de `members_only` y el stream se gatean además en el proxy y el visor.
      // ⚠️ El default del `.get()` es FALSE a propósito (antes era `true`, y era la fuga):
      // un post que SÍ es live pero al que no se le escribió `allowLoggedOutViewers`
      // —creado antes de que el campo existiera, o por una ruta que lo omitió— quedaba
      // ABIERTO a invitados. Con `false` el caso dudoso falla CERRADO: se restringe.
      // Un live "everyone" siempre trae el campo en true, así que no se ve afectado.
      function guestAllowedForLive() {
        return !("liveData" in resource.data)
          || !(resource.data.liveData is map)
          || resource.data.liveData.get('allowLoggedOutViewers', false) == true
          || notAnonymous();
      }

      // El alcance "solo miembros" de un live —y de su VOD, que lo HEREDA— manda
      // por encima de la visibilidad de la comunidad. Sin esto, en una comunidad
      // PÚBLICA cualquier logueado podía abrir la grabación de un live que el
      // creador marcó solo para miembros, porque `canReadGroupContent` da true a
      // todo el mundo en una comunidad pública.
      // (En un `list`, lo que la query no fija con `==` se comporta como ausente:
      // `liveData` no fijado → primera cláusula true → no cuesta nada.)
      function liveScopeAllowsViewer() {
        return !("liveData" in resource.data)
          || !(resource.data.liveData is map)
          || resource.data.liveData.get('visibilityMode', 'everyone') != "members_only"
          || (request.auth != null && resource.data.authorId == request.auth.uid)
          || !(resource.data.groupId is string)
          || isMember(resource.data.groupId)
          || isOwner(resource.data.groupId)
          || isModerator(resource.data.groupId)
          || isPlatformMod();
      }

      /**
       * B8-H06 — bloqueo entre miembros de una comunidad, aplicado de verdad.
       *
       * Hasta ahora el bloqueo dentro de una comunidad solo existía en el
       * cliente: la interfaz escondía las publicaciones de quien habías
       * bloqueado, pero pidiéndolas por el SDK llegaban igual. Era una cortina,
       * no una puerta.
       *
       * ⚠️ Esto va SOLO en el `get`, y no es un olvido. Comprobar el bloqueo
       * cuesta dos `exists()` POR DOCUMENTO, y en un `list` el tope de 10
       * accesos es para la consulta ENTERA: con veinte publicaciones se agota y
       * Firestore deniega la consulta COMPLETA, no solo las bloqueadas. O sea
       * que meterlo en el `list` no cerraría el hueco, dejaría el muro en
       * blanco.
       *
       * Decisión de producto de Luis (2026-08-16): cerrar lo que se puede
       * —abrir una publicación suelta, que es como se llega desde un enlace, una
       * notificación o una búsqueda— y dejar el listado filtrado en el cliente,
       * anotado como límite conocido y no como descuido. Cerrarlo también en el
       * listado obligaría a materializar el muro por persona, que es otra
       * arquitectura.
       *
       * Fuera de comunidades el bloqueo sí se aplica entero
       * (`canReadProfileContent` → `usersHaveBlockBetween`), y en el feed de
       * inicio también (`onHomeFeedBlockedUserCreated`).
       */
      function bloqueoDeComunidadEntreLasDosPartes() {
        // ⚠️ `resource.data.get('groupId', null)` y no `resource.data.groupId`.
        //
        // En las reglas, leer un campo que NO EXISTE es un ERROR de evaluación,
        // no un `false`. En un `||` el error se absorbe si otra rama da true
        // —por eso el resto del archivo puede escribirlo suelto— pero esto va en
        // un `&&` al final del `allow get`, donde el error deniega directamente.
        //
        // Sin esto, una publicación de PERFIL (que no lleva `groupId`) dejaba de
        // poder abrirse. Lo detectó `premiumPostVisibility`, no este bloque.
        return request.auth != null
          && resource.data.get('groupId', null) is string
          && resource.data.get('authorId', '') != request.auth.uid
          // ⚠️ `isMember` va DELANTE por coste, no por lógica.
          //
          // Los dos `exists()` del bloqueo hacían pasar del tope de 10 accesos a
          // un NO-MIEMBRO que abre un live retransmitido a una comunidad: la
          // regla no denegaba por bloqueo, reventaba por presupuesto. Lo detectó
          // `premiumPostVisibility`, no este archivo.
          //
          // Aquí sale gratis: `canReadPost` ya leyó el documento de miembro y
          // Firestore cuenta una sola vez los accesos al MISMO documento. Y de
          // paso es correcto, un bloqueo entre miembros solo puede existir entre
          // miembros.
          && isMember(resource.data.get("groupId", ""))
          && groupMembersHaveBlockBetween(
               resource.data.get("groupId", ""),
               request.auth.uid,
               resource.data.get("authorId", "")
             );
      }

      allow get: if (isPlatformMod()
  || canReadPost()
  || canReadPostFromOwnHomeFeed()
  || canReadPostFromOwnSavedPosts())
  && guestAllowedForLive()
  && liveScopeAllowsViewer()
  && (isPlatformMod() || !bloqueoDeComunidadEntreLasDosPartes());

// ORDEN IMPORTANTE. En una consulta (`list`), `resource.data` solo contiene los
// campos que la query fija con `==`; tocar cualquier otro es un ERROR de
// evaluación. En un `||` el error se absorbe si OTRA rama da true, pero si
// ninguna lo hace, la consulta ENTERA se deniega. Además, las ramas con `get()`
// (canReadPost → canReadGroupContent → membresías) son caras y encadenadas
// llegaban al tope de 1000 expresiones, denegando por coste.
// Por eso van PRIMERO las cláusulas baratas que solo miran el documento, y al
// final las que consultan otras colecciones.
allow list: if (canListOwnAuthoredPost()
  || canListPublicDiscoveryPost()
  || canListPublicPremiumGroupPost()
  || canReadPaidShareableGroupPost()
  || canListPublicShareableGroupPost()
  || canListBroadcastPublicLivePost()
  || canListPublicSearchablePost()
  || isPlatformMod()
  || canReadPost()
  || canListReadableGroupSearchablePost()
  || canReadPostFromOwnHomeFeed()
  || canReadPostFromOwnSavedPosts())
  && guestAllowedForLive()
  && liveScopeAllowsViewer();

      // CERRADO. Publicar pasa por el callable `createPost`
      // (`backend/src/createPost.ts`), que escribe con el Admin SDK y por tanto
      // no lo frena esta regla.
      //
      // Por qué se cerró: el límite de publicaciones vivía en una llamada APARTE
      // (`checkRateLimitPost`), así que eran dos pasos independientes y bastaba
      // con no dar el primero: quien escribiera aquí directamente publicaba sin
      // que nadie contara nada. Una regla no puede exigir que ANTES ocurriera
      // otra cosa; en el callable el contador y la escritura son la MISMA
      // transacción. De paso, autor, contexto, visibilidad, `isShareable`,
      // índice de búsqueda y fechas los pone el servidor y ya no se pueden
      // falsear desde el cliente.
      //
      // `validCreatePost()` y sus auxiliares se conservan a propósito: son la
      // especificación legible de lo que un post válido puede contener y siguen
      // documentando el formato aunque ya no se evalúen.
      allow create: if false;

      // ⚠️ B8-C04. `premium` YA NO se puede cambiar aquí.
      //
      // `createPost` garantiza tres cosas sobre el dinero: en una comunidad solo
      // monetiza su creador, el precio va entre 10 y 100000, y los tres campos
      // donde vive el precio (`oneTimePrice`, `premium.price`,
      // `liveData.ticketPrice`) se escriben iguales. Esta regla dejaba deshacer
      // las tres editando después: publicabas gratis en la comunidad de otro y
      // luego te ponías `premium: {enabled: true, price: ...}`. El cobro de
      // Stripe lee `oneTimePrice ?? premium.price` y acredita a `post.authorId`,
      // así que era un cobro real a nombre de quien no tenía permiso de cobrar.
      //
      // Quitarlo no cuesta nada: el cliente ya evitaba escribirlo a propósito
      // (`void params.premium` en `lib/posts/post-service.ts`), porque cambiar
      // `premium` sin poder cambiar `oneTimePrice` dejaba el post enseñando un
      // precio y cobrando otro. La regla se queda alineada con eso.
      // ⚠️ `media` YA NO se puede cambiar desde el cliente.
      //
      // Editar pasa por el callable `updatePost` (`backend/src/updatePost.ts`),
      // que escribe con el Admin SDK y por tanto no lo frena esta regla.
      //
      // Por qué tuvo que irse al servidor: las Firestore Rules **no saben
      // recorrer una lista**. Se puede exigir que `media` sea una lista y acotar
      // su tamaño, pero no mirar dentro de cada elemento, y cada elemento lleva
      // rutas de Storage. Con una ruta ajena metida ahí,
      // `getRestrictedMediaUrls` la firmaba y `postMediaCleanup` la borraba, las
      // dos con privilegios de administrador: lectura y borrado de cualquier
      // archivo del bucket.
      //
      // `text` se queda porque no tiene ese problema, y así una corrección de
      // texto no depende de que el callable esté disponible.
      function canEditPost() {
        return signedIn()
          && resource.data.authorId == request.auth.uid
          && resource.data.get('isDeleted', false) != true
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            "text", "editedAt", "updatedAt"
          ])
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.editedAt is timestamp
          && request.resource.data.updatedAt is timestamp;
      }

      // ── B8-C04: el dinero de un post que ya existe ────────────────────────
      //
      // Un live SÍ se edita de verdad (`updateLivePost` cambia título, alcance,
      // tipo de acceso y precio del ticket), así que aquí no se puede cerrar en
      // seco. Lo que se hace es replicar los candados de `createPost`.

      /** Un precio válido, o ninguno. Los mismos topes que `createPost`. */
      function precioEnRango(valor) {
        return valor == null
          || (valor is number && valor >= 10 && valor <= 100000);
      }

      function mapaDe(data, clave) {
        return data.get(clave, {}) is map ? data.get(clave, {}) : {};
      }

      function precioUnico(data) {
        return data.get('oneTimePrice', null);
      }

      /**
       * El precio vive por triplicado y los cobros leen `oneTimePrice ?? otro`.
       * Si discrepan, la tarjeta enseña uno y Stripe cobra el otro.
       */
      function preciosDelPostCoherentes() {
        return precioEnRango(precioUnico(request.resource.data))
          && precioEnRango(mapaDe(request.resource.data, 'premium').get('price', null))
          && precioEnRango(mapaDe(request.resource.data, 'liveData').get('ticketPrice', null))
          && (
            precioUnico(request.resource.data) == null
            || mapaDe(request.resource.data, 'premium').get('price', null) == null
            || mapaDe(request.resource.data, 'premium').price == precioUnico(request.resource.data)
          )
          && (
            precioUnico(request.resource.data) == null
            || mapaDe(request.resource.data, 'liveData').get('ticketPrice', null) == null
            || mapaDe(request.resource.data, 'liveData').ticketPrice == precioUnico(request.resource.data)
          );
      }

      /** ¿Queda de pago después de esta escritura? */
      function postQuedaDePago() {
        return request.resource.data.get('requiresPayment', false) == true
          || request.resource.data.get('accessModel', '') == 'paid'
          || mapaDe(request.resource.data, 'premium').get('enabled', false) == true;
      }

      /**
       * En una comunidad, cobrar es cosa de su creador —igual que en
       * `createPost`—. En un perfil, cada quien cobra por lo suyo.
       */
      function puedeMonetizarEstePost() {
        return !postQuedaDePago()
          || (
            preciosDelPostCoherentes()
            && (
              !isGroupPostData(resource.data)
              || isOwner(resource.data.groupId)
            )
          );
      }

      function canUnpinGroupPost() {
        return signedIn()
          && resource.data.isDeleted == false
          && isGroupPostData(resource.data)
          && (
            isOwner(resource.data.groupId)
            || resource.data.authorId == request.auth.uid
          )
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            "isPinnedInGroup", "groupPinnedAt", "groupPinnedBy", "updatedAt"
          ])
          && request.resource.data.isPinnedInGroup == false
          && request.resource.data.groupPinnedAt == null
          && request.resource.data.groupPinnedBy == null
          && request.resource.data.updatedAt is timestamp;
      }

      // `liveData.hlsUrl` es el destino de un fetch SERVER-SIDE en cf-viewer-proxy,
      // y el creador escribe el mapa `liveData` completo desde el cliente. Anclar
      // el host aquí evita que un live apunte ese fetch a la red interna (SSRF).
      // El proxy valida por su cuenta; esto es la segunda capa.
      function liveDataHlsUrl(data) {
        return data.get('liveData', {}) is map
          ? data.get('liveData', {}).get('hlsUrl', null)
          : null;
      }

      function liveHlsUrlIsTrustedHost() {
        return liveDataHlsUrl(request.resource.data) == null
          || (liveDataHlsUrl(request.resource.data) is string
              && liveDataHlsUrl(request.resource.data)
                   .matches('https://[a-zA-Z0-9._-]+[.](cloudflarestream[.]com|mux[.]com)(/.*)?'));
      }

      function canEditLivePost() {
        return signedIn()
          && resource.data.authorId == request.auth.uid
          && resource.data.get('isDeleted', false) != true
          && resource.data.postType == "live"
          && liveHlsUrlIsTrustedHost()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            "text", "liveData", "shareTitle", "shareDescription", "shareImageUrl",
            "isShareable", "requiresPayment", "accessModel", "oneTimePrice",
            "currency", "purchaseType", "editedAt", "updatedAt"
          ])
          && request.resource.data.authorId == resource.data.authorId
          && puedeMonetizarEstePost()
          && request.resource.data.editedAt is timestamp
          && request.resource.data.updatedAt is timestamp;
      }

      // ⚠️ Estos dos caminos solo dejan tocar `liveData`, pero el precio del
      // ticket VIVE dentro de `liveData`, y el cobro del live lee
      // `oneTimePrice ?? liveData.ticketPrice`. Sin `preciosDelPostCoherentes()`
      // quedaba una rendija para separar los dos precios por aquí.
      function canUpdateLivePeakViewers() {
        return signedIn()
          && resource.data.authorId == request.auth.uid
          && resource.data.postType == "live"
          && liveHlsUrlIsTrustedHost()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(["liveData", "updatedAt"])
          && request.resource.data.authorId == resource.data.authorId
          && preciosDelPostCoherentes()
          && request.resource.data.updatedAt is timestamp;
      }

      // activeSuper (Reproducir supercomentario) y superCommentConfig — solo el autor del live
      function canUpdateLiveRuntimeData() {
        return signedIn()
          && resource.data.authorId == request.auth.uid
          && resource.data.postType == "live"
          && liveHlsUrlIsTrustedHost()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(["liveData", "updatedAt"])
          && request.resource.data.authorId == resource.data.authorId
          && preciosDelPostCoherentes()
          && request.resource.data.updatedAt is timestamp;
      }

      // Confirmar configuración de VOD tras fin de live (puede convertir a post premium y desfijar)
      function canFinalizeLivePost() {
        return signedIn()
          && resource.data.authorId == request.auth.uid
          && resource.data.postType == "live"
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            "liveData", "updatedAt",
            "isPinnedInGroup", "groupPinnedAt", "groupPinnedBy",
            "isPinnedOnProfile", "profilePinnedAt", "profilePinnedBy",
            "premium", "text",
            // `isShareable`: al ponerle precio al VOD, su alcance se alinea con el
            // del live (público → compartible; solo-miembros/oculta → no). El autor
            // ya podía cambiarlo vía canEditLivePost, así que no da poder nuevo, y
            // las comunidades ocultas siguen bloqueadas por las reglas de lectura.
            "isShareable",
            "access", "accessModel", "requiresPayment", "oneTimePrice", "currency", "purchaseType"
          ])
          && request.resource.data.authorId == resource.data.authorId
          && puedeMonetizarEstePost()
          && request.resource.data.updatedAt is timestamp;
      }

      // ⚠️ `canUpdateCommentCount` ya NO está aquí. Permitía que cualquiera
      // con sesión sumara o restara el contador de comentarios de cualquier post
      // conocido, sin escribir un solo comentario, porque el cliente lo subía en
      // una escritura aparte y las reglas no podían atarla a nada. Ahora lo lleva
      // el trigger `onPostCommentCreated` con Admin SDK.
      allow update: if canSoftDeletePost()
        || canEditPost()
        || canEditLivePost()
        || canUnpinGroupPost()
        || canUpdateLivePeakViewers()
        || canUpdateLiveRuntimeData()
        || canFinalizeLivePost();

      allow delete: if false;

      // Supercomentarios del live
      match /superComments/{superCommentId} {
        // Lectura abierta (un live público debe funcionar sin sesión), SALVO en
        // comunidades ocultas: ahí solo quien está dentro.
        allow list, get: if postNotInHiddenGroupOrInsider();

        // Los supercomentarios y donaciones en vivo se materializan SOLO en el backend
        // (reconcile) tras un pago APROBADO de Stripe. El cliente NO puede crearlos: si
        // pudiera, escribiría un doc status:"paid" con cualquier monto y el trigger
        // `onSuperCommentLedger` acreditaría al creador SIN que se cobre. El pago de
        // invitados se integrará por su propia vía de cobro (server-authoritative).
        allow create: if false;

        // Creador puede ocultar, borrar, marcar como reproducido o registrar playedAt
        allow update: if signedIn()
          && get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(["hidden", "isDeleted", "played", "playedAt"]);

        allow delete: if false;
      }

      // Registro histórico de espectadores únicos — solo se crea, nunca se borra
      match /liveUniqueViewers/{viewerId} {
        allow get, list: if signedIn() && postNotInHiddenGroupOrInsider();
        // M01 — claves de `registerUniqueViewer` y `addWatchTime`
        // (lib/liveKit/liveViewers.ts). `watchSeconds` se acumula con increment.
        allow create, update: if signedIn()
          && request.auth.uid == viewerId
          && request.resource.data.keys().hasOnly(["uid", "isGuest", "watchSeconds"])
          && request.resource.data.uid == viewerId;
        allow delete: if false;
      }

      // Presencia de espectadores en vivo — cada usuario escribe/borra su propio doc.
      // `viewerId` puede ser el uid de una cuenta real o el de una identidad ANÓNIMA
      // de invitado (espectador sin login): ambos son `signedIn()` y ambos deben contar
      // en las estadísticas del live.
      match /liveViewers/{viewerId} {
        allow get, list: if signedIn() && postNotInHiddenGroupOrInsider();
        // M01 — claves de `joinLivePresence` más el parche de latencia de
        // `updateViewerLatency`, que llega por `update` sobre el mismo documento.
        allow create: if signedIn()
          && request.auth.uid == viewerId
          && request.resource.data.keys().hasOnly([
            "uid", "isGuest", "joinedAt", "latency", "latencyUpdatedAt"
          ])
          && request.resource.data.uid == viewerId
          && request.resource.data.joinedAt is timestamp;
        allow delete: if signedIn() && request.auth.uid == viewerId;
        allow update: if signedIn()
          && request.auth.uid == viewerId
          && request.resource.data.uid == viewerId
          && (
            // Parche de latencia del propio espectador
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['latency', 'latencyUpdatedAt'])
            // Re-entrada: si quedó un doc de presencia rancio (pestaña cerrada de golpe,
            // crash), volver a entrar es un `set` sobre un doc existente = update. Sin
            // esto se denegaba y el espectador dejaba de refrescar su presencia.
            || request.resource.data.joinedAt is timestamp
          );
      }

      // Registro de vistas VOD (≥20% reproducido) — cada viewer escribe su propio doc; solo el autor lista
      match /vodViewers/{viewerId} {
        allow get, list: if signedIn()
          && get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid;
        // M01 — `recordVodView` escribe un único campo.
        allow create, update: if signedIn()
          && request.auth.uid == viewerId
          && request.resource.data.keys().hasOnly(["viewedAt"])
          && request.resource.data.viewedAt is timestamp;
        allow delete: if false;
      }

      // Credenciales privadas del live stream (streamKey) — solo el autor puede leer
      match /liveStream/{doc} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid;
        allow write: if false;
      }

      // Coordenadas reproducibles (playbackId / URL HLS) de un post DE PAGO.
      // Viven aquí y NO en el doc del post porque ese doc lo puede leer quien
      // todavía no ha pagado (premium público dentro de comunidad privada). Con
      // los assets de Mux en política "public", tener el playbackId equivale a
      // tener el video, así que este subdocumento ES el candado real.
      // Lo escribe SOLO el backend (trigger onPostPlaybackProtection).
      match /protectedPlayback/{doc} {

        function playbackParentPost() {
          return get(/databases/$(database)/documents/posts/$(postId));
        }

        // Compra única confirmada (postAccess lo concede el webhook de pago).
        function viewerBoughtPost() {
          return exists(
            /databases/$(database)/documents/postAccess/$(request.auth.uid + '_' + postId)
          )
          && get(
            /databases/$(database)/documents/postAccess/$(request.auth.uid + '_' + postId)
          ).data.status == "active";
        }

        // Premium con "los miembros lo ven gratis" → basta la membresía.
        function postFreeForMembers(postData) {
          return "premium" in postData
            && postData.premium is map
            && postData.premium.freeFor == "members_and_subscribers"
            && postData.groupId is string
            && isMember(postData.groupId);
        }

        allow get, list: if signedIn()
          && (
            playbackParentPost().data.authorId == request.auth.uid
            || isPlatformMod()
            || viewerBoughtPost()
            // Compró el ticket del live: la grabación es ese mismo post.
            || hasLiveTicket(postId)
            || postFreeForMembers(playbackParentPost().data)
            || (
              playbackParentPost().data.groupId is string
              && canModerateGroup(playbackParentPost().data.groupId)
            )
          );

        allow create, update, delete: if false;
      }

      // Estadísticas históricas del live (ej. historial de espectadores) — solo el
      // autor las lee/escribe (la gráfica es exclusiva del panel del creador).
      match /liveStats/{doc} {
        allow read, write: if signedIn()
          && get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid;
      }

      match /editHistory/{historyId} {
        // M01 — el historial de un POST guarda además los medios anteriores.
        allow create: if notAnonymous()
          && get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            "editedAt", "editedBy", "previousText", "previousMedia"
          ])
          && request.resource.data.editedBy == request.auth.uid
          && request.resource.data.editedAt is timestamp;
        allow read: if signedIn()
          && get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid;
        allow update, delete: if false;
      }

      match /comments/{commentId} {

        function parentPost() {
          return get(/databases/$(database)/documents/posts/$(postId));
        }

        function canReadComment() {
          return canReadPostCommentsData(parentPost().data);
        }

        // Imagen adjunta (una sola) de comentarios/respuestas. Si el campo
        // `image` está presente debe ser un map con url y thumbnailUrl no vacíos.
        // El archivo ya fue validado (tamaño/tipo/autor) por las Storage Rules.
        function commentImagePresent() {
          return ("image" in request.resource.data)
            && request.resource.data.image is map;
        }

        // ⚠️ Antes solo se exigía que `url` y `thumbnailUrl` fueran cadenas no
        // vacías. Cualquier dirección externa valía, así que un comentario podía
        // cargar una imagen de un servidor ajeno — que ve la IP de todo el que
        // abra el hilo— o apuntar a la ruta de otra persona. Ahora tienen que
        // ser de NUESTRO Storage, en la carpeta de ESTE post y de QUIEN comenta,
        // y el mapa no admite campos de más.
        // La URL va VACÍA en comunidades restringidas —ahí solo se guardan
        // rutas y la URL la firma el backend—, así que vacía es válida. Lo que
        // no vale es una dirección que no sea de nuestro Storage.
        function commentImageUrlOk(value) {
          return value is string
            && (
              value.size() == 0
              || value.matches(
                   '^https://firebasestorage\\.googleapis\\.com/v0/b/[^/]+/o/commentImages%2F'
                   + postId + '%2F' + request.auth.uid + '%2F.*'
                 )
            );
        }

        // La ruta sí tiene que apuntar siempre a la carpeta de ESTE post y de
        // QUIEN comenta.
        function commentImagePathOk(field) {
          return !(field in request.resource.data.image)
            || (
              request.resource.data.image[field] is string
              && request.resource.data.image[field].matches(
                   '^commentImages/' + postId + '/' + request.auth.uid + '/.*'
                 )
            );
        }

        function commentImageValidIfPresent() {
          return !("image" in request.resource.data)
            || (
              request.resource.data.image is map
              && request.resource.data.image.keys().hasOnly([
                   'url', 'thumbnailUrl', 'path', 'thumbnailPath', 'width', 'height'
                 ])
              && commentImageUrlOk(request.resource.data.image.get('url', ''))
              && commentImageUrlOk(request.resource.data.image.get('thumbnailUrl', ''))
              && commentImagePathOk('path')
              && commentImagePathOk('thumbnailPath')
            );
        }

        // ── B8-medio y B8-H04 ──────────────────────────────────────────────
        //
        // Esto NO era un esquema cerrado: bastaba con acertar `authorId` y el
        // texto para colar cualquier otro campo. Se podían inventar contadores,
        // fechas y estructuras de menciones malformadas que luego consume el
        // disparador de notificaciones.
        //
        // Las claves salen del `addDoc` de `lib/posts/post-service.comments.ts`.
        //
        // ⚠️ `authorIsGroupMember` se deja pasar como bool SIN atarlo a la
        // membresía real, a propósito: solo pinta la etiqueta de "no es
        // miembro". Falsearlo la esconde, no abre ningún acceso, y comprobarlo
        // costaría un `get()` más en cada comentario.
        function canCreateComment() {
          return notAnonymous()
            && request.resource.data.keys().hasOnly([
              "authorId", "authorName", "authorAvatarUrl", "authorUsername",
              "text", "createdAt", "updatedAt", "counts",
              "mentions", "image", "authorIsGroupMember"
            ])
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 2000
            && (request.resource.data.text.size() >= 1 || commentImagePresent())
            && commentImageValidIfPresent()
            && commentAuthorFieldsValid()
            && commentCountsStartAtZero()
            && commentMentionsWithinLimit()
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time
            && comentarioCuentaEnElMismoLote()
            && canWritePostCommentData(parentPost().data, postId);
        }

        /**
         * B8-H03. El freno vive en el MISMO lote atómico que el comentario.
         *
         * `getAfter` mira cómo queda el contador DESPUÉS de esta escritura. Si
         * el lote no incluye el contador, `lastAt` no será `request.time` y esto
         * falla; y si lo incluye, ese documento tiene que pasar por las reglas de
         * `/rateLimits`, que son las que exigen los 3 segundos y el tope por
         * hora.
         *
         * Así se resuelve lo que una regla no puede hacer por sí sola —exigir
         * que ANTES ocurriera otra cosa— sin sacar la autorización de aquí.
         */
        function comentarioCuentaEnElMismoLote() {
          return getAfter(
            /databases/$(database)/documents/rateLimits/$(request.auth.uid + '_comment')
          ).data.lastAt == request.time;
        }

        /** Los datos denormalizados del autor, acotados. */
        function commentAuthorFieldsValid() {
          return (
            !("authorName" in request.resource.data)
            || request.resource.data.authorName == null
            || (request.resource.data.authorName is string
                && request.resource.data.authorName.size() <= 120)
          )
            && (
              !("authorUsername" in request.resource.data)
              || request.resource.data.authorUsername == null
              || (request.resource.data.authorUsername is string
                  && request.resource.data.authorUsername.size() <= 60)
            )
            && (
              !("authorAvatarUrl" in request.resource.data)
              || request.resource.data.authorAvatarUrl == null
              || (request.resource.data.authorAvatarUrl is string
                  && request.resource.data.authorAvatarUrl.size() <= 1000)
            )
            && (
              !("authorIsGroupMember" in request.resource.data)
              || request.resource.data.authorIsGroupMember is bool
            );
        }

        /** Un comentario nace en cero. Los contadores los lleva el backend. */
        function commentCountsStartAtZero() {
          return !("counts" in request.resource.data)
            || (
              request.resource.data.counts is map
              && request.resource.data.counts.keys().hasOnly(["replies", "likes"])
              && request.resource.data.counts.get('replies', 0) == 0
              && request.resource.data.counts.get('likes', 0) == 0
            );
        }

        /**
         * B8-H04. Cada mención de perfil dispara una notificación y el
         * disparador las recorría todas con un `await` dentro del bucle: un solo
         * comentario podía lanzar miles.
         *
         * Tope de 5, decisión de Luis (2026-08-16). El mismo número está en
         * `backend/src/notifications.ts` y en `sanitizeCommentMentions`; si
         * cambia, cambia en los tres.
         */
        function commentMentionsWithinLimit() {
          return !("mentions" in request.resource.data)
            || (
              request.resource.data.mentions is list
              && request.resource.data.mentions.size() <= 5
            );
        }

        function canDeleteComment() {
          return signedIn()
            && (
              resource.data.authorId == request.auth.uid
              || canModeratePostCommentData(parentPost().data)
            );
        }

        function canEditComment() {
          return signedIn()
            && resource.data.authorId == request.auth.uid
            && resource.data.get('isDeleted', false) != true
            && request.resource.data.diff(resource.data).changedKeys().hasOnly(["text", "mentions", "editedAt", "updatedAt"])
            && request.resource.data.authorId == resource.data.authorId
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1
            && request.resource.data.text.size() <= 2000
            && request.resource.data.editedAt is timestamp
            && request.resource.data.updatedAt is timestamp;
        }

        function currentReplyCount() {
  return ("counts" in resource.data)
    && resource.data.counts is map
    && ("replies" in resource.data.counts)
    && resource.data.counts.replies is int
      ? resource.data.counts.replies
      : 0;
}

function currentCommentLikeCount() {
  return ("counts" in resource.data)
    && resource.data.counts is map
    && ("likes" in resource.data.counts)
    && resource.data.counts.likes is int
      ? resource.data.counts.likes
      : 0;
}

function canUpdateReplyCount(delta) {
  return signedIn()
    && request.resource.data.diff(resource.data).changedKeys().hasOnly([
      "counts",
      "updatedAt"
    ])
    && request.resource.data.authorId == resource.data.authorId
    && request.resource.data.text == resource.data.text
    && request.resource.data.counts is map
    && request.resource.data.counts.replies is int
    && request.resource.data.counts.replies >= 0
    && request.resource.data.counts.replies == currentReplyCount() + delta
    && (
      !("likes" in request.resource.data.counts)
      || request.resource.data.counts.likes == currentCommentLikeCount()
    );
}

        function canSoftDeleteComment() {
          return signedIn()
            && request.resource.data.diff(resource.data).changedKeys().hasOnly(["isDeleted", "deletedAt", "updatedAt"])
            && request.resource.data.isDeleted == true
            && resource.data.get('isDeleted', false) != true
            && (
              resource.data.authorId == request.auth.uid
              || canModeratePostCommentData(parentPost().data)
            );
        }

        // El supermoderador revisa comentarios denunciados desde el panel.
      allow get, list: if canReadComment() || isPlatformMod();

        allow create: if canCreateComment();

        // Mismo caso que el contador de comentarios: lo lleva el trigger
        // `onCommentReplyCreated`, no el cliente.
        allow update: if canEditComment()
          || canSoftDeleteComment();

        allow delete: if canDeleteComment();

        match /editHistory/{historyId} {
          allow create: if notAnonymous()
            && get(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId)).data.authorId == request.auth.uid
            // M01 — un comentario no lleva medios, así que su historial tampoco.
            && request.resource.data.keys().hasOnly(["editedAt", "editedBy", "previousText"])
            && request.resource.data.editedBy == request.auth.uid
            && request.resource.data.editedAt is timestamp;
          allow read: if get(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId)).data.authorId == request.auth.uid;
          allow update, delete: if false;
        }

        match /replies/{replyId} {

          function canReadReply() {
            return canReadComment();
          }

          // Mismo cierre que `canCreateComment`. Las claves salen del
          // `transaction.set(replyRef, ...)` de `post-service.comments.ts`, que
          // añade `postId` y `commentId` y no lleva `counts` (una respuesta no
          // tiene respuestas).
          function canCreateReply() {
            return notAnonymous()
              && request.resource.data.keys().hasOnly([
                "postId", "commentId",
                "authorId", "authorName", "authorAvatarUrl", "authorUsername",
                "text", "createdAt", "updatedAt",
                "mentions", "image", "authorIsGroupMember"
              ])
              && request.resource.data.authorId == request.auth.uid
              && request.resource.data.get('postId', postId) == postId
              && request.resource.data.get('commentId', commentId) == commentId
              && request.resource.data.text is string
              && request.resource.data.text.size() <= 2000
              && (request.resource.data.text.size() >= 1 || commentImagePresent())
              && commentImageValidIfPresent()
              && commentAuthorFieldsValid()
              && commentMentionsWithinLimit()
              && request.resource.data.createdAt == request.time
              && request.resource.data.updatedAt == request.time
              // Una respuesta gasta el mismo freno que un comentario: si no, el
              // spam se muda a las respuestas y no hemos cerrado nada.
              && comentarioCuentaEnElMismoLote()
              && canWritePostCommentData(parentPost().data, postId);
          }

          function canDeleteReply() {
            return signedIn()
              && (
                resource.data.authorId == request.auth.uid
                || canModeratePostCommentData(parentPost().data)
              );
          }

          function canEditReply() {
            return signedIn()
              && resource.data.authorId == request.auth.uid
              && request.resource.data.diff(resource.data).changedKeys().hasOnly(["text", "mentions", "editedAt", "updatedAt"])
              && request.resource.data.authorId == resource.data.authorId
              && request.resource.data.text is string
              && request.resource.data.text.size() >= 1
              && request.resource.data.text.size() <= 2000
              && request.resource.data.editedAt is timestamp
              && request.resource.data.updatedAt is timestamp;
          }

          function canSoftDeleteReply() {
            return signedIn()
              && request.resource.data.diff(resource.data).changedKeys().hasOnly(["isDeleted", "deletedAt", "updatedAt"])
              && request.resource.data.isDeleted == true
              && resource.data.get('isDeleted', false) != true
              && (
                resource.data.authorId == request.auth.uid
                || canModeratePostCommentData(parentPost().data)
              );
          }

          // El supermoderador revisa respuestas denunciadas desde el panel.
        allow get, list: if canReadReply() || isPlatformMod();

          allow create: if canCreateReply();

          allow update: if canEditReply()
            || canSoftDeleteReply();

          allow delete: if canDeleteReply();

          match /editHistory/{historyId} {
            allow create: if notAnonymous()
              && get(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId)/replies/$(replyId)).data.authorId == request.auth.uid
              // M01 — misma forma que el historial de un comentario.
              && request.resource.data.keys().hasOnly(["editedAt", "editedBy", "previousText"])
              && request.resource.data.editedBy == request.auth.uid
              && request.resource.data.editedAt is timestamp;
            allow read: if get(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId)/replies/$(replyId)).data.authorId == request.auth.uid;
            allow update, delete: if false;
          }
        }
      }

      match /reactions/{userId} {
        function parentPost() {
          return get(/databases/$(database)/documents/posts/$(postId));
        }

        function canReadReactionsList() {
          return signedIn()
            && parentPost().data.isDeleted == false
            && (
              parentPost().data.authorId == request.auth.uid
              || (isGroupPostData(parentPost().data) && canReadGroupContent(parentPost().data.groupId))
              || (isProfilePostData(parentPost().data) && canReadProfileContent(parentPost().data.profileId))
              || (
                parentPost().data.get('postType', '') == "live"
                && parentPost().data.get('isShareable', false) == true
                // Un live de comunidad oculta no expone su lista de reacciones
                // (revelaría quién está dentro de la comunidad).
                && groupPostIsNotHidden(parentPost().data)
              )
            );
        }

        function canReadOwnReaction() {
          return signedIn()
            && request.auth.uid == userId
            && resource.data.userId == request.auth.uid
            && canReadReactionsList();
        }

        allow get: if canReadOwnReaction() || canReadReactionsList();

        allow list: if canReadReactionsList();

        allow create, update, delete: if false;
      }

      // Vistas únicas por usuario (videos/VODs). Cada usuario escribe su propia
      // vista; el contador `viewsCount` lo incrementa la Cloud Function
      // onPostViewed (el cliente no puede tocar viewsCount del post).
      match /views/{userId} {
        // M01 — `registerPostView` escribe un único campo.
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(["viewedAt"]);
        allow get: if signedIn() && request.auth.uid == userId;
        allow list, delete: if false;
      }
    }

    match /postAccess/{accessId} {
      // El comprador puede leer su propio acceso
      allow get: if signedIn()
        && resource.data.buyerId == request.auth.uid;
      // El creador lista todos los accesos (ingresos VOD); el comprador lista los
      // suyos (para reflejar el desbloqueo en cualquier dispositivo).
      allow list: if signedIn()
        && (resource.data.creatorId == request.auth.uid
          || resource.data.buyerId == request.auth.uid);

      // El acceso lo concede SOLO el backend tras un pago aprobado (payPremiumPost
      // → reconcile). El cliente ya no puede auto-otorgarse acceso.
      allow create, update, delete: if false;
    }

    // ==========================
    // DONACIONES EN PERFIL (pago simulado)
    // ==========================
    match /profileDonations/{donationId} {
      // El creador y el comprador pueden leer; el creador lista para ingresos.
      allow get: if signedIn()
        && (resource.data.creatorId == request.auth.uid
          || resource.data.buyerId == request.auth.uid);
      allow list: if signedIn()
        && resource.data.creatorId == request.auth.uid;

      // La donación la crea SOLO el backend tras un pago aprobado (payProfileDonation
      // → reconcile). El cliente ya no puede crear donaciones simuladas.
      allow create, update, delete: if false;
    }

    // ==========================
    // LIVE CHAT
    // ==========================
    match /liveChats/{liveId}/messages/{messageId} {

      function livePostDoc() {
        return get(/databases/$(database)/documents/posts/$(liveId));
      }

      function liveChatEnabled() {
        return !("liveData" in livePostDoc().data)
          || livePostDoc().data.liveData == null
          || !("chatEnabled" in livePostDoc().data.liveData)
          || livePostDoc().data.liveData.chatEnabled != false;
      }

      function userNotMuted() {
        return !("liveData" in livePostDoc().data)
          || livePostDoc().data.liveData == null
          || !("mutedUsers" in livePostDoc().data.liveData)
          || livePostDoc().data.liveData.mutedUsers == null
          || !(request.auth.uid in livePostDoc().data.liveData.mutedUsers);
      }

      function userNotBanned() {
        return !("liveData" in livePostDoc().data)
          || livePostDoc().data.liveData == null
          || !("bannedUsers" in livePostDoc().data.liveData)
          || livePostDoc().data.liveData.bannedUsers == null
          || !(request.auth.uid in livePostDoc().data.liveData.bannedUsers);
      }

      function isLivePostAuthor() {
        return signedIn()
          && livePostDoc().data.authorId == request.auth.uid;
      }

      // Chat de live de COMUNIDAD: solo miembros activos/suscritos pueden escribir
      // (excluye no-miembros, muteados, baneados y removidos; effectiveMemberStatus
      // ya incorpora la expiración del muteo). Los lives de perfil (sin groupId)
      // siguen abiertos a cualquiera. Los supercomentarios/donaciones NO pasan por
      // esta regla (se materializan en backend) y quedan abiertos a cualquiera.
      function canWriteGroupLiveChat() {
        let gid = ("groupId" in livePostDoc().data) ? livePostDoc().data.groupId : null;
        return gid == null || isActiveOrSubscribedMember(gid);
      }

      function canDeleteLiveChatMsg() {
        return signedIn()
          && (
            resource.data.userId == request.auth.uid
            || isLivePostAuthor()
            || (
              livePostDoc().data.groupId is string
              && canModerateGroup(livePostDoc().data.groupId)
            )
          );
      }

      // El chat de un live PÚBLICO se lee sin sesión (espectadores deslogueados).
      // El de un live en comunidad OCULTA, no: sus mensajes llevan nombre y texto
      // de los miembros, y con solo el liveId cualquiera podía leerlos enteros.
      function liveChatIsReadable() {
        let gid = livePostDoc().data.get('groupId', null);
        return !(gid is string)
          || groupVisibility(gid) != "hidden"
          || canReadGroupContent(gid);
      }

      // El supermoderador revisa mensajes de chat de live denunciados.
      allow get, list: if liveChatIsReadable() || isPlatformMod();

      allow create: if notAnonymous()
        && liveChatEnabled()
        && userNotMuted()
        && userNotBanned()
        && canWriteGroupLiveChat()
        // M01 — claves de `sendLiveChatMessage` en lib/liveChat/live-chat-service.ts.
        // Los campos de borrado quedan fuera: los pone el `update` de abajo, que
        // ya los acota, y un mensaje no nace borrado.
        && request.resource.data.keys().hasOnly([
          "liveId", "userId", "username", "avatarUrl", "text",
          "createdAt", "type", "isDeleted", "futureFlags"
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.liveId == liveId
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.type == "message"
        && request.resource.data.isDeleted == false
        && request.resource.data.createdAt is timestamp;

      allow update: if notAnonymous()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "isDeleted", "deletedAt", "deletedBy"
        ])
        && request.resource.data.isDeleted == true
        && resource.data.isDeleted == false
        && canDeleteLiveChatMsg();

      allow delete: if false;
    }

    // ==========================
    // LIVE CREATOR STATS (récords)
    // ==========================
    match /liveCreatorStats/{authorId} {
      allow read, write: if signedIn() && request.auth.uid == authorId;
    }

    // ==========================
    // LIVE ACCESS (tickets)
    // ==========================
    match /liveAccess/{liveId}/users/{userId} {
      // El propio usuario puede leer su acceso
      allow get: if signedIn() && request.auth.uid == userId;
      // El autor del live puede listar todos los accesos para ver ingresos por tickets
      allow list: if signedIn()
        && get(/databases/$(database)/documents/posts/$(liveId)).data.authorId == request.auth.uid;

      // El ticket lo crea SOLO el backend tras un pago aprobado (createLiveAccess
      // StripeIntent → webhook → reconcile, con Admin SDK). El cliente NO puede
      // crearlo: este doc es el que dispara `onLiveAccessLedger`, así que permitirlo
      // era acceso gratis + una ganancia fantasma en la wallet del creador.
      // (Antes se aceptaba `paymentMode == "simulated"` escrito desde el cliente.)
      allow create, update, delete: if false;
    }

    // ==========================
    // MODERACIÓN — REPORTES
    // ==========================
    match /reports/{reportId} {
      // ⚠️ Esta regla permitía al CLIENTE crear reportes directamente, y eso
      // abría un boquete mayor que el de los campos de más: en el Bloque 3 se
      // hizo que el servidor resolviera de quién es el contenido reportado,
      // porque el moderador usa ese dato al bloquear una cuenta. Escribiendo el
      // reporte directo en Firestore se saltaba esa resolución entera y se podía
      // volver a señalar a un inocente.
      //
      // Todo el producto reporta por la callable `submitReport` (ReportModal y
      // el chat), así que cerrar esto no quita nada: solo obliga a pasar por
      // donde se comprueba.
      allow create: if false;

      // Solo moderadores de plataforma pueden leer y actualizar reportes
      allow read, update: if isPlatformMod();

      // Nunca se eliminan reportes (solo se resuelven)
      allow delete: if false;
    }

    // ==========================
    // DEVOLUCIONES EN EFECTIVO (B7)
    // ==========================
    // El comprador solicita efectivo de su saldo a favor (callable requestCashout) y un
    // superadmin lo resuelve (callable resolveCashout). Solo el backend (Admin SDK) escribe.
    // El dueño lee las suyas; los moderadores leen todas (panel "Devoluciones").
    match /cashoutRequests/{cashoutId} {
      allow read: if signedIn()
        && (isPlatformMod() || resource.data.buyerId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // ==========================
    // MODERACIÓN — AUDIT LOG
    // ==========================
    // Historial de la moderación de COMUNIDADES (silenciar, banear, expulsar,
    // promover, degradar). Antes la huella vivía en el propio documento de
    // miembro y la siguiente acción la sobrescribía, así que no había forma de
    // investigar a un moderador de comunidad. Aquí cada acción es una línea
    // nueva que nadie puede editar.
    //
    // Lo lee el dueño de la comunidad —es su comunidad y su dinero, porque
    // banear cancela suscripciones— y el supermoderador de plataforma.
    match /groupModerationLog/{entryId} {
      allow get, list: if isPlatformMod()
        || (signedIn() && isOwner(resource.data.groupId));
      allow write: if false;
    }

    match /adminAuditLog/{actionId} {
      // Solo moderadores de plataforma pueden leer el historial
      allow read: if isPlatformMod();
      // Solo se escribe desde Cloud Functions con Admin SDK
      allow write: if false;
    }

    // ==========================
    // PERFILES DE ADMINISTRADOR
    // ==========================
    match /adminProfiles/{uid} {
      allow read: if isPlatformMod();
      allow write: if isPlatformMod() && request.auth.uid == uid;
    }

    // ==========================
    // CUENTAS CONECTADAS DE STRIPE (retiros del creador)
    // ==========================
    // Estado del alta de la cuenta conectada. Lo escribe SOLO el backend, desde el
    // webhook `account.updated` de Connect. El creador únicamente lee la suya.
    //
    // Aquí NO hay PII: los datos de identidad los custodia Stripe. Solo se guardan
    // banderas (payoutsEnabled), requisitos pendientes y el id de la cuenta.
    //
    // 🚨 Que el cliente NO pueda escribir es lo que impide que alguien se marque a sí
    //    mismo como verificado para desbloquear el retiro.
    match /stripeAccounts/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // ==========================
    // KYC (verificación de identidad)
    // ==========================
    // El estado de KYC lo escribe SOLO el backend. El usuario únicamente puede leer su
    // propio documento. Aquí NO hay PII: los documentos de identidad los custodia el
    // proveedor de verificación, nunca Firestore.
    //
    // ⚠️ Didit se eliminó el 2026-08-13 y hoy NADIE escribe esta colección. La regla se
    //    conserva a propósito: los documentos históricos siguen ahí y deben permanecer
    //    legibles solo por su dueño e inescribibles desde el cliente. Cuando el alta de
    //    cuenta Stripe traiga su propio KYC, volverá a escribirse desde el backend.
    match /kyc/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // ==========================
    // MENSAJES DIRECTOS (DM) — Bloque 1
    // ==========================
    // Perfil ↔ perfil, solo texto. Las comunidades NO tienen mensajería.
    //
    // TODO el control de acceso vive en el `create` de la conversación, que lee 4
    // documentos (perfil del destinatario, follow y los dos docs de bloqueo).
    // Una vez abierta, escribir un mensaje NO vuelve a mirar el perfil del otro:
    // el gate se paga una vez, no por mensaje.
    //
    // El `list` del inbox no hace ni un get()/exists(): el evaluador de `allow
    // list` tiene un tope de 10 lecturas por query y cualquier inbox normal lo
    // reventaría — es exactamente lo que dejó el feed de guardados vacío.
    match /conversations/{convId} {

      function isParticipant() {
        return signedIn() && request.auth.uid in resource.data.participants;
      }

      function newParticipants() {
        return request.resource.data.participants;
      }

      function otherUid() {
        return newParticipants()[0] == request.auth.uid
          ? newParticipants()[1]
          : newParticipants()[0];
      }

      // Ausente ⇒ "following", el predeterminado de la plataforma (ver
      // lib/chat/types.ts). Deliberadamente conservador: quien nunca entró a
      // configurarlo no queda con la bandeja abierta de par en par.
      function recipientPolicy() {
        let u = get(/databases/$(database)/documents/users/$(otherUid())).data;
        return ("messagePolicy" in u) && u.messagePolicy is string
          ? u.messagePolicy
          : "following";
      }

      // ¿El destinatario me sigue? Decide dos cosas: si la política me deja
      // pasar, y si el hilo entra directo o cae en Solicitudes.
      function recipientFollowsMe() {
        return exists(/databases/$(database)/documents/users/$(otherUid())/following/$(request.auth.uid));
      }

      /** ¿Yo sigo al destinatario? Solo lo mira "following_and_followers". */
      function iFollowRecipient() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid)/following/$(otherUid()));
      }

      function policyAllowsMe() {
        let p = recipientPolicy();
        return p == "everyone"
          || (p == "following" && recipientFollowsMe())
          || (p == "following_and_followers" && (recipientFollowsMe() || iFollowRecipient()));
      }

      // El cliente NO elige el estado inicial.
      //
      // Solicitudes existe SOLO para la política "everyone": es la única que deja
      // escribir a un desconocido, así que es la única que necesita triaje. En
      // "following" y "following_and_followers" el destinatario ya filtró por
      // relación — quien no cumple ni siquiera ve el botón —, así que lo que pasa
      // el filtro entra directo a la bandeja principal.
      function requiredNewStatus() {
        return (recipientPolicy() == "everyone" && !recipientFollowsMe())
          ? "request"
          : "active";
      }

      // participantsKey ordenado alfabéticamente y usado como ID del documento:
      // hace imposible que existan dos hilos para el mismo par de personas.
      function validNewConversation() {
        return newParticipants() is list
          && newParticipants().size() == 2
          && request.auth.uid in newParticipants()
          && newParticipants()[0] != newParticipants()[1]
          && newParticipants()[0] < newParticipants()[1]
          && request.resource.data.participantsKey == newParticipants()[0] + "_" + newParticipants()[1]
          && convId == request.resource.data.participantsKey
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.lastMessage == null
          && request.resource.data.lastMessageAt == null
          && request.resource.data.blockedBy == null
          && request.resource.data.unread is map
          && request.resource.data.lastReadAt is map
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          // Un hilo NUNCA nace vacío: se crea en el mismo lote que su primer
          // mensaje. Es lo que permite limitar una solicitud a un solo mensaje
          // (ver `allowedInPendingRequest`), porque las rules no saben contar
          // documentos pero sí comprobar que existe justo ese.
          && request.resource.data.firstMessageId is string
          && request.resource.data.firstMessageId.size() > 0
          && existsAfter(/databases/$(database)/documents/conversations/$(convId)/messages/$(request.resource.data.firstMessageId))
          && request.resource.data.keys().hasOnly([
               'participants', 'participantsKey', 'status', 'createdBy',
               'lastMessage', 'lastMessageAt', 'blockedBy', 'unread',
               'lastReadAt', 'firstMessageId', 'createdAt', 'updatedAt'
             ]);
      }

      // Bloquear: cualquiera de los dos (incluido retirar una solicitud propia).
      // Desbloquear: SOLO quien bloqueó — si no, el bloqueado se desbloquearía
      // a sí mismo.
      //
      // ACEPTAR una solicitud solo puede hacerlo quien la RECIBIÓ. Si el
      // remitente pudiera auto-aceptarse, pasaría el hilo a "active" y el límite
      // de un mensaje por solicitud no valdría absolutamente nada.
      function validStatusChange() {
        return resource.data.status == "blocked"
          ? (
              request.resource.data.status == "active"
              && resource.data.blockedBy == request.auth.uid
              && request.resource.data.blockedBy == null
            )
          : (
              request.resource.data.status == "blocked"
                ? request.resource.data.blockedBy == request.auth.uid
                : (
                    request.resource.data.status == "active"
                    && request.resource.data.blockedBy == null
                    && (
                      resource.data.status != "request"
                      || resource.data.createdBy != request.auth.uid
                    )
                  )
            );
      }

      // El supermoderador NO puede leer conversaciones ajenas por curiosidad.
      // Solo abre la que alguien denunció: `submitReport` marca `underReview`
      // en el hilo al recibir un reporte de tipo "conversation", y ese marcador
      // es lo único que abre la puerta. Sin denuncia, no hay lectura.
      allow get, list: if isParticipant()
        || (isPlatformMod() && resource.data.get("underReview", false) == true);

      allow create: if signedIn()
        && notAnonymous()
        && validNewConversation()
        && !usersHaveBlockBetween(request.auth.uid, otherUid())
        && policyAllowsMe()
        && request.resource.data.status == requiredNewStatus();

      // `lastMessage`/`lastMessageAt` los escribe SOLO la Cloud Function (Admin
      // SDK se salta estas rules), por eso no están en la lista de campos
      // tocables: el cliente no puede falsear el resumen del inbox.
      /**
       * Silenciar y quitar de la bandeja son cosas de UNO, no del hilo.
       *
       * Van por su propia rama y no por la de arriba a propósito: aquella exige
       * `validStatusChange()`, que solo tiene sentido cuando se toca el estado.
       * Metiéndolas ahí, silenciar un hilo que está en Solicitudes se habría
       * rechazado sin motivo.
       */
      function convTouchedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      /** La lista de silenciados solo puede cambiar EN TI. */
      function onlyTogglesOwnMute() {
        let previous = resource.data.get('mutedBy', []).toSet();
        let next = request.resource.data.mutedBy;
        return convTouchedKeys().hasOnly(['mutedBy', 'updatedAt'])
          && next is list
          && next.size() <= 2
          && (
            next.toSet() == previous.union([request.auth.uid].toSet())
            || next.toSet() == previous.difference([request.auth.uid].toSet())
          );
      }

      /**
       * Ocultar el hilo de MI bandeja. Solo se puede tocar la clave con el uid
       * propio: nadie puede hacer desaparecer la conversación del otro.
       */
      function onlyHidesConversationForSelf() {
        return convTouchedKeys().hasOnly(['hiddenAt', 'updatedAt'])
          && request.resource.data.hiddenAt is map
          && request.resource.data.hiddenAt
               .diff(resource.data.get('hiddenAt', {}))
               .affectedKeys()
               .hasOnly([request.auth.uid])
          && request.resource.data.hiddenAt[request.auth.uid] == request.time;
      }

      // ⚠️ `unread` y `lastReadAt` son mapas con una clave por participante, y
      // la regla no miraba QUÉ clave se tocaba: cualquiera de los dos podía
      // reescribir el mapa entero y marcar como leídos —o no leídos— los
      // mensajes de la otra persona. No da acceso a nada ajeno, pero rompe la
      // bandeja del otro y sus acuses de lectura.
      //
      // Ahora cada quien solo puede tocar SU casilla.
      function onlyTouchesOwnReadState() {
        return (
          !("unread" in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data.unread.diff(resource.data.get('unread', {})).affectedKeys()
               .hasOnly([request.auth.uid])
        )
        && (
          !("lastReadAt" in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data.lastReadAt.diff(resource.data.get('lastReadAt', {})).affectedKeys()
               .hasOnly([request.auth.uid])
        );
      }

      allow update: if isParticipant()
        && notAnonymous()
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'blockedBy', 'unread', 'lastReadAt', 'updatedAt'])
            && validStatusChange()
            && onlyTouchesOwnReadState()
          )
          || onlyTogglesOwnMute()
          || onlyHidesConversationForSelf()
        );

      // Un hilo no se borra: se bloquea. Así el otro lado no puede hacer
      // desaparecer la evidencia de lo que escribió.
      allow delete: if false;

      match /messages/{messageId} {

        function conv() {
          return get(/databases/$(database)/documents/conversations/$(convId)).data;
        }

        function isConvParticipant() {
          return signedIn() && request.auth.uid in conv().participants;
        }

        // En el lote que crea el hilo junto a su primer mensaje, la conversación
        // TODAVÍA no existe al evaluar el mensaje: get() daría null. getAfter()
        // ve el estado posterior al request, y para un hilo que ya existía
        // devuelve exactamente lo mismo que get().
        function convAfter() {
          return getAfter(/databases/$(database)/documents/conversations/$(convId)).data;
        }

        function isConvParticipantAfter() {
          return signedIn() && request.auth.uid in convAfter().participants;
        }

        /** El otro del hilo, sacado de la conversación ya existente. */
        function otroDelHilo() {
          return convAfter().participants[0] == request.auth.uid
            ? convAfter().participants[1]
            : convAfter().participants[0];
        }

        /**
         * ⚠️ B9-C01. El bloqueo, comprobado en el servidor y en cada escritura.
         *
         * El bloqueo global SÍ se comprobaba al ABRIR una conversación nueva
         * (`allow create` de `/conversations`), pero no al escribir dentro de una
         * que ya existía. Ahí el único freno era `status != "blocked"` en el
         * documento del hilo, y ese estado lo escribe el CLIENTE después de
         * bloquear, en una operación aparte que:
         *   · no es atómica con el bloqueo,
         *   · se traga sus propios errores en silencio,
         *   · no se ejecuta al desbloquear desde la lista de cuentas bloqueadas.
         *
         * O sea que bastaba con que esa sincronización fallara —o con saltársela
         * escribiendo directo— para seguir escribiéndole a quien te bloqueó.
         *
         * Decisión de producto de Luis (2026-08-16): al bloquear, el hilo se
         * cierra DEL TODO. Ni escribir, ni reaccionar a mensajes viejos, ni
         * volver a abrir las imágenes del historial. Por eso esto se exige tanto
         * al crear como al actualizar un mensaje.
         *
         * Cuesta dos `exists()`, y es una escritura de un solo documento, así que
         * cabe de sobra en el presupuesto de 10 accesos.
         */
        function sinBloqueoEntreLosDos() {
          return !usersHaveBlockBetween(request.auth.uid, otroDelHilo());
        }

        // Mientras una solicitud no se acepta, quien la abrió solo puede dejar
        // el ÚNICO mensaje declarado en `firstMessageId`. Sin esto, un
        // desconocido podría vaciar su bandeja encima de alguien que ni
        // siquiera le ha contestado todavía. El destinatario sí escribe libre:
        // si responde, es que la acepta.
        /**
         * ⚠️ B9-medio. Se quitó la escapatoria `createdBy != request.auth.uid`.
         *
         * Esa cláusula dejaba al DESTINATARIO de una solicitud escribir todo lo
         * que quisiera sin que el hilo pasara nunca a `active`. La regla decía
         * que responder implica aceptar, y no lo exigía: el hilo se quedaba en un
         * estado contradictorio —"pendiente" con conversación dentro— y el resto
         * de las reglas deciden mirando ese estado.
         *
         * Ahora, mientras el hilo siga en `request` DESPUÉS de la escritura, solo
         * cabe el único mensaje declarado en `firstMessageId`. Responder de
         * verdad obliga a cambiar el estado en el MISMO lote, y entonces
         * `convAfter().status` ya es `active` y pasa por la primera cláusula.
         *
         * `convAfter()` es `getAfter`, o sea el estado resultante: eso es lo que
         * permite exigir que las dos cosas ocurran juntas.
         */
        function allowedInPendingRequest() {
          return convAfter().status != "request"
            || messageId == convAfter().firstMessageId;
        }

        // Mismo criterio que el hilo: solo los mensajes de una conversación
        // denunciada, nunca los de una cualquiera.
        allow get, list: if isConvParticipant()
          || (isPlatformMod() && conv().get("underReview", false) == true);

        // UNA imagen como mucho por mensaje. Solo se valida la forma: los
        // ficheros ya los gobierna storage.rules bajo `dmImages/`.
        function hasImage() {
          return ("image" in request.resource.data)
            && request.resource.data.image != null;
        }

        // Solo se guardan RUTAS: la URL la firma la Cloud Function
        // `getDirectMessageImageUrls` y caduca.
        /**
         * ⚠️ B9-C02. La ruta tiene que llevar el uid de QUIEN ENVÍA, no solo el
         * de la conversación.
         *
         * Antes bastaba con `^dmImages/{convId}/`, y la ruta real es
         * `dmImages/{convId}/{uid}/{carpeta}/{archivo}` (ver `storage.rules`).
         * O sea que cualquiera de los dos podía escribir un mensaje apuntando a
         * un archivo DEL OTRO, retirar su propio mensaje, y
         * `onDirectMessageDeletedCleanupImage` —que borra con el Admin SDK— le
         * destruía la foto a su dueño. Destrucción de datos ajenos disparada por
         * la acción más normal del mundo.
         *
         * Es el mismo patrón que B8-C01 con los medios de las publicaciones: un
         * campo de ruta que escribe el cliente y que obedece un borrador con
         * privilegios. Allí no se pudo cerrar en las reglas porque `media` es una
         * LISTA y las reglas no saben recorrerlas; aquí la imagen es un mapa
         * suelto, así que sí se cierra en el sitio correcto.
         *
         * ⚠️ `url` y `thumbnailUrl` SALEN de la lista de claves permitidas.
         * El comentario de arriba decía que eran solo de los primeros mensajes,
         * pero las reglas los seguían aceptando en mensajes nuevos SIN validar
         * dominio, y la interfaz los prioriza al pintar. Era una vía directa para
         * meter una imagen remota y quedarse con la IP, el navegador y la hora a
         * la que el otro abre el chat. Los mensajes antiguos que ya los tengan se
         * siguen leyendo: esto solo gobierna la escritura.
         */
        function rutaDmPropia(ruta) {
          return ruta is string
            && ruta.matches('^dmImages/' + convId + '/' + request.auth.uid + '/.*')
            && !ruta.matches('.*[.][.].*');
        }

        function validImage() {
          return !hasImage() || (
            request.resource.data.image is map
            && rutaDmPropia(request.resource.data.image.path)
            && rutaDmPropia(request.resource.data.image.thumbnailPath)
            && request.resource.data.image.keys().hasOnly([
                 'path', 'thumbnailPath', 'width', 'height'
               ])
          );
        }

        // Cita del mensaje al que se responde. Es una COPIA del original, no una
        // referencia, así que aquí solo se valida la forma y el tamaño: el
        // contenido citado ya lo vio quien responde, y ambos son participantes
        // del mismo hilo. Lo que sí se cierra es que el autor citado sea uno de
        // los dos, para que nadie fabrique una cita a nombre de un tercero.
        function hasReply() {
          return ("replyTo" in request.resource.data)
            && request.resource.data.replyTo != null;
        }

        /**
         * B9-alto. Ni los mensajes ni las solicitudes tenían freno: un
         * participante de un hilo activo podía generar mensajes, escrituras,
         * disparadores y avisos sin límite, y con política `everyone` se podía
         * montar una campaña contra mucha gente a la vez.
         *
         * Mismo mecanismo que comentarios e historias: el contador viaja en el
         * MISMO lote atómico y esto lo exige. 1 s entre mensajes, 300 por hora.
         */
        function frenoDeMensajeEnElMismoLote() {
          return getAfter(
            /databases/$(database)/documents/rateLimits/$(request.auth.uid + '_dm')
          ).data.lastAt == request.time;
        }

        function rutaMensajeCitado() {
          return /databases/$(database)/documents/conversations/$(convId)/messages/$(request.resource.data.replyTo.messageId);
        }

        function mensajeCitadoExiste() {
          return exists(rutaMensajeCitado());
        }

        function mensajeCitado() {
          return get(rutaMensajeCitado()).data;
        }

        function validReply() {
          return !hasReply() || (
            request.resource.data.replyTo is map
            && request.resource.data.replyTo.messageId is string
            && request.resource.data.replyTo.messageId.size() > 0
            && request.resource.data.replyTo.messageId.size() <= 128
            // ⚠️ B9-medio. Antes bastaba con que el autor citado fuera uno de
            // los dos. Ahora el mensaje citado tiene que EXISTIR en este hilo y
            // el autor tiene que ser el suyo de verdad: no se puede fabricar una
            // cita a un mensaje inventado ni atribuirle al otro algo que dijo
            // uno mismo.
            //
            // ⚠️ El TEXTO ya no se guarda. Era una copia del cliente que las
            // reglas no podían comprobar —la cita se recorta a 200 y un mensaje
            // llega a 2000, y las reglas no saben cortar cadenas—, así que se
            // podía poner en boca del otro cualquier cosa. La interfaz lo lee
            // ahora del mensaje ORIGINAL por su id, y aquí solo queda la
            // referencia, de la que sí responden estas reglas.
            //
            // Los mensajes antiguos que ya llevan `text` se siguen leyendo sin
            // problema: esto solo gobierna la escritura, y la interfaz ignora esa
            // copia igualmente.
            && mensajeCitadoExiste()
            && request.resource.data.replyTo.senderId == mensajeCitado().senderId
            && request.resource.data.replyTo.keys().hasOnly([
                 'messageId', 'senderId', 'hasImage'
               ])
          );
        }

        allow create: if isConvParticipantAfter()
          && notAnonymous()
          && convAfter().status != "blocked"
          && sinBloqueoEntreLosDos()
          && frenoDeMensajeEnElMismoLote()
          && allowedInPendingRequest()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          // Un mensaje vacío solo se admite si lleva imagen.
          && (request.resource.data.text.size() > 0 || hasImage())
          && validImage()
          && validReply()
          && request.resource.data.isDeleted == false
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly([
               'senderId', 'text', 'image', 'replyTo', 'createdAt', 'isDeleted'
             ]);

        function isAuthor() {
          return resource.data.senderId == request.auth.uid;
        }

        function touchedKeys() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }

        /**
         * Ventana de 10 minutos desde el envío. Pasada, el mensaje queda
         * congelado: ni se edita ni se retira para el otro. Sin este límite se
         * podría reescribir una conversación entera a posteriori.
         */
        function withinEditWindow() {
          return resource.data.createdAt is timestamp
            && request.time < resource.data.createdAt + duration.value(10, 'm');
        }

        /**
         * Ocultar SOLO para mí. Cualquiera de los dos, cuando quiera, y solo
         * puede añadirse a sí mismo: nadie puede ocultarle un mensaje al otro.
         */
        function onlyHidesForSelf() {
          let previous = resource.data.get('deletedFor', []);
          return touchedKeys().hasOnly(['deletedFor'])
            && request.resource.data.deletedFor is list
            && request.resource.data.deletedFor.toSet()
                 == previous.toSet().union([request.auth.uid].toSet());
        }

        /** Retirar para los dos. Solo el autor y dentro de la ventana. */
        function isDeleteForEveryone() {
          return touchedKeys().hasOnly(['isDeleted'])
            && request.resource.data.isDeleted == true
            && isAuthor()
            && withinEditWindow();
        }

        /**
         * Editar el texto. Solo el autor, dentro de la ventana, y SIEMPRE
         * marcando `editedAt`: la edición tiene que ser visible para el otro,
         * no un cambio silencioso del historial.
         */
        function isEdit() {
          return touchedKeys().hasOnly(['text', 'editedAt'])
            && isAuthor()
            && withinEditWindow()
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 2000
            && (request.resource.data.text.size() > 0
                || ('image' in resource.data && resource.data.image != null))
            && request.resource.data.editedAt == request.time;
        }

        /**
         * Poner o quitar TU corazón. Cualquiera de los dos, en cualquier
         * mensaje y sin ventana de tiempo: un corazón no reescribe lo dicho, así
         * que no necesita el límite de 10 minutos de editar y retirar.
         *
         * La lista solo puede cambiar en TI: o queda igual más tu uid, o igual
         * menos tu uid. Con eso es imposible quitarle el corazón al otro ni
         * ponérselo en su nombre.
         */
        function onlyTogglesOwnLike() {
          let previous = resource.data.get('likedBy', []).toSet();
          let next = request.resource.data.likedBy;
          return touchedKeys().hasOnly(['likedBy'])
            && next is list
            // Solo hay dos personas en el hilo: más de dos es basura.
            && next.size() <= 2
            && (
              next.toSet() == previous.union([request.auth.uid].toSet())
              || next.toSet() == previous.difference([request.auth.uid].toSet())
            );
        }

        // ⚠️ B9-C01 y B9-medio. `sinBloqueoEntreLosDos()` también aquí.
        //
        // Sin esto, quien te bloqueó —o a quien bloqueaste— seguía pudiendo
        // poner y quitar reacciones en mensajes viejos, y eso llega al otro en
        // tiempo real: el bloqueo dejaba de cortar el contacto justo por donde
        // más se nota.
        //
        // `onlyHidesForSelf` queda FUERA de la restricción a propósito: esconder
        // un mensaje en tu propia pantalla no le manda ninguna señal al otro, y
        // negárselo a alguien bloqueado sería castigarle por haber bloqueado.
        allow update: if isConvParticipant()
          && notAnonymous()
          && (
            onlyHidesForSelf()
            || (
              sinBloqueoEntreLosDos()
              && (
                isDeleteForEveryone()
                || isEdit()
                || onlyTogglesOwnLike()
              )
            )
          );

        allow delete: if false;
      }
    }

    // ==========================
    // ACCESO GLOBAL MODERADORES
    // ==========================
    // ⚠️ AQUÍ HABÍA UNA REGLA COMODÍN: `match /{document=**} { allow read: if
    // isPlatformMod(); }`. En Firestore las reglas se combinan con OR, así que
    // esa línea ANULABA todas las restricciones de lectura del archivo. Un
    // supermoderador podía leer los mensajes privados de cualquiera, los datos
    // fiscales y bancarios de los creadores, las cuentas de retiro, el KYC y —lo
    // peor— las claves de transmisión de `posts/{id}/liveStream/credentials`,
    // con las que se puede secuestrar un directo.
    //
    // Ahora el acceso del supermoderador es EXPLÍCITO, colección por colección,
    // ahí donde el panel de moderación lo necesita de verdad. Si en el futuro
    // hace falta revisar algo nuevo, se añade el permiso a esa colección — nunca
    // se vuelve a abrir un comodín.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
