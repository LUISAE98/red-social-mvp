# Plantilla de variables de entorno de Vibra.
# Copia este archivo a `.env.local` y rellena los valores reales.
# NUNCA subas `.env.local` ni secretos reales a git.

# ─── Sitio / dominio público ──────────────────────────────────────
# URL pública canónica (con esquema, sin slash final). De aquí salen los
# share links, OG tags, canonical y el watermark de marca (lib/brand.ts).
# En producción (Vercel) definir como: https://vibraon.com
NEXT_PUBLIC_SITE_URL=

# ─── Firebase (cliente / navegador) ───────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin (servidor) ────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Mux (video on-demand) ────────────────────────────────────────
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# ─── LiveKit (live streaming) ─────────────────────────────────────
LIVEKIT_URL=
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_EGRESS_S3_BUCKET=
LIVEKIT_EGRESS_S3_ENDPOINT=
LIVEKIT_EGRESS_S3_REGION=
