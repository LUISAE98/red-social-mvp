{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
  

    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/app/(protected)/*": ["./app/[locale]/(protected)/*"],
      "@/app/(public)/*":    ["./app/[locale]/(public)/*"],
      "@/app/groups/*":      ["./app/[locale]/groups/*"],
      "@/app/admin/*":       ["./app/[locale]/admin/*"],
      "@/app/search/*":      ["./app/[locale]/search/*"],
      "@/app/p/*":           ["./app/[locale]/p/*"],
      "@/app/invite/*":      ["./app/[locale]/invite/*"],
      "@/app/live-overlay/*":["./app/[locale]/live-overlay/*"],
      "@/app/dev/*":         ["./app/[locale]/dev/*"],
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
, "app/components/VibraAnimatedLogo"  ],
  "exclude": [
    "node_modules",
    ".next",
    "functions__old/**",
    "backend"
  ]
}
