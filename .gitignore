# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Logs del Firebase CLI: incluyen URLs firmadas de Cloud Storage, sourceTokens
# de despliegue y metadata del proyecto. Nunca deben versionarse.
firebase-debug.log*
firestore-debug.log*
database-debug.log*
pubsub-debug.log*
ui-debug.log*
dataconnect-debug.log*
.firebase/

# Volcados de la JVM que levanta el emulador de Firestore (Java): hs_err_*,
# replay_pid*. Son artefactos locales de diagnóstico, pesan MB y no aportan nada
# al repo.
replay_pid*.log
hs_err_pid*.log

# Archivo temporal que el CLI de Firebase deja al desplegar/validar las reglas.
firestore.rules.tmp.*

# env files (can opt-in for committing if needed)
.env*
# ...pero la plantilla sin secretos de la raíz sí se versiona
!/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# volcados/artefactos de análisis de lint (no versionar)
lint-output*.txt
lint-unused*.txt
lint-analyze.js
lint-parse.js


# Backend env files
backend/.env
backend/.env.local
# Sentry Config File
.env.sentry-build-plugin
